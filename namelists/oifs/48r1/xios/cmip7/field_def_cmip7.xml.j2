    <field id="pextra_103" long_name="u-tendency from convection"                                                          unit="m/s2 * s" />
    <field id="pextra_104" long_name="v-tendency from convection"                                                          unit="m/s2 * s" />
    <field id="pextra_105" long_name="T-tendency from convection"                                                          unit="K/s * s" />
    <field id="pextra_106" long_name="q-tendency from convection"                                                          unit="kg/kg/s * s" />
    <field id="pextra_107" long_name="Precip. flux from convection liquid"                                                 unit="kg/(m2 s) * s" />
    <field id="pextra_108" long_name="Precip. flux from convection ice"                                                    unit="kg/(m2 s) * s" />
    <field id="pextra_109" long_name="T-tendency from cloud and semi-Lagrangian (SL) physics"                              unit="K/s * s" />
    <field id="pextra_110" long_name="q-tendency from cloud and SL phys. and negative humidity correction"                 unit="kg/kg/s * s" />
    <field id="pextra_111" long_name="Cloud water tendency from vert. diff (with GWD and surf) and cloud"                  unit="kg/kg/s * s" />
    <field id="pextra_112" long_name="Cloud ice tendency from vert. diff (with GWD and surf) and cloud"                    unit="kg/kg/s * s" />
    <field id="pextra_113" long_name="Precip. flux from cloud scheme - liquid"                                             unit="kg/(m2 s) * s" />
