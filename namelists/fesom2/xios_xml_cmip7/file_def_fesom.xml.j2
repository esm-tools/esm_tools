<?xml version="1.0"?>
<file_definition type="one_file" format="netcdf4" par_access="collective"
                 compression_level="{{xios.compression_level}}"
                 time_counter_name="time" time_counter="exclusive">

  <!-- FESOM-2.7 XIOS file definition. One file per variable, grouped by
       output frequency (3h / 1d / 1mo). All files split yearly. Filenames
       are "<var>.fesom" + XIOS split suffix. -->

  <!-- ================= Daily ================= -->
  <!-- freq_op="1d" (matching output_freq) makes XIOS request samples once per day
       via xios_field_is_active. FESOM sends daily; XIOS averages over 1 sample
       (= identity = the value FESOM sent). cell_methods="time: mean (interval: 1 d)".
       Replaces the prior pattern where FESOM's hardcoded freq_unit='s' override
       fired write_mean every model step (558k calls/rank/month → ~430). -->
  <file_group id="fesom_1d" output_freq="1d" split_freq="1y" enabled="true">
    <file id="f_sst"    name="sst.fesom"   ><field field_ref="sst"      freq_op="1d"/></file>
    <file id="f_sss"    name="sss.fesom"   ><field field_ref="sss"      freq_op="1d"/></file>
    <file id="f_ssh"    name="ssh.fesom"   ><field field_ref="ssh"      freq_op="1d"/></file>
    <file id="f_uice"   name="uice.fesom"  ><field field_ref="uice"     freq_op="1d"/></file>
    <file id="f_vice"   name="vice.fesom"  ><field field_ref="vice"     freq_op="1d"/></file>
    <file id="f_a_ice"  name="a_ice.fesom" ><field field_ref="a_ice"    freq_op="1d"/></file>
    <file id="f_m_snow" name="m_snow.fesom"><field field_ref="m_snow"   freq_op="1d"/></file>
    <file id="f_ist"    name="ist.fesom"   ><field field_ref="ist"      freq_op="1d"/></file>
    <file id="f_MLD3"   name="MLD3.fesom"  ><field field_ref="MLD3"     freq_op="1d"/></file>
    <file id="f_h_ice"  name="h_ice.fesom" ><field field_ref="h_ice"    freq_op="1d"/></file>
    <file id="f_h_snow" name="h_snow.fesom"><field field_ref="h_snow"   freq_op="1d"/></file>
    <file id="f_unod_sfc" name="unod_sfc.fesom"><field field_ref="unod_sfc" freq_op="1d"/></file>
    <file id="f_vnod_sfc" name="vnod_sfc.fesom"><field field_ref="vnod_sfc" freq_op="1d"/></file>

    <!-- Daily sea-ice mass per area, for CMIP sivol at day frequency
         (seaIce.sivol.tavg-u-hm-u.day.{nh,sh}). m_ice is only monthly in the
         fesom_1mo group below, which left the daily rules with 12 values to
         spread over 365 timesteps. Without this the daily volume has to be
         rebuilt as h_ice * a_ice, and since both are daily means that product
         drops the sub-daily covariance between thickness and concentration.
         Separate file id and name so the monthly m_ice stream, which several
         monthly rules read, is untouched. -->
    <file id="f_m_ice_day" name="m_ice_day.fesom"><field field_ref="m_ice" freq_op="1d"/></file>
  </file_group>

  <!-- ================= Monthly ================= -->
  <!-- freq_op="1mo" (matching output_freq) → XIOS asks once per month, FESOM sends
       once. operation="average" with 1 sample = identity. cell_methods correct. -->
  <file_group id="fesom_1mo" output_freq="1mo" split_freq="1y" enabled="true">

    <!-- 2D nodes -->
    <file id="f_m_ice"           name="m_ice.fesom"          ><field field_ref="m_ice"           freq_op="1mo"/></file>
    <file id="f_MLD1"            name="MLD1.fesom"           ><field field_ref="MLD1"            freq_op="1mo"/></file>
    <file id="f_MLD2"            name="MLD2.fesom"           ><field field_ref="MLD2"            freq_op="1mo"/></file>
    <file id="f_fw"              name="fw.fesom"             ><field field_ref="fw"              freq_op="1mo"/></file>
    <file id="f_fh"              name="fh.fesom"             ><field field_ref="fh"              freq_op="1mo"/></file>
    <file id="f_thdgrarea"       name="thdgrarea.fesom"      ><field field_ref="thdgrarea"       freq_op="1mo"/></file>
    <file id="f_dyngrarea"       name="dyngrarea.fesom"      ><field field_ref="dyngrarea"       freq_op="1mo"/></file>
    <file id="f_thdgrice"        name="thdgrice.fesom"       ><field field_ref="thdgrice"        freq_op="1mo"/></file>
    <file id="f_dyngrice"        name="dyngrice.fesom"       ><field field_ref="dyngrice"        freq_op="1mo"/></file>
    <file id="f_thdgrsnw"        name="thdgrsnw.fesom"       ><field field_ref="thdgrsnw"        freq_op="1mo"/></file>
    <file id="f_atmice_x"        name="atmice_x.fesom"       ><field field_ref="atmice_x"        freq_op="1mo"/></file>
    <file id="f_atmice_y"        name="atmice_y.fesom"       ><field field_ref="atmice_y"        freq_op="1mo"/></file>
    <file id="f_iceoce_x"        name="iceoce_x.fesom"       ><field field_ref="iceoce_x"        freq_op="1mo"/></file>
    <file id="f_iceoce_y"        name="iceoce_y.fesom"       ><field field_ref="iceoce_y"        freq_op="1mo"/></file>
    <file id="f_fw_ice"          name="fw_ice.fesom"         ><field field_ref="fw_ice"          freq_op="1mo"/></file>
    <file id="f_fw_snw"          name="fw_snw.fesom"         ><field field_ref="fw_snw"          freq_op="1mo"/></file>
    <file id="f_virtsalt"        name="virtsalt.fesom"       ><field field_ref="virtsalt"        freq_op="1mo"/></file>
    <!-- f_realsalt disabled: dead under which_ale='linfs' (use_virt_salt=.true., real-salt branch in ice_thermo_cpl.F90 unreachable); re-enable for non-linfs runs -->
    <!-- <file id="f_realsalt"        name="realsalt.fesom"       ><field field_ref="realsalt"        freq_op="1mo"/></file> -->
    <!-- f_relaxsalt: enabled. Output is identically 0 in coupled HR (no SSS restoring active);
         CMIP vsfcorr correctly reports the absence of any virtual salt flux correction. The
         zero field IS the right answer — it's a positive demonstration that no flux
         correction is being applied, not a missing diagnostic. -->
    <file id="f_relaxsalt"       name="relaxsalt.fesom"      ><field field_ref="relaxsalt"       freq_op="1mo"/></file>
    <file id="f_qcon"            name="qcon.fesom"           ><field field_ref="qcon"            freq_op="1mo"/></file>
    <file id="f_apnd"            name="apnd.fesom"           ><field field_ref="apnd"            freq_op="1mo"/></file>
    <file id="f_hpnd"            name="hpnd.fesom"           ><field field_ref="hpnd"            freq_op="1mo"/></file>
    <file id="f_ipnd"            name="ipnd.fesom"           ><field field_ref="ipnd"            freq_op="1mo"/></file>
    <file id="f_evap"            name="evap.fesom"           ><field field_ref="evap"            freq_op="1mo"/></file>
    <file id="f_prec"            name="prec.fesom"           ><field field_ref="prec"            freq_op="1mo"/></file>
    <file id="f_snow"            name="snow.fesom"           ><field field_ref="snow"            freq_op="1mo"/></file>
    <file id="f_runoff"          name="runoff.fesom"         ><field field_ref="runoff"          freq_op="1mo"/></file>
    <file id="f_pbo"             name="pbo.fesom"            ><field field_ref="pbo"             freq_op="1mo"/></file>
    <file id="f_opottemptend"    name="opottemptend.fesom"   ><field field_ref="opottemptend"    freq_op="1mo"/></file>
    <file id="f_opottemprmadvect" name="opottemprmadvect.fesom"><field field_ref="opottemprmadvect" freq_op="1mo"/></file>
    <file id="f_opottempdiff"    name="opottempdiff.fesom"   ><field field_ref="opottempdiff"    freq_op="1mo"/></file>
    <file id="f_osalttend"       name="osalttend.fesom"      ><field field_ref="osalttend"       freq_op="1mo"/></file>
    <file id="f_osaltrmadvect"   name="osaltrmadvect.fesom"  ><field field_ref="osaltrmadvect"   freq_op="1mo"/></file>
    <file id="f_osaltdiff"       name="osaltdiff.fesom"      ><field field_ref="osaltdiff"       freq_op="1mo"/></file>

    <!-- 2D elements -->
    <file id="f_tx_sur"       name="tx_sur.fesom"      ><field field_ref="tx_sur"       freq_op="1mo"/></file>
    <file id="f_ty_sur"       name="ty_sur.fesom"      ><field field_ref="ty_sur"       freq_op="1mo"/></file>
    <!-- f_strength_ice: enabled. NOTE: at the time of writing, mEVP (whichEVP=1) and aEVP
         (whichEVP=2) in ice_maEVP.F90 use a local 'pressure' / 'pressure_fac' variable and
         leave the shared ice%work%ice_strength array at the zero init from MOD_ICE.F90:828.
         Only whichEVP=0 (original EVP, ice_EVP.F90:518-522) currently writes it. The output
         stream is wired up here so that once ice_maEVP.F90 is patched to populate
         ice%work%ice_strength alongside its local pressure variable (TODO, separately),
         CMIP sicompstren produces correct values with no XML/namelist change required. -->
    <file id="f_strength_ice" name="strength_ice.fesom"><field field_ref="strength_ice" freq_op="1mo"/></file>
    <file id="f_sgm11"        name="sgm11.fesom"       ><field field_ref="sgm11"        freq_op="1mo"/></file>
    <file id="f_sgm12"        name="sgm12.fesom"       ><field field_ref="sgm12"        freq_op="1mo"/></file>
    <file id="f_sgm22"        name="sgm22.fesom"       ><field field_ref="sgm22"        freq_op="1mo"/></file>

    <!-- Instantaneous stress tensor, for CMIP sistressave / sistressmax.
         Both DReq entries are branded tpt-u-hxy-si and ask for an instantaneous
         value at the centre of the month; the averaged streams above cannot
         supply that. sistressmax is sqrt(((s11-s22)/2)^2 + s12^2), a nonlinear
         function of the components, so deriving it from monthly means is not
         even the monthly mean of the invariant. The two rules are deactivated
         in the HR recipe for exactly this reason; these streams are what makes
         them reactivatable. Separate files rather than operation flips on the
         streams above, so nothing that wants the mean silently gets a snapshot.
         Note the sample lands at the end of the output interval, not the 15th
         as the DReq text prefers, but it is a genuine instantaneous value. -->
    <file id="f_sgm11_inst"   name="sgm11_inst.fesom"  ><field field_ref="sgm11"        freq_op="1mo" operation="instant"/></file>
    <file id="f_sgm12_inst"   name="sgm12_inst.fesom"  ><field field_ref="sgm12"        freq_op="1mo" operation="instant"/></file>
    <file id="f_sgm22_inst"   name="sgm22_inst.fesom"  ><field field_ref="sgm22"        freq_op="1mo" operation="instant"/></file>

    <!-- 0D scalars routed through XIOS at file_def cadence -->
    <file id="f_volo"      name="volo.fesom"     ><field field_ref="volo"      freq_op="1mo"/></file>
    <file id="f_soga"      name="soga.fesom"     ><field field_ref="soga"      freq_op="1mo"/></file>
    <file id="f_thetaoga"  name="thetaoga.fesom" ><field field_ref="thetaoga"  freq_op="1mo"/></file>
    <file id="f_siarean"   name="siarean.fesom"  ><field field_ref="siarean"   freq_op="1mo"/></file>
    <file id="f_siareas"   name="siareas.fesom"  ><field field_ref="siareas"   freq_op="1mo"/></file>
    <file id="f_siextentn" name="siextentn.fesom"><field field_ref="siextentn" freq_op="1mo"/></file>
    <file id="f_siextents" name="siextents.fesom"><field field_ref="siextents" freq_op="1mo"/></file>
    <file id="f_sivoln"    name="sivoln.fesom"   ><field field_ref="sivoln"    freq_op="1mo"/></file>
    <file id="f_sivols"    name="sivols.fesom"   ><field field_ref="sivols"    freq_op="1mo"/></file>

    <!-- 3D nodes, cell-center -->
    <file id="f_temp"       name="temp.fesom"      ><field field_ref="temp"       freq_op="1mo"/></file>
    <file id="f_salt"       name="salt.fesom"      ><field field_ref="salt"       freq_op="1mo"/></file>
    <file id="f_unod"       name="unod.fesom"      ><field field_ref="unod"       freq_op="1mo"/></file>
    <file id="f_vnod"       name="vnod.fesom"      ><field field_ref="vnod"       freq_op="1mo"/></file>
    <file id="f_hnode"      name="hnode.fesom"     ><field field_ref="hnode"      freq_op="1mo"/></file>
    <file id="f_rsdoabsorb" name="rsdoabsorb.fesom"><field field_ref="rsdoabsorb"  freq_op="1mo"/></file>

    <!-- 3D nodes, interface levels -->
    <file id="f_w"       name="w.fesom"      ><field field_ref="w"        freq_op="1mo"/></file>
    <file id="f_bolus_w" name="bolus_w.fesom"><field field_ref="bolus_w"  freq_op="1mo"/></file>
    <file id="f_N2"      name="N2.fesom"     ><field field_ref="N2"       freq_op="1mo"/></file>
    <file id="f_Kv"      name="Kv.fesom"     ><field field_ref="Kv"       freq_op="1mo"/></file>

    <!-- 3D elements, cell-center -->
    <file id="f_u"       name="u.fesom"      ><field field_ref="u"        freq_op="1mo"/></file>
    <file id="f_v"       name="v.fesom"      ><field field_ref="v"        freq_op="1mo"/></file>
    <file id="f_bolus_u" name="bolus_u.fesom"><field field_ref="bolus_u"  freq_op="1mo"/></file>
    <file id="f_bolus_v" name="bolus_v.fesom"><field field_ref="bolus_v"  freq_op="1mo"/></file>
    <file id="f_utemp"   name="utemp.fesom"  ><field field_ref="utemp"    freq_op="1mo"/></file>
    <file id="f_vtemp"   name="vtemp.fesom"  ><field field_ref="vtemp"    freq_op="1mo"/></file>
    <file id="f_usalt"   name="usalt.fesom"  ><field field_ref="usalt"    freq_op="1mo"/></file>
    <file id="f_vsalt"   name="vsalt.fesom"  ><field field_ref="vsalt"    freq_op="1mo"/></file>

    <!-- 3D elements, interface levels -->
    <file id="f_Av" name="Av.fesom"><field field_ref="Av" freq_op="1mo"/></file>

    <!-- dMOC density-coordinate fields (elements) -->
    <file id="f_U_rho_x_DZ"    name="U_rho_x_DZ.fesom"   ><field field_ref="U_rho_x_DZ"    freq_op="1mo"/></file>
    <file id="f_V_rho_x_DZ"    name="V_rho_x_DZ.fesom"   ><field field_ref="V_rho_x_DZ"    freq_op="1mo"/></file>
    <file id="f_std_heat_flux"  name="std_heat_flux.fesom" ><field field_ref="std_heat_flux"  freq_op="1mo"/></file>
    <file id="f_std_rest_flux"  name="std_rest_flux.fesom" ><field field_ref="std_rest_flux"  freq_op="1mo"/></file>
    <file id="f_std_frwt_flux"  name="std_frwt_flux.fesom" ><field field_ref="std_frwt_flux"  freq_op="1mo"/></file>
    <file id="f_std_dens_dVdT"  name="std_dens_dVdT.fesom" ><field field_ref="std_dens_dVdT"  freq_op="1mo"/></file>
    <file id="f_std_dens_Z"     name="std_dens_Z.fesom"    ><field field_ref="std_dens_Z"     freq_op="1mo"/></file>
    <file id="f_std_dens_H"     name="std_dens_H.fesom"    ><field field_ref="std_dens_H"     freq_op="1mo"/></file>

    <!-- dMOC density-coordinate fields (nodes) -->
    <file id="f_std_dens_DIV"      name="std_dens_DIV.fesom"     ><field field_ref="std_dens_DIV"      freq_op="1mo"/></file>
    <file id="f_std_dens_DIVbolus" name="std_dens_DIVbolus.fesom"><field field_ref="std_dens_DIVbolus" freq_op="1mo"/></file>

    <!-- dMOC sigma-2 density on z-levels -->
    <file id="f_density_dMOC" name="density_dMOC.fesom"><field field_ref="density_dMOC" freq_op="1mo"/></file>

  </file_group>

  <!-- ================= Regridded output (regular lat/lon) ================= -->
  <!-- Gated by fesom.regrid_surface_output. Field set mirrors the native
       fesom_1d and fesom_1mo blocks above, at the same frequencies. Each
       regridded file is named "<var>.fesom.reg" (XIOS appends split suffix).
       Land cells with no source contribution are written as 0 (see
       interpolate_domain renormalize="true" in domain_def_fesom.xml.j2). -->
  {% if fesom.regrid_surface_output %}

  <!-- Daily regridded 2D — mirrors fesom_1d -->
  <file_group id="fesom_1d_reg" output_freq="1d" split_freq="1y" enabled="true">
    <file id="f_sst_reg"      name="sst.fesom.reg"     ><field field_ref="sst"      grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_sss_reg"      name="sss.fesom.reg"     ><field field_ref="sss"      grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_ssh_reg"      name="ssh.fesom.reg"     ><field field_ref="ssh"      grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_uice_reg"     name="uice.fesom.reg"    ><field field_ref="uice"     grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_vice_reg"     name="vice.fesom.reg"    ><field field_ref="vice"     grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_a_ice_reg"    name="a_ice.fesom.reg"   ><field field_ref="a_ice"    grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_m_snow_reg"   name="m_snow.fesom.reg"  ><field field_ref="m_snow"   grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_ist_reg"      name="ist.fesom.reg"     ><field field_ref="ist"      grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_MLD3_reg"     name="MLD3.fesom.reg"    ><field field_ref="MLD3"     grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_h_ice_reg"    name="h_ice.fesom.reg"   ><field field_ref="h_ice"    grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_h_snow_reg"   name="h_snow.fesom.reg"  ><field field_ref="h_snow"   grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_unod_sfc_reg" name="unod_sfc.fesom.reg"><field field_ref="unod_sfc" grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
    <file id="f_vnod_sfc_reg" name="vnod_sfc.fesom.reg"><field field_ref="vnod_sfc" grid_ref="grid_2d_nod_reg" freq_op="1d"/></file>
  </file_group>

  <!-- Monthly regridded 2D — mirrors fesom_1mo 2D set (excludes 0D scalars) -->
  <file_group id="fesom_1mo_reg" output_freq="1mo" split_freq="1y" enabled="true">

    <!-- 2D nodes -->
    <file id="f_m_ice_reg"            name="m_ice.fesom.reg"           ><field field_ref="m_ice"            grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_MLD1_reg"             name="MLD1.fesom.reg"            ><field field_ref="MLD1"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_MLD2_reg"             name="MLD2.fesom.reg"            ><field field_ref="MLD2"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_fw_reg"               name="fw.fesom.reg"              ><field field_ref="fw"               grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_fh_reg"               name="fh.fesom.reg"              ><field field_ref="fh"               grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_thdgrarea_reg"        name="thdgrarea.fesom.reg"       ><field field_ref="thdgrarea"        grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_dyngrarea_reg"        name="dyngrarea.fesom.reg"       ><field field_ref="dyngrarea"        grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_thdgrice_reg"         name="thdgrice.fesom.reg"        ><field field_ref="thdgrice"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_dyngrice_reg"         name="dyngrice.fesom.reg"        ><field field_ref="dyngrice"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_thdgrsnw_reg"         name="thdgrsnw.fesom.reg"        ><field field_ref="thdgrsnw"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_atmice_x_reg"         name="atmice_x.fesom.reg"        ><field field_ref="atmice_x"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_atmice_y_reg"         name="atmice_y.fesom.reg"        ><field field_ref="atmice_y"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_iceoce_x_reg"         name="iceoce_x.fesom.reg"        ><field field_ref="iceoce_x"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_iceoce_y_reg"         name="iceoce_y.fesom.reg"        ><field field_ref="iceoce_y"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_fw_ice_reg"           name="fw_ice.fesom.reg"          ><field field_ref="fw_ice"           grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_fw_snw_reg"           name="fw_snw.fesom.reg"          ><field field_ref="fw_snw"           grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_virtsalt_reg"         name="virtsalt.fesom.reg"        ><field field_ref="virtsalt"         grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_relaxsalt_reg"        name="relaxsalt.fesom.reg"       ><field field_ref="relaxsalt"        grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_qcon_reg"             name="qcon.fesom.reg"            ><field field_ref="qcon"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_apnd_reg"             name="apnd.fesom.reg"            ><field field_ref="apnd"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_hpnd_reg"             name="hpnd.fesom.reg"            ><field field_ref="hpnd"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_ipnd_reg"             name="ipnd.fesom.reg"            ><field field_ref="ipnd"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_evap_reg"             name="evap.fesom.reg"            ><field field_ref="evap"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_prec_reg"             name="prec.fesom.reg"            ><field field_ref="prec"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_snow_reg"             name="snow.fesom.reg"            ><field field_ref="snow"             grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_runoff_reg"           name="runoff.fesom.reg"          ><field field_ref="runoff"           grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_pbo_reg"              name="pbo.fesom.reg"             ><field field_ref="pbo"              grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_opottemptend_reg"     name="opottemptend.fesom.reg"    ><field field_ref="opottemptend"     grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_opottemprmadvect_reg" name="opottemprmadvect.fesom.reg"><field field_ref="opottemprmadvect" grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_opottempdiff_reg"     name="opottempdiff.fesom.reg"    ><field field_ref="opottempdiff"     grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_osalttend_reg"        name="osalttend.fesom.reg"       ><field field_ref="osalttend"        grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_osaltrmadvect_reg"    name="osaltrmadvect.fesom.reg"   ><field field_ref="osaltrmadvect"    grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>
    <file id="f_osaltdiff_reg"        name="osaltdiff.fesom.reg"       ><field field_ref="osaltdiff"        grid_ref="grid_2d_nod_reg" freq_op="1mo"/></file>

    <!-- 2D elements -->
    <file id="f_tx_sur_reg"           name="tx_sur.fesom.reg"          ><field field_ref="tx_sur"           grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>
    <file id="f_ty_sur_reg"           name="ty_sur.fesom.reg"          ><field field_ref="ty_sur"           grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>
    <file id="f_strength_ice_reg"     name="strength_ice.fesom.reg"    ><field field_ref="strength_ice"     grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>
    <file id="f_sgm11_reg"            name="sgm11.fesom.reg"           ><field field_ref="sgm11"            grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>
    <file id="f_sgm12_reg"            name="sgm12.fesom.reg"           ><field field_ref="sgm12"            grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>
    <file id="f_sgm22_reg"            name="sgm22.fesom.reg"           ><field field_ref="sgm22"            grid_ref="grid_2d_elem_reg" freq_op="1mo"/></file>

  </file_group>
  {% endif %}

  <!-- ================= 3D regridded output (regular lat/lon × native vertical) -->
  <!-- Gated separately by fesom.regrid_3d_output. Off by default — 3D
       regrid is expensive at production resolutions. Field set mirrors
       the 3D portion of fesom_1mo above. -->
  {% if fesom.regrid_3d_output %}
  <file_group id="fesom_1mo_reg_3d" output_freq="1mo" split_freq="1y" enabled="true">

    <!-- 3D nodes, cell-center -->
    <file id="f_temp_reg"       name="temp.fesom.reg"      ><field field_ref="temp"       grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>
    <file id="f_salt_reg"       name="salt.fesom.reg"      ><field field_ref="salt"       grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>
    <file id="f_unod_reg"       name="unod.fesom.reg"      ><field field_ref="unod"       grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>
    <file id="f_vnod_reg"       name="vnod.fesom.reg"      ><field field_ref="vnod"       grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>
    <file id="f_hnode_reg"      name="hnode.fesom.reg"     ><field field_ref="hnode"      grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>
    <file id="f_rsdoabsorb_reg" name="rsdoabsorb.fesom.reg"><field field_ref="rsdoabsorb" grid_ref="grid_3d_nod_reg"     freq_op="1mo"/></file>

    <!-- 3D nodes, interface levels -->
    <file id="f_w_reg"       name="w.fesom.reg"      ><field field_ref="w"       grid_ref="grid_3d_nod_reg_nz1" freq_op="1mo"/></file>
    <file id="f_bolus_w_reg" name="bolus_w.fesom.reg"><field field_ref="bolus_w" grid_ref="grid_3d_nod_reg_nz1" freq_op="1mo"/></file>
    <file id="f_N2_reg"      name="N2.fesom.reg"     ><field field_ref="N2"      grid_ref="grid_3d_nod_reg_nz1" freq_op="1mo"/></file>
    <file id="f_Kv_reg"      name="Kv.fesom.reg"     ><field field_ref="Kv"      grid_ref="grid_3d_nod_reg_nz1" freq_op="1mo"/></file>

    <!-- 3D elements, cell-center -->
    <file id="f_u_reg"       name="u.fesom.reg"      ><field field_ref="u"       grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_v_reg"       name="v.fesom.reg"      ><field field_ref="v"       grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_bolus_u_reg" name="bolus_u.fesom.reg"><field field_ref="bolus_u" grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_bolus_v_reg" name="bolus_v.fesom.reg"><field field_ref="bolus_v" grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_utemp_reg"   name="utemp.fesom.reg"  ><field field_ref="utemp"   grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_vtemp_reg"   name="vtemp.fesom.reg"  ><field field_ref="vtemp"   grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_usalt_reg"   name="usalt.fesom.reg"  ><field field_ref="usalt"   grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>
    <file id="f_vsalt_reg"   name="vsalt.fesom.reg"  ><field field_ref="vsalt"   grid_ref="grid_3d_elem_reg"     freq_op="1mo"/></file>

    <!-- 3D elements, interface levels -->
    <file id="f_Av_reg"      name="Av.fesom.reg"     ><field field_ref="Av"      grid_ref="grid_3d_elem_reg_nz1" freq_op="1mo"/></file>

    <!-- dMOC density-coordinate (elements) -->
    <file id="f_U_rho_x_DZ_reg"    name="U_rho_x_DZ.fesom.reg"   ><field field_ref="U_rho_x_DZ"    grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_V_rho_x_DZ_reg"    name="V_rho_x_DZ.fesom.reg"   ><field field_ref="V_rho_x_DZ"    grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_heat_flux_reg" name="std_heat_flux.fesom.reg"><field field_ref="std_heat_flux" grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_rest_flux_reg" name="std_rest_flux.fesom.reg"><field field_ref="std_rest_flux" grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_frwt_flux_reg" name="std_frwt_flux.fesom.reg"><field field_ref="std_frwt_flux" grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_dens_dVdT_reg" name="std_dens_dVdT.fesom.reg"><field field_ref="std_dens_dVdT" grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_dens_Z_reg"    name="std_dens_Z.fesom.reg"   ><field field_ref="std_dens_Z"    grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>
    <file id="f_std_dens_H_reg"    name="std_dens_H.fesom.reg"   ><field field_ref="std_dens_H"    grid_ref="grid_rho_elem_reg" freq_op="1mo"/></file>

    <!-- dMOC density-coordinate (nodes) -->
    <file id="f_std_dens_DIV_reg"      name="std_dens_DIV.fesom.reg"     ><field field_ref="std_dens_DIV"      grid_ref="grid_rho_nod_reg" freq_op="1mo"/></file>
    <file id="f_std_dens_DIVbolus_reg" name="std_dens_DIVbolus.fesom.reg"><field field_ref="std_dens_DIVbolus" grid_ref="grid_rho_nod_reg" freq_op="1mo"/></file>

    <!-- dMOC sigma-2 density on z-levels -->
    <file id="f_density_dMOC_reg"      name="density_dMOC.fesom.reg"     ><field field_ref="density_dMOC"      grid_ref="grid_3d_nod_reg"  freq_op="1mo"/></file>

  </file_group>
  {% endif %}

</file_definition>
