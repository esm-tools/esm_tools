<domain_definition>
  <!-- FESOM unstructured triangular mesh. The attributes below (ni_glo,
       ibegin, ni, lonvalue_1d, latvalue_1d, bounds_lon_1d, bounds_lat_1d,
       nvertex) are filled at runtime by the Fortran side via
       xios_set_domain_attr / xios_set_domainname_attr.

       Two native domains are exposed:
         * nodes    - scalar/tracer points at mesh vertices (2D nodes)
         * elements - vector/velocity points at triangle centres (2D elem)
  -->

  <domain id="nodes"    type="unstructured" nvertex="6"
          name="nod2" dim_i_name="nod2"
          long_name="FESOM mesh nodes (vertices)" />

  <domain id="elements" type="unstructured" nvertex="3"
          name="elem" dim_i_name="elem"
          long_name="FESOM mesh elements (triangle centres)" />

  <!-- Regular rectilinear target domains for regridded output.
       XIOS interpolates from nodes/elements unstructured domains above.
       Required by BOTH the 2D surface (regrid_surface_output) and the 3D
       (regrid_3d_output) regridded file groups, so emit whenever either is on.
       Resolution and interpolation order from xios.regular_res_* / xios.interpolation_order. -->
  {% if fesom.regrid_surface_output or fesom.regrid_3d_output %}
  <domain_group id="regular_domains" type="rectilinear">
    <!-- detect_missing_value: without it, a target cell that receives no source
         contribution keeps the accumulator value and is written as 0 rather
         than as missing (XIOS updateData() in domain_algorithm_interpolate.cpp
         is gated on this attribute). For a land cell that means 0 m of sea
         surface height or 0 degC, indistinguishable from data. It also lets
         partially masked cells be built from their valid part instead of
         becoming wholly missing. -->
    <domain id="nodes_reg"    ni_glo="{{xios.fesom_regular_res_lon}}" nj_glo="{{xios.fesom_regular_res_lat}}">
      <generate_rectilinear_domain />
      <interpolate_domain order="{{xios.interpolation_order}}" write_weight="true" {% if xios.read_weight %}read_weight="true" {% endif %}renormalize="true" detect_missing_value="true" />
    </domain>
    <domain id="elements_reg" ni_glo="{{xios.fesom_regular_res_lon}}" nj_glo="{{xios.fesom_regular_res_lat}}">
      <generate_rectilinear_domain />
      <interpolate_domain order="{{xios.interpolation_order}}" write_weight="true" {% if xios.read_weight %}read_weight="true" {% endif %}renormalize="true" detect_missing_value="true" />
    </domain>
  </domain_group>
  {% endif %}

</domain_definition>
