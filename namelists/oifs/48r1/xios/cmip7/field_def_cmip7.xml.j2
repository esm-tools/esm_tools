    <field id="tcrw"   long_name="total column rain water"                                    standard_name="rainfall_amount"                                          unit="kg m-2" />
    <field id="tcsw"   long_name="total column snow water"                                    standard_name="snowfall_amount"                                          unit="kg m-2" />
    <field id="100u"   long_name="100 metre U wind component"                                                                                                          unit="m s-1" />
    <field id="100v"   long_name="100 metre V wind component"                                                                                                          unit="m s-1" />
    <field id="kx"     long_name="k-index"                                                    standard_name="atmosphere_stability_k_index"                             unit="K" />
    <field id="totalx" long_name="total totals index"                                         standard_name="atmosphere_stability_total_totals_index"                  unit="K" />
    <field id="co2of"  long_name="ocean flux of carbon dioxide"                               standard_name="ocean_flux_of_carbon dioxide"                             unit="kg m-2 s-1" />
    <field id="co2nbf" long_name="natural biosphere flux of carbon dioxide"                   standard_name="natural+biosphere+flux_of_carbon_dioxide"                 unit="kg m-2 s-1" />
    <field id="co2apf" long_name="anthropogenic emissions of carbon dioxide"                  standard_name="anthropogenic_emissions_of_carbon dioxide"                unit="kg m-2 s-1" />
    <field id="co2fire" long_name="wildfire flux of carbon dioxide"                           standard_name="wildfire_flux_of_carbon_dioxide"                          unit="kg m-2 s-1" />
    <field id="macv2sp_taod550" long_name="Total Aerosol Optical Depth at 550nm from MACV2SP" standard_name="total_aerosol_optical_depth_at_550nm_from_MACV2SP"        unit="1" />
  </field_group>

  <field_group id="3D_ml" grid_ref="reduced_ml" freq_op="{{ oifs.output_step_freq }}ts" >
