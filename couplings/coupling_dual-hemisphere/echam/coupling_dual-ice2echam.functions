#!/bin/ksh

## @fn ice2echam() 
ice2echam() {
        echo "                =================================================================="
        echo "                 *** S T A R T I N G    ice2echam *** "; echo

        . ${FUNCTION_PATH}/../echam/coupling_ice2echam.functions
        . ${FUNCTION_PATH}/../general/general_lists.functions
        . ${FUNCTION_PATH}/../general/coupling_general.functions

        echo " * working on the northern hemisphere first ..."
        export PISM_HEMISPHERE="pism_nh"
        ice2echam_1st
        wait
#        for FILE in "echam6_new_orography_before_calnoro_high_res.nc" "echam6_new_orography_before_calnoro_low_res.nc" "ice_mask_current_T63grid.nc" "ice_domain_current_T63grid.nc" "ice_discharge_T63grid.nc"; do
#            if [[ -f ${COUPLE_DIR}/${PISM_HEMISPHERE}/${FILE} ]]
#            then
#                echo " * processing ${FILE} for ${PISM_HEMISPHERE} ... "
#                cdo -s sellonlatbox,0,360,0,90 ${COUPLE_DIR}/${PISM_HEMISPHERE}/$FILE ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/cdo_ice2echam 
#                ncecat -O ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
##                ncwa -a time ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
#                ncpdq -O -a lat,lon,record ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
#            fi
#        done
        
        echo " * ... now switching to the southern hemisphere"
        export PISM_HEMISPHERE="pism_sh"
        ice2echam_1st
        wait
#        for FILE in "echam6_new_orography_before_calnoro_high_res.nc" "echam6_new_orography_before_calnoro_low_res.nc" "ice_mask_current_T63grid.nc" "ice_domain_current_T63grid.nc" "ice_discharge_T63grid.nc"; do
#            if [[ -f ${COUPLE_DIR}/${PISM_HEMISPHERE}/${FILE} ]]
#            then
#                echo " * processing ${FILE} for ${PISM_HEMISPHERE} ... "
#                cdo -s sellonlatbox,0,360,-90,0 ${COUPLE_DIR}/${PISM_HEMISPHERE}/$FILE ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/cdo_ice2echam
#                ncecat -O ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
##                ncwa -a time ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
#                ncpdq -O -a lat,lon,record ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE tmp 2>>${COUPLE_DIR}/${PISM_HEMISPHERE}/nco_ice2echam; mv tmp ${COUPLE_DIR}/${PISM_HEMISPHERE}/sellonlatbox.$FILE
#        
#                ncrcat -O "${COUPLE_DIR}/pism_nh/sellonlatbox.$FILE" "${COUPLE_DIR}/pism_sh/sellonlatbox.$FILE" "${COUPLE_DIR}/$FILE" 2>>${COUPLE_DIR}/nco_ice2echam
#                ncpdq -O -a record,lat,lon ${COUPLE_DIR}/$FILE tmp 2>>${COUPLE_DIR}/nco_ice2echam; mv tmp ${COUPLE_DIR}/$FILE
#                ncwa -O -a record ${COUPLE_DIR}/$FILE tmp 2>>${COUPLE_DIR}/nco_ice2echam; mv tmp ${COUPLE_DIR}/$FILE
#            fi
#        done

        # Combine pism_nh and pism_sh fields into the shared couple/ directory.
        # The hemisphere files cover the full T63/T511 grid but flag cells outside
        # the local model domain as MISSING (not zero).  Plain 'cdo add' then
        # produces missing everywhere (missing + valid = missing for any single
        # cell, because NH-valid and SH-valid are mutually exclusive masks), so
        # the combined field is all-NaN and downstream setmisstoc,0 produces an
        # identically-zero result.  Set missing -> 0 in each input before adding.
        for FILE in "ice_mask_current_T63grid.nc" "ice_domain_current_T63grid.nc" "ice_discharge_T63grid.nc"; do
            _nh=${COUPLE_DIR}/pism_nh/${FILE}
            _sh=${COUPLE_DIR}/pism_sh/${FILE}
            _out=${COUPLE_DIR}/${FILE}
            if [[ -f $_nh ]] && [[ -f $_sh ]]; then
                echo " * combining ${FILE} for pism_nh and pism_sh ..."
                rm -f "$_out"
                cdo -s add -setmisstoc,0 $_nh -setmisstoc,0 $_sh $_out 2>>${COUPLE_DIR}/cdo_ice2echam
            elif [[ -f $_nh ]]; then
                echo " * using pism_nh only for ${FILE} (pism_sh file absent) ..."
                cp -f $_nh $_out
            elif [[ -f $_sh ]]; then
                echo " * using pism_sh only for ${FILE} (pism_nh file absent) ..."
                cp -f $_sh $_out
            fi
            unset _nh _sh _out
        done
        # Combine orography files correctly: pism_nh full-orog + pism_sh anomaly-only.
        # Using 'cdo add' on two full-orog files would double the reference topography.
        for ORO_BASE in "echam6_new_orography_before_calnoro_high_res.nc" "echam6_new_orography_before_calnoro_low_res.nc"; do
            case $ORO_BASE in
                *high_res*) _sh_anom=${COUPLE_DIR}/pism_sh/ice_orog_difference_T511grid.nc ;;
                *low_res*)  _sh_anom=${COUPLE_DIR}/pism_sh/ice_orog_difference_T63grid.nc  ;;
            esac
            _nh_base=${COUPLE_DIR}/pism_nh/${ORO_BASE}
            _out=${COUPLE_DIR}/${ORO_BASE}
            if [[ -f $_nh_base ]] && [[ -f $_sh_anom ]]; then
                echo " * combining ${ORO_BASE} (pism_nh full orog + pism_sh anomaly) ..."
                rm -f "$_out"
                cdo -s add $_nh_base -setmisstoc,0 $_sh_anom $_out 2>>${COUPLE_DIR}/cdo_ice2echam
            elif [[ -f $_nh_base ]]; then
                echo " * using pism_nh only for ${ORO_BASE} (pism_sh anomaly absent) ..."
                cp -f $_nh_base $_out
            fi
            unset _nh_base _sh_anom _out
        done

        unset PISM_HEMISPHERE
        ice2echam_2nd
}
