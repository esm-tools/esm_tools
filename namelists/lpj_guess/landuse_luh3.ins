! LUH3 NetCDF land use input configuration
! Use this instead of landuse.ins when use_luh3_input is enabled

! Enable LUH3 NetCDF input (set to 1 to use NetCDF files instead of text files)
param "use_luh3_input" (num 1)

! Paths to pre-regridded LUH3 NetCDF files
! These paths should be set via ESM-Tools yaml config or runscript
! param "file_luh3_states"      (str "")
! param "file_luh3_transitions" (str "")
! param "file_luh3_management"  (str "")
