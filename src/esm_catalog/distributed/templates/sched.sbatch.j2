#!/bin/bash
#SBATCH --job-name={{ job_prefix }}-sched
#SBATCH -N1 -n1 -c8
#SBATCH --mem-per-cpu=2G
#SBATCH --qos={{ qos | default('12h') }}
#SBATCH --time={{ walltime | default('04:00:00') }}
#SBATCH --partition={{ partition | default('smp') }}
#SBATCH -o {{ log_dir }}/sched.%j.log
set -euo pipefail
source /etc/profile.d/modules.sh
module load {{ container_module }}
export {{ cache_env_var }}={{ scratch_dir }}/container-cache
IMG=oras://ghcr.io/esm-tools/esm_tools:sif-{{ image_tag }}
COORD_DIR={{ scratch_dir }}/coord
LOG={{ log_dir }}/sched.${SLURM_JOB_ID}.log
mkdir -p "$COORD_DIR" {{ log_dir }}
rm -f "$COORD_DIR/scheduler_address.txt"
HOST=$(hostname)

# Start the scheduler in the background and wait for it to actually announce
# itself in its own log before publishing the address file -- writing the
# address as soon as the job starts lets workers try to connect before dask
# scheduler has bound its port, relying on dask's own retry logic to paper
# over the race rather than guaranteeing readiness.
{{ container_bin }} exec --cleanenv --env PYTHONNOUSERSITE=1 {{ bind_flags }} "$IMG" dask scheduler --host "$HOST" &
SCHED_PID=$!

for i in $(seq 1 60); do
  grep -q "Scheduler at:" "$LOG" 2>/dev/null && break
  if ! kill -0 "$SCHED_PID" 2>/dev/null; then
    echo "dask scheduler process died before announcing readiness" >&2
    exit 1
  fi
  sleep 2
done
grep -q "Scheduler at:" "$LOG" 2>/dev/null || { echo "scheduler never announced readiness after 120s" >&2; exit 1; }

echo "tcp://$HOST:8786" > "$COORD_DIR/scheduler_address.txt"
wait "$SCHED_PID"
