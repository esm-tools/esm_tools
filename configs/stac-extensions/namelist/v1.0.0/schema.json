{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://esm-tools.github.io/stac-extensions/namelist/v1.0.0/schema.json",
  "title": "Namelist Extension",
  "description": "STAC Namelist Extension for STAC Items and Collections, exposing Fortran namelist parameters for search.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://esm-tools.github.io/stac-extensions/namelist/v1.0.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Collection",
        "Feature"
      ]
    }
  },
  "oneOf": [
    {
      "$comment": "Item: nml:{component}:{group}:{key} live in properties.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/definitions/item_fields"
        }
      }
    },
    {
      "$comment": "Collection: nml:files/groups/parameters at top level.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "nml:files": {
          "title": "Namelist files",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nml:groups": {
          "title": "Namelist groups",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nml:parameters": {
          "title": "Flattened namelist parameters",
          "description": "Maps 'group:key' to the parameter's scalar value, for CQL2 filtering.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/scalar_or_list"
          }
        }
      }
    }
  ],
  "definitions": {
    "item_fields": {
      "type": "object",
      "patternProperties": {
        "^nml:": {
          "$ref": "#/definitions/scalar_or_list"
        }
      }
    },
    "scalar_or_list": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      ]
    }
  }
}
