#!/bin/ksh
## @file
## @brief Hand the ISM-mapper surface mass balance output to the ice sheet.
##
## The ISM-mapper writes {prefix}_smb_{year}.nc on the ice sheet's own grid,
## twelve monthly means per year. This puts the chunk's years into COUPLE_DIR
## as atmosphere_file_for_ice.nc, which is what the PISM side reads.
##
## With SMB_COUPLED unset this falls back to just_copy, the fixed paleo file.

function smb2ice()
{
    if [ "${SMB_COUPLED:-0}" != "1" ]; then
        . ${FUNCTION_PATH}/just_copy_stuff.functions
        just_copy
        return $?
    fi

    echo "        =================================================================="
    echo "        *** S T A R T I N G    smb2ice ***"

    _src_dir=${ISM_OUTDATA_DIR:-${COUPLE_DIR}/../outdata/ismm}
    _prefix=${ISM_PREFIX:-antar}
    _out=${COUPLE_DIR}/atmosphere_file_for_ice.nc

    # Select THIS chunk's years only. outdata/ismm keeps every year the
    # experiment has ever written and is never pruned, so the plain
    # ${_prefix}_smb_*.nc glob that used to be here grew by one file per chunk
    # and made each handoff a cumulative running mean over all years to date:
    # chunk 1 got 1900, chunk 28 got the mean of 1900-1927. That silently
    # smoothed away the interannual SMB signal (sd 153 Gt/yr in repro_ism37)
    # and lagged PISM behind the atmosphere's warming by a growing margin.
    # echam2ice makes the same selection with `cdo -selyear`; here the years
    # are separate files, so filter the file list instead.
    # The chunk dates are what makes the selection possible; without them the
    # only thing this could do is average across chunks again, so fail instead
    # of silently reintroducing the bug.
    _y0=${CHUNK_START_DATE_fesom%%-*}
    _y1=${CHUNK_END_DATE_fesom%%-*}
    if [ -z "${_y0}" ] || [ -z "${_y1}" ]; then
        echo " *** CHUNK_START_DATE_fesom / CHUNK_END_DATE_fesom not set ***"
        echo " *** (env_oifs2ice.py must export both) ***"
        echo "chunk dates unset for chunk ${CHUNK_NUMBER}: cannot select" \
             "this chunk's ${_prefix}_smb years" \
            > "${COUPLE_DIR}/.coupling_failed${COUPLING_FAIL_SUFFIX:-}"
        exit 1
    fi

    _files=""
    for _f in ${_src_dir}/${_prefix}_smb_*.nc ; do
        [ -e "${_f}" ] || continue
        _fy=${_f##*_smb_}
        _fy=${_fy%.nc}
        # 10# so a zero-padded paleo year is not read as octal
        case ${_fy} in *[!0-9]*) continue ;; esac
        if [ $((10#${_fy})) -ge $((10#${_y0})) ] && \
           [ $((10#${_fy})) -le $((10#${_y1})) ]; then
            _files="${_files} ${_f}"
        fi
    done
    _nfiles=$(echo ${_files} | wc -w)
    _want=$(( 10#${_y1} - 10#${_y0} + 1 ))
    if [ "${_nfiles}" -ne "${_want}" ]; then
        echo " *** chunk ${CHUNK_NUMBER} wants years ${_y0}-${_y1}"
        echo " *** (${_want} file(s)) but found ${_nfiles} in ${_src_dir} ***"
        echo "incomplete ISM-mapper output for chunk ${CHUNK_NUMBER}:" \
             "years ${_y0}-${_y1}, found ${_nfiles} of ${_want}" \
            > "${COUPLE_DIR}/.coupling_failed${COUPLING_FAIL_SUFFIX:-}"
        exit 1
    fi
    echo "         * ${_nfiles} year(s) ${_y0}-${_y1} from ${_src_dir}"

    # The ice sheet is forced with a repeating annual cycle, so a multi-year
    # chunk collapses to the chunk mean seasonal cycle.
    rm -f ${_out}
    if [ "${_nfiles}" -eq 1 ]; then
        cp ${_files} ${_out}
    else
        cdo -s -O ymonmean -mergetime ${_files} ${_out}
    fi

    cat > ${COUPLE_DIR}/atmosphere_names_for_ice.dat <<EOF
atmosphere_name_precipitation_liquid=${_prefix}_Precip_liquid
atmosphere_units_precipitation_liquid=m/s
atmosphere_name_precipitation_solid=${_prefix}_Precip_solid
atmosphere_units_precipitation_solid=m/s
atmosphere_name_evaporation=${_prefix}_Evaporation
atmosphere_units_evaporation=kg/m2/s
atmosphere_name_runoff=${_prefix}_Runoff
atmosphere_units_runoff=m/s
atmosphere_name_temperature_below_firn=${_prefix}_Soil4T
atmosphere_units_temperature_below_firn=K
atmosphere_name_sst=${_prefix}_SST
atmosphere_units_sst=K
EOF

    cdo -s infon ${_out} 2>/dev/null | head -20

    # concurrent coupling: publish the tagged files and the cycle marker
    if [ "${COUPLING_MODE:-serial}" = "concurrent" ]; then
        . ${FUNCTION_PATH}/../general/coupling_general.functions
        for _f in atmosphere_file_for_ice.nc atmosphere_names_for_ice.dat ; do
            cp "${COUPLE_DIR}/${_f}" "${COUPLE_DIR}/${_f}.chunk_${CHUNK_NUMBER}"
        done
        _ok=1
        for _f in ocean_file_for_ice.nc ocean.griddes ocean_names_for_ice.dat \
                  atmosphere_file_for_ice.nc atmosphere_names_for_ice.dat ; do
            [ -e "${COUPLE_DIR}/${_f}.chunk_${CHUNK_NUMBER}" ] || \
                { echo " *** missing ${_f}.chunk_${CHUNK_NUMBER} ***"; _ok=0; }
        done
        if [ ${_ok} -eq 1 ]; then
            touch_coupling_marker "${COUPLE_DIR}/awiesm3_chunk_${CHUNK_NUMBER}.done"
        else
            echo "incomplete AWI->PISM handoff set for chunk ${CHUNK_NUMBER}" \
                > "${COUPLE_DIR}/.coupling_failed${COUPLING_FAIL_SUFFIX:-}"
            exit 1
        fi
        unset _f _ok
    fi

    if [ "${HARVEST_PARALLEL_INI:-0}" = "1" ]; then
        . ${FUNCTION_PATH}/../general/harvest.functions
        harvest_pism_bootstrap
    fi

    unset _src_dir _prefix _out _files _nfiles _y0 _y1 _y _f _fy _want
    echo "        *** F I N I S H E D    smb2ice ***"
    echo "        =================================================================="
}
