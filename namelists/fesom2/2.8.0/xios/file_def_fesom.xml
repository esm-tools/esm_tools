<?xml version="1.0"?>
<!-- Standalone FESOM file_def. One file per variable, grouped by output
     frequency (1d / 1mo / 1y), split yearly, named <var>.fesom.<year>.nc as
     FESOM's own writer does, so nothing downstream cares which writer ran.
     The %start_date% token is what produces that name; without it XIOS
     appends its own "_<start>-<end>" instead.

     Under -DFESOM_WITH_XIOS=ON namelist.io is not read, so this file decides
     what is written and how often. Streams behind a diagnostic switch (FORC,
     hc300m) also need that switch in context_fesom.xml.

     Fields the model sends but does not declare in its own field_def (uwind,
     vwind, tair, shum, swr, lwr, hc300m, unod_sfc, vnod_sfc) are declared
     inline below.

     tx_sur and ty_sur are commented out: they are the only grid_2d_elem
     fields, and that grid has aborted a run in CGrid::maskField. They write
     fine with XIOS on its own server ranks, but that has never been tested
     attached, which is the mode this file is for.

     No par_access="independent" and no compression_level: with
     type="one_file" an independent write cannot extend the record dimension,
     and a deflate filter on a collective write fails in this netcdf/hdf5
     stack. -->
<file_definition type="one_file" format="netcdf4" par_access="collective"
                 time_counter_name="time" time_counter="exclusive">

  <!-- ================= Daily ================= -->
  <file_group id="fesom_1d" output_freq="1d" split_freq="1y" split_freq_format="%y" enabled="true">

    <!-- ocean and sea-ice surface state -->
    <file id="f_sst"    name="sst.fesom.%start_date%"   ><field field_ref="sst"   /></file>
    <file id="f_sss"    name="sss.fesom.%start_date%"   ><field field_ref="sss"   /></file>
    <file id="f_ssh"    name="ssh.fesom.%start_date%"   ><field field_ref="ssh"   /></file>
    <file id="f_uice"   name="uice.fesom.%start_date%"  ><field field_ref="uice"  /></file>
    <file id="f_vice"   name="vice.fesom.%start_date%"  ><field field_ref="vice"  /></file>
    <file id="f_a_ice"  name="a_ice.fesom.%start_date%" ><field field_ref="a_ice" /></file>
    <file id="f_m_ice"  name="m_ice.fesom.%start_date%" ><field field_ref="m_ice" /></file>
    <file id="f_m_snow" name="m_snow.fesom.%start_date%"><field field_ref="m_snow"/></file>
    <file id="f_ist"    name="ist.fesom.%start_date%"   ><field field_ref="ist"   /></file>
    <file id="f_h_ice"  name="h_ice.fesom.%start_date%" ><field field_ref="h_ice" /></file>
    <file id="f_h_snow" name="h_snow.fesom.%start_date%"><field field_ref="h_snow"/></file>
    <file id="f_fh"     name="fh.fesom.%start_date%"    ><field field_ref="fh"    /></file>

    <!-- surface velocity on nodes: dynamics%uvnode(:,1,:), 2D -->
    <file id="f_unod_sfc" name="unod_sfc.fesom.%start_date%">
      <field id="unod_sfc" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="zonal surface velocity at nodes" unit="m s-1"/>
    </file>
    <file id="f_vnod_sfc" name="vnod_sfc.fesom.%start_date%">
      <field id="vnod_sfc" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="meridional surface velocity at nodes" unit="m s-1"/>
    </file>

    <!-- heat content, needs ldiag_destine -->
    <file id="f_hc300m" name="hc300m.fesom.%start_date%">
      <field id="hc300m" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="vertically integrated heat content, upper 300 m" unit="J m-2"/>
    </file>

    <!-- atmospheric forcing and surface fluxes -->
    <file id="f_uwind" name="uwind.fesom.%start_date%">
      <field id="uwind" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="10m zonal surface wind velocity" unit="m s-1"/>
    </file>
    <file id="f_vwind" name="vwind.fesom.%start_date%">
      <field id="vwind" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="10m meridional surface wind velocity" unit="m s-1"/>
    </file>
    <file id="f_tair" name="tair.fesom.%start_date%">
      <field id="tair" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="surface air temperature" unit="degC"/>
    </file>
    <file id="f_shum" name="shum.fesom.%start_date%">
      <field id="shum" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="specific humidity" unit="1"/>
    </file>
    <file id="f_swr" name="swr.fesom.%start_date%">
      <field id="swr" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="short wave radiation" unit="W m-2"/>
    </file>
    <file id="f_lwr" name="lwr.fesom.%start_date%">
      <field id="lwr" grid_ref="grid_2d_nod" operation="average" prec="4"
             long_name="long wave radiation" unit="W m-2"/>
    </file>
    <file id="f_prec"      name="prec.fesom.%start_date%"     ><field field_ref="prec"     /></file>
    <file id="f_snow"      name="snow.fesom.%start_date%"     ><field field_ref="snow"     /></file>
    <file id="f_evap"      name="evap.fesom.%start_date%"     ><field field_ref="evap"     /></file>
    <file id="f_runoff"    name="runoff.fesom.%start_date%"   ><field field_ref="runoff"   /></file>
    <file id="f_virtsalt"  name="virtsalt.fesom.%start_date%" ><field field_ref="virtsalt" /></file>
    <file id="f_realsalt"  name="realsalt.fesom.%start_date%" ><field field_ref="realsalt" /></file>
    <file id="f_relaxsalt" name="relaxsalt.fesom.%start_date%"><field field_ref="relaxsalt"/></file>

  </file_group>

  <!-- ================= Monthly ================= -->
  <file_group id="fesom_1mo" output_freq="1mo" split_freq="1y" split_freq_format="%y" enabled="true">

    <!-- 2D nodes -->
    <file id="f_MLD1"            name="MLD1.fesom.%start_date%"           ><field field_ref="MLD1"           /></file>
    <file id="f_MLD2"            name="MLD2.fesom.%start_date%"           ><field field_ref="MLD2"           /></file>
    <file id="f_MLD3"            name="MLD3.fesom.%start_date%"           ><field field_ref="MLD3"           /></file>
    <file id="f_fw"              name="fw.fesom.%start_date%"             ><field field_ref="fw"             /></file>
    <file id="f_thdgrarea"       name="thdgrarea.fesom.%start_date%"      ><field field_ref="thdgrarea"      /></file>
    <file id="f_dyngrarea"       name="dyngrarea.fesom.%start_date%"      ><field field_ref="dyngrarea"      /></file>
    <file id="f_thdgrice"        name="thdgrice.fesom.%start_date%"       ><field field_ref="thdgrice"       /></file>
    <file id="f_dyngrice"        name="dyngrice.fesom.%start_date%"       ><field field_ref="dyngrice"       /></file>
    <file id="f_thdgrsnw"        name="thdgrsnw.fesom.%start_date%"       ><field field_ref="thdgrsnw"       /></file>
    <file id="f_atmice_x"        name="atmice_x.fesom.%start_date%"       ><field field_ref="atmice_x"       /></file>
    <file id="f_atmice_y"        name="atmice_y.fesom.%start_date%"       ><field field_ref="atmice_y"       /></file>
    <file id="f_iceoce_x"        name="iceoce_x.fesom.%start_date%"       ><field field_ref="iceoce_x"       /></file>
    <file id="f_iceoce_y"        name="iceoce_y.fesom.%start_date%"       ><field field_ref="iceoce_y"       /></file>
    <file id="f_fw_ice"          name="fw_ice.fesom.%start_date%"         ><field field_ref="fw_ice"         /></file>
    <file id="f_fw_snw"          name="fw_snw.fesom.%start_date%"         ><field field_ref="fw_snw"         /></file>
    <file id="f_qcon"            name="qcon.fesom.%start_date%"           ><field field_ref="qcon"           /></file>
    <file id="f_apnd"            name="apnd.fesom.%start_date%"           ><field field_ref="apnd"           /></file>
    <file id="f_hpnd"            name="hpnd.fesom.%start_date%"           ><field field_ref="hpnd"           /></file>
    <file id="f_ipnd"            name="ipnd.fesom.%start_date%"           ><field field_ref="ipnd"           /></file>
    <file id="f_pbo"             name="pbo.fesom.%start_date%"            ><field field_ref="pbo"            /></file>
    <file id="f_opottemptend"    name="opottemptend.fesom.%start_date%"   ><field field_ref="opottemptend"   /></file>
    <file id="f_opottemprmadvect" name="opottemprmadvect.fesom.%start_date%"><field field_ref="opottemprmadvect"/></file>
    <file id="f_opottempdiff"    name="opottempdiff.fesom.%start_date%"   ><field field_ref="opottempdiff"   /></file>
    <file id="f_osalttend"       name="osalttend.fesom.%start_date%"      ><field field_ref="osalttend"      /></file>
    <file id="f_osaltrmadvect"   name="osaltrmadvect.fesom.%start_date%"  ><field field_ref="osaltrmadvect"  /></file>
    <file id="f_osaltdiff"       name="osaltdiff.fesom.%start_date%"      ><field field_ref="osaltdiff"      /></file>

    <!-- 2D elements -->
    <!-- grid_2d_elem: see the header. Untested attached.
    <file id="f_tx_sur" name="tx_sur.fesom.%start_date%"><field field_ref="tx_sur"/></file>
    <file id="f_ty_sur" name="ty_sur.fesom.%start_date%"><field field_ref="ty_sur"/></file>
    -->

    <!-- 3D nodes, cell-center -->
    <file id="f_temp"       name="temp.fesom.%start_date%"      ><field field_ref="temp"      /></file>
    <file id="f_salt"       name="salt.fesom.%start_date%"      ><field field_ref="salt"      /></file>
    <file id="f_unod"       name="unod.fesom.%start_date%"      ><field field_ref="unod"      /></file>
    <file id="f_vnod"       name="vnod.fesom.%start_date%"      ><field field_ref="vnod"      /></file>
    <file id="f_hnode"      name="hnode.fesom.%start_date%"     ><field field_ref="hnode"     /></file>
    <file id="f_rsdoabsorb" name="rsdoabsorb.fesom.%start_date%"><field field_ref="rsdoabsorb"/></file>

    <!-- 3D nodes, interface levels -->
    <file id="f_w" name="w.fesom.%start_date%"><field field_ref="w"/></file>

    <!-- 3D elements, cell-center -->
    <file id="f_u" name="u.fesom.%start_date%"><field field_ref="u"/></file>
    <file id="f_v" name="v.fesom.%start_date%"><field field_ref="v"/></file>

  </file_group>

  <!-- ================= Yearly ================= -->
  <file_group id="fesom_1y" output_freq="1y" split_freq="1y" split_freq_format="%y" enabled="true">

    <!-- 3D nodes, interface levels -->
    <file id="f_N2"      name="N2.fesom.%start_date%"     ><field field_ref="N2"     /></file>
    <file id="f_Kv"      name="Kv.fesom.%start_date%"     ><field field_ref="Kv"     /></file>
    <file id="f_bolus_w" name="bolus_w.fesom.%start_date%"><field field_ref="bolus_w"/></file>

    <!-- 3D elements -->
    <file id="f_bolus_u" name="bolus_u.fesom.%start_date%"><field field_ref="bolus_u"/></file>
    <file id="f_bolus_v" name="bolus_v.fesom.%start_date%"><field field_ref="bolus_v"/></file>
    <file id="f_Av"      name="Av.fesom.%start_date%"     ><field field_ref="Av"     /></file>

  </file_group>

</file_definition>
