<?xml version="1.0"?>
<file_definition type="one_file" format="netcdf4" par_access="collective"
                 compression_level="{{xios.compression_level}}"
                 time_counter_name="time" time_counter="exclusive">

  <!-- Minimal FESOM-2 file definition: monthly output only, matching the
       upstream default config/namelist.io on FESOM/fesom2:main. One file
       per variable, split yearly. -->

  <!-- freq_op="1mo" matches output_freq so XIOS asks once per month via
       xios_field_is_active. FESOM sends the FESOM-internal monthly mean
       once per cycle; XIOS averages over 1 sample (= identity) and writes.
       cell_methods="time: mean (interval: 1 mo)". -->
  <file_group id="fesom_1mo" output_freq="1mo" split_freq="1y" enabled="true">

    <!-- 2D nodes -->
    <file id="f_sst"    name="sst.fesom"   ><field field_ref="sst"     freq_op="1mo"/></file>
    <file id="f_sss"    name="sss.fesom"   ><field field_ref="sss"     freq_op="1mo"/></file>
    <file id="f_ssh"    name="ssh.fesom"   ><field field_ref="ssh"     freq_op="1mo"/></file>
    <file id="f_uice"   name="uice.fesom"  ><field field_ref="uice"    freq_op="1mo"/></file>
    <file id="f_vice"   name="vice.fesom"  ><field field_ref="vice"    freq_op="1mo"/></file>
    <file id="f_a_ice"  name="a_ice.fesom" ><field field_ref="a_ice"   freq_op="1mo"/></file>
    <file id="f_m_ice"  name="m_ice.fesom" ><field field_ref="m_ice"   freq_op="1mo"/></file>
    <file id="f_m_snow" name="m_snow.fesom"><field field_ref="m_snow"  freq_op="1mo"/></file>
    <file id="f_alb"    name="alb.fesom"   ><field field_ref="alb"     freq_op="1mo"/></file>
    <file id="f_apnd"   name="apnd.fesom"  ><field field_ref="apnd"    freq_op="1mo"/></file>
    <file id="f_hpnd"   name="hpnd.fesom"  ><field field_ref="hpnd"    freq_op="1mo"/></file>
    <file id="f_ipnd"   name="ipnd.fesom"  ><field field_ref="ipnd"    freq_op="1mo"/></file>
    <file id="f_MLD1"   name="MLD1.fesom"  ><field field_ref="MLD1"    freq_op="1mo"/></file>
    <file id="f_MLD2"   name="MLD2.fesom"  ><field field_ref="MLD2"    freq_op="1mo"/></file>
    <file id="f_MLD3"   name="MLD3.fesom"  ><field field_ref="MLD3"    freq_op="1mo"/></file>
    <file id="f_fw"     name="fw.fesom"    ><field field_ref="fw"      freq_op="1mo"/></file>
    <file id="f_fh"     name="fh.fesom"    ><field field_ref="fh"      freq_op="1mo"/></file>

    <!-- 2D elements -->
    <file id="f_tx_sur" name="tx_sur.fesom"><field field_ref="tx_sur"  freq_op="1mo"/></file>
    <file id="f_ty_sur" name="ty_sur.fesom"><field field_ref="ty_sur"  freq_op="1mo"/></file>

    <!-- 3D nodes, cell-center -->
    <file id="f_temp" name="temp.fesom"><field field_ref="temp" freq_op="1mo"/></file>
    <file id="f_salt" name="salt.fesom"><field field_ref="salt" freq_op="1mo"/></file>
    <file id="f_unod" name="unod.fesom"><field field_ref="unod" freq_op="1mo"/></file>
    <file id="f_vnod" name="vnod.fesom"><field field_ref="vnod" freq_op="1mo"/></file>

    <!-- 3D nodes, interface levels -->
    <file id="f_w"       name="w.fesom"      ><field field_ref="w"        freq_op="1mo"/></file>
    <file id="f_bolus_w" name="bolus_w.fesom"><field field_ref="bolus_w"  freq_op="1mo"/></file>
    <file id="f_N2"      name="N2.fesom"     ><field field_ref="N2"       freq_op="1mo"/></file>
    <file id="f_Kv"      name="Kv.fesom"     ><field field_ref="Kv"       freq_op="1mo"/></file>

    <!-- 3D elements, cell-center -->
    <file id="f_u"       name="u.fesom"      ><field field_ref="u"        freq_op="1mo"/></file>
    <file id="f_v"       name="v.fesom"      ><field field_ref="v"        freq_op="1mo"/></file>
    <file id="f_bolus_u" name="bolus_u.fesom"><field field_ref="bolus_u"  freq_op="1mo"/></file>
    <file id="f_bolus_v" name="bolus_v.fesom"><field field_ref="bolus_v"  freq_op="1mo"/></file>

    <!-- 3D elements, interface levels -->
    <file id="f_Av" name="Av.fesom"><field field_ref="Av" freq_op="1mo"/></file>

    <!-- dMOC density-coordinate fields (elements) -->
    <file id="f_U_rho_x_DZ"    name="U_rho_x_DZ.fesom"   ><field field_ref="U_rho_x_DZ"    freq_op="1mo"/></file>
    <file id="f_V_rho_x_DZ"    name="V_rho_x_DZ.fesom"   ><field field_ref="V_rho_x_DZ"    freq_op="1mo"/></file>
    <file id="f_std_heat_flux"  name="std_heat_flux.fesom" ><field field_ref="std_heat_flux"  freq_op="1mo"/></file>
    <file id="f_std_rest_flux"  name="std_rest_flux.fesom" ><field field_ref="std_rest_flux"  freq_op="1mo"/></file>
    <file id="f_std_frwt_flux"  name="std_frwt_flux.fesom" ><field field_ref="std_frwt_flux"  freq_op="1mo"/></file>
    <file id="f_std_dens_dVdT"  name="std_dens_dVdT.fesom" ><field field_ref="std_dens_dVdT"  freq_op="1mo"/></file>
    <file id="f_std_dens_Z"     name="std_dens_Z.fesom"    ><field field_ref="std_dens_Z"     freq_op="1mo"/></file>
    <file id="f_std_dens_H"     name="std_dens_H.fesom"    ><field field_ref="std_dens_H"     freq_op="1mo"/></file>

    <!-- dMOC density-coordinate fields (nodes) -->
    <file id="f_std_dens_DIV"      name="std_dens_DIV.fesom"     ><field field_ref="std_dens_DIV"      freq_op="1mo"/></file>
    <file id="f_std_dens_DIVbolus" name="std_dens_DIVbolus.fesom"><field field_ref="std_dens_DIVbolus" freq_op="1mo"/></file>

    <!-- dMOC sigma-2 density on z-levels -->
    <file id="f_density_dMOC" name="density_dMOC.fesom"><field field_ref="density_dMOC" freq_op="1mo"/></file>


    <!-- ===== REcoM / carbon-cycle BGC output (gated by &parecomsetup + ltra_diag) ===== -->
    <file id="f_dpCO2s"      name="dpCO2s.fesom"   ><field field_ref="dpCO2s" freq_op="1mo"/></file>
    <file id="f_pCO2s"       name="pCO2s.fesom"    ><field field_ref="pCO2s" freq_op="1mo"/></file>
    <file id="f_CO2f"        name="CO2f.fesom"     ><field field_ref="CO2f" freq_op="1mo"/></file>
