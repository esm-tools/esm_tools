<!-- Test variant of context_fesom.xml that turns on the ship-track /
     mooring curtain output (io_tracks.F90, feature/tracks branch of
     FESOM). Identical to namelists/fesom2/xios_xml/context_fesom.xml
     except for the additional <variable_group id="fesom_tracks">
     block at the bottom of <variable_definition>.

     io_xios_init reads each <variable> via xios_getvar() after the
     namelist parse, so values here override anything the (skipped)
     namelist.io would have set. -->
<context id="fesom">
  <calendar type="Gregorian"/>

  <field_definition  src="./field_def_fesom.xml"/>
  <file_definition   src="./file_def_fesom.xml"/>
  <axis_definition   src="./axis_def_fesom.xml"/>
  <domain_definition src="./domain_def_fesom.xml"/>
  <grid_definition   src="./grid_def_fesom.xml"/>

  <variable_definition>
    <variable_group id="fesom_runtime">
      <variable id="using_server" type="bool">true</variable>
    </variable_group>

    <!-- FESOM diagnostic flags. Override &diag_list namelist values from XML
         via xios_getvar() in io_xios_init (called after setup_model/namelist
         read, before any diag-gated allocation). If a variable is omitted
         here the namelist value stands. -->
    <variable_group id="fesom_diag_flags">
      <variable id="ldiag_solver"      type="bool">false</variable>
      <variable id="lcurt_stress_surf" type="bool">false</variable>
      <variable id="ldiag_curl_vel3"   type="bool">false</variable>
      <variable id="ldiag_Ri"          type="bool">false</variable>
      <variable id="ldiag_TurbFlux"    type="bool">false</variable>
      <variable id="ldiag_salt3D"      type="bool">false</variable>
      <variable id="ldiag_dMOC"        type="bool">true </variable>
      <variable id="ldiag_DVD"         type="bool">false</variable>
      <variable id="ldiag_forc"        type="bool">false</variable>
      <variable id="ldiag_extflds"     type="bool">false</variable>
      <variable id="ldiag_destine"     type="bool">false</variable>
      <variable id="ldiag_ice"         type="bool">false</variable>
      <variable id="ldiag_trflx"       type="bool">true </variable>
      <variable id="ldiag_uvw_sqr"     type="bool">false</variable>
      <variable id="ldiag_trgrd_xyz"   type="bool">false</variable>
      <variable id="ldiag_cmor"        type="bool">true </variable>
    </variable_group>

    <!-- Ship-track / mooring curtain output (geometry-aware, v2).
         Read by io_xios_init (see io_xios.F90, block right after the
         diag flags). track_files / track_vars / track_names are
         semicolon-separated lists with the same number of entries
         (track_names is optional; defaults to "track1", "track2", ...).
         Each file is resolved relative to the FESOM run work dir.
         Sampling is geometry-aware: for each mesh edge the polyline
         crosses, the value is linear-interpolated between the two
         endpoint nodes using the actual crossing parameter t. No
         densification, no nearest-neighbour snap — output cell count is
         set by the mesh, not by a user knob. track_output_freq is a
         single global cadence ('1h', '6h', '1d', '1mo', '1y'). -->
    <variable_group id="fesom_tracks">
      <variable id="ltracks"             type="bool">true</variable>
      <variable id="track_files"         type="string">track_transect.csv;track_transect.csv;track_transect.csv;track_mosaic_co1.csv;track_mosaic_co2.csv;track_mosaic_co3.csv;track_drake_passage.csv;track_drake_passage.csv;track_drake_passage.csv</variable>
      <variable id="track_vars"          type="string">temp;u;v;temp;temp;temp;vflx;hflx;sflx</variable>
      <variable id="track_names"         type="string">transect;transect_u;transect_v;mosaic_co1;mosaic_co2;mosaic_co3;drake;drake_h;drake_s</variable>
      <variable id="track_output_freq"   type="string">3h</variable>
    </variable_group>
  </variable_definition>
</context>
