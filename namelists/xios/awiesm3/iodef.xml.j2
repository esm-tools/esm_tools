<?xml version="1.0"?>
<simulation>

  <context id="xios">
    <variable_definition>
      <variable_group id="buffer">
        <!-- buffer_size_factor is usually 2.0, but for heavy output you 
             may consider 3.0 or 4.0 --> 
        <variable id="buffer_size_factor" type="double">4.0</variable>
        <variable id="optimal_buffer_size" type="string">performance</variable>
      </variable_group>
      
      <variable_group id="parameters">
        <variable id="using_server" type="bool">true</variable>
        <variable id="using_server2" type="bool">true</variable>
        <variable id="ratio_server2" type="int">50</variable>
        <variable id="number_pools_server2" type="int">1</variable>
        <variable id="using_oasis" type="bool">true</variable>
{%- if (xios.version | string).startswith("3") %}
        <!-- XIOS 3: oasis_codes_id was renamed to clients_code_id; call_oasis_enddef is a XIOS 3-only flag -->
        <variable id="call_oasis_enddef" type="bool">true</variable>
        <!-- Empty clients_code_id disables file-based MPI discovery, using OASIS comms instead -->
        <variable id="clients_code_id" type="string"></variable>
{%- else %}
        <variable id="oasis_codes_id" type="string"></variable>
{%- endif %}
        <variable id="info_level" type="int">50</variable>
        <variable id="print_file" type="bool">true</variable>
      </variable_group>
    </variable_definition>
  </context>

  <!-- OpenIFS context (always present in AWI-ESM) -->
  <context id="oifs" src="./context_ifs.xml" />

{%- if lpj_guess.with_xios %}
  <context id="lpjguess" src="./context_lpjguess.xml" />
{%- endif %}

</simulation>
