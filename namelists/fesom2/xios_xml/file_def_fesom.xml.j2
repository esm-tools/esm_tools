    <file id="f_Hp"          name="Hp.fesom"       ><field field_ref="Hp" freq_op="1mo"/></file>
    <file id="f_aFe"         name="aFe.fesom"      ><field field_ref="aFe" freq_op="1mo"/></file>
    <file id="f_aN"          name="aN.fesom"       ><field field_ref="aN" freq_op="1mo"/></file>
    <file id="f_benN"        name="benN.fesom"     ><field field_ref="benN" freq_op="1mo"/></file>
    <file id="f_benC"        name="benC.fesom"     ><field field_ref="benC" freq_op="1mo"/></file>
    <file id="f_benSi"       name="benSi.fesom"    ><field field_ref="benSi" freq_op="1mo"/></file>
    <file id="f_benCalc"     name="benCalc.fesom"  ><field field_ref="benCalc" freq_op="1mo"/></file>
    <file id="f_NPPn"        name="NPPn.fesom"     ><field field_ref="NPPn" freq_op="1mo"/></file>
    <file id="f_NPPd"        name="NPPd.fesom"     ><field field_ref="NPPd" freq_op="1mo"/></file>
    <file id="f_GPPn"        name="GPPn.fesom"     ><field field_ref="GPPn" freq_op="1mo"/></file>
    <file id="f_GPPd"        name="GPPd.fesom"     ><field field_ref="GPPd" freq_op="1mo"/></file>
    <file id="f_NNAn"        name="NNAn.fesom"     ><field field_ref="NNAn" freq_op="1mo"/></file>
    <file id="f_NNAd"        name="NNAd.fesom"     ><field field_ref="NNAd" freq_op="1mo"/></file>
    <file id="f_ChlDegn"     name="ChlDegn.fesom"  ><field field_ref="ChlDegn" freq_op="1mo"/></file>
    <file id="f_ChlDegd"     name="ChlDegd.fesom"  ><field field_ref="ChlDegd" freq_op="1mo"/></file>
    <file id="f_xCO2atm"     name="xCO2atm.fesom"  ><field field_ref="xCO2atm" freq_op="1mo"/></file>
    <file id="f_PAR"         name="PAR.fesom"      ><field field_ref="PAR" freq_op="1mo"/></file>
    <file id="f_respmeso"    name="respmeso.fesom" ><field field_ref="respmeso" freq_op="1mo"/></file>
    <file id="f_calcdiss"    name="calcdiss.fesom" ><field field_ref="calcdiss" freq_op="1mo"/></file>
    <file id="f_calcif"      name="calcif.fesom"   ><field field_ref="calcif" freq_op="1mo"/></file>
    <file id="f_aggn"        name="aggn.fesom"     ><field field_ref="aggn" freq_op="1mo"/></file>
    <file id="f_aggd"        name="aggd.fesom"     ><field field_ref="aggd" freq_op="1mo"/></file>
    <file id="f_docexn"      name="docexn.fesom"   ><field field_ref="docexn" freq_op="1mo"/></file>
    <file id="f_docexd"      name="docexd.fesom"   ><field field_ref="docexd" freq_op="1mo"/></file>
    <file id="f_respn"       name="respn.fesom"    ><field field_ref="respn" freq_op="1mo"/></file>
    <file id="f_respd"       name="respd.fesom"    ><field field_ref="respd" freq_op="1mo"/></file>
    <file id="f_NPPn3D"      name="NPPn3D.fesom"   ><field field_ref="NPPn3D" freq_op="1mo"/></file>
    <file id="f_NPPd3D"      name="NPPd3D.fesom"   ><field field_ref="NPPd3D" freq_op="1mo"/></file>
    <file id="f_DIN"         name="DIN.fesom"      ><field field_ref="DIN" freq_op="1mo"/></file>
    <file id="f_DIC"         name="DIC.fesom"      ><field field_ref="DIC" freq_op="1mo"/></file>
    <file id="f_Alk"         name="Alk.fesom"      ><field field_ref="Alk" freq_op="1mo"/></file>
    <file id="f_PhyN"        name="PhyN.fesom"     ><field field_ref="PhyN" freq_op="1mo"/></file>
    <file id="f_PhyC"        name="PhyC.fesom"     ><field field_ref="PhyC" freq_op="1mo"/></file>
    <file id="f_PhyChl"      name="PhyChl.fesom"   ><field field_ref="PhyChl" freq_op="1mo"/></file>
    <file id="f_DetN"        name="DetN.fesom"     ><field field_ref="DetN" freq_op="1mo"/></file>
    <file id="f_DetC"        name="DetC.fesom"     ><field field_ref="DetC" freq_op="1mo"/></file>
    <file id="f_HetN"        name="HetN.fesom"     ><field field_ref="HetN" freq_op="1mo"/></file>
    <file id="f_HetC"        name="HetC.fesom"     ><field field_ref="HetC" freq_op="1mo"/></file>
    <file id="f_DON"         name="DON.fesom"      ><field field_ref="DON" freq_op="1mo"/></file>
    <file id="f_DOC"         name="DOC.fesom"      ><field field_ref="DOC" freq_op="1mo"/></file>
    <file id="f_DiaN"        name="DiaN.fesom"     ><field field_ref="DiaN" freq_op="1mo"/></file>
    <file id="f_DiaC"        name="DiaC.fesom"     ><field field_ref="DiaC" freq_op="1mo"/></file>
    <file id="f_DiaChl"      name="DiaChl.fesom"   ><field field_ref="DiaChl" freq_op="1mo"/></file>
    <file id="f_DiaSi"       name="DiaSi.fesom"    ><field field_ref="DiaSi" freq_op="1mo"/></file>
    <file id="f_DetSi"       name="DetSi.fesom"    ><field field_ref="DetSi" freq_op="1mo"/></file>
    <file id="f_DSi"         name="DSi.fesom"      ><field field_ref="DSi" freq_op="1mo"/></file>
    <file id="f_DFe"         name="DFe.fesom"      ><field field_ref="DFe" freq_op="1mo"/></file>
    <file id="f_PhyCalc"     name="PhyCalc.fesom"  ><field field_ref="PhyCalc" freq_op="1mo"/></file>
    <file id="f_DetCalc"     name="DetCalc.fesom"  ><field field_ref="DetCalc" freq_op="1mo"/></file>
    <file id="f_O2"          name="O2.fesom"       ><field field_ref="O2" freq_op="1mo"/></file>
    <file id="f_CO2_aq"      name="CO2_aq.fesom"   ><field field_ref="CO2_aq" freq_op="1mo"/></file>
    <file id="f_pH"          name="pH.fesom"       ><field field_ref="pH" freq_op="1mo"/></file>
    <file id="f_pCO2"        name="pCO2.fesom"     ><field field_ref="pCO2" freq_op="1mo"/></file>
    <file id="f_HCO3"        name="HCO3.fesom"     ><field field_ref="HCO3" freq_op="1mo"/></file>
