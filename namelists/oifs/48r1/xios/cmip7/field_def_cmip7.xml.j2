    <field id="tvl"    long_name="type of low vegetation"                                     standard_name="type_of_low_vegetation"                                   unit="1" />
    <field id="tvh"    long_name="type of high vegetation"                                    standard_name="type_of_high_vegetation"                                  unit="1" />
    <field id="cvl"    long_name="low vegetation cover"                                       standard_name="low_vegetation_cover"                                     unit="1" />
    <field id="cvh"    long_name="high vegetation cover"                                      standard_name="high_vegetation_cover"                                    unit="1" />
    <field id="lai_lv" long_name="leaf area index low vegetation"                             standard_name="leaf_area_index_low_vegetation"                           unit="m2 m-2" />
    <field id="lai_hv" long_name="leaf area index high vegetation"                            standard_name="leaf_area_index_high_vegetation"                          unit="m2 m-2" />
    <!-- WARNING: 'cin' doesn't have properly data, don't use it -->
    <field id="cin"    long_name="convective inhibition"                                      standard_name="atmosphere_convective_inhibition_wrt_surface"             unit="J kg-1" />
    <field id="lmlt"   long_name="lake mixed layer temperature"                                                                                                        unit="K" />
