    <field id="pextra_95"  long_name="T-tendency from radiation"                                                           unit="K/s * s" />
    <field id="pextra_96"  long_name="u-tendency from vert. diff + orog drag + surf processes"                             unit="m/s2 * s" />
    <field id="pextra_97"  long_name="v-tendency from vert. diff + orog drag + surf processes"                             unit="m/s2 * s" />
    <field id="pextra_98"  long_name="T-tendency from vert. diff + orog drag + surf processes"                             unit="K/s * s" />
    <field id="pextra_99"  long_name="q-tendency from vert. diff + orog drag + surf processes"                             unit="kg/kg/s * s" />
