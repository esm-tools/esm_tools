#!/usr/bin/ksh

# --- couple_timer: per-step profiling timer (see coupling_fesom2ice.functions) ---
if ! command -v couple_timer >/dev/null 2>&1 ; then
    couple_timer() {
        _ct_now=$(date +%s.%N 2>/dev/null) || _ct_now=$(date +%s)
        _ct_stamp=$(date +'%Y-%m-%dT%H:%M:%S' 2>/dev/null)
        if [ -n "${COUPLE_TIMER_LAST:-}" ] ; then
            awk -v a="${COUPLE_TIMER_LAST}" -v b="${_ct_now}" -v l="${COUPLE_TIMER_LABEL:-start}" \
                -v t="${_ct_stamp}" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9.2f s\n", t, l, (b-a) }'
        else
            # First mark: there is no previous section to time, but stamp it anyway.
            # Without this, any time spent BEFORE instrumentation starts (esm_tools
            # internals, file staging) is invisible -- the absolute stamps let you
            # line the [TIMER] lines up against the job's own start/end.
            awk -v t="${_ct_stamp}" -v l="$1" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9s\n", t, "(instrumentation starts: " l ")", "--" }'
        fi
        COUPLE_TIMER_LAST="${_ct_now}"
        COUPLE_TIMER_LABEL="$1"
    }
    # couple_timer_end: stamp the LAST section, which otherwise never prints (its
    # duration is only emitted by the *next* mark, and at the end of a function
    # there isn't one). Call it right before a coupling function returns.
    couple_timer_end() {
        if [ -n "${COUPLE_TIMER_LAST:-}" ] ; then
            _ct_now=$(date +%s.%N 2>/dev/null) || _ct_now=$(date +%s)
            awk -v a="${COUPLE_TIMER_LAST}" -v b="${_ct_now}" -v l="${COUPLE_TIMER_LABEL:-start}" \
                -v t="$(date +'%Y-%m-%dT%H:%M:%S' 2>/dev/null)" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9.2f s\n", t, l, (b-a) }'
            unset COUPLE_TIMER_LAST COUPLE_TIMER_LABEL
        fi
    }
fi

pism2esm() {
    echo " *** S T A R T I N G    pism2esm *** "
    echo "modules loaded:"
    echo $(module list)

    . ${FUNCTION_PATH}/../general/general_lists.functions
    . ${FUNCTION_PATH}/../general/general_helpers.functions
    . ${FUNCTION_PATH}/../general/coupling_general.functions
    . ${FUNCTION_PATH}/coupling_pism2atmosphere.functions
    . ${FUNCTION_PATH}/coupling_pism2ocean.functions
    . ${FUNCTION_PATH}/../fesom/coupling_ice2fesom_interactive_mesh.functions

    # Extract the ice-geometry variables PISM hands to the rest of the system.
    # ice_subNN = (usurf - thk) on floating ice (mask==3) is the cavity-roof depth
    # consumed by mesh_flags.py to flag max-mesh nodes.
    echo " *   extracting ice geometry variables from PISM output"
    echo " *     input:  ${OUTPUT_DIR_pism}/latest_ex_file_pism.nc"
    echo " *     output: ${COUPLE_DIR}/latest_ice_geometry.nc"

    couple_timer "pism2esm: pism2atmosphere"
    echo " *   calling pism2atmosphere"
    pism2atmosphere 2>> ${COUPLE_DIR}/cdo_stderr_pism2awiesm
    couple_timer "pism2esm: ice-geometry seltimestep/expr"
    if [[ -f ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc ]]; then
        cdo seltimestep,-1 \
            -expr,"ice_subNN=(usurf-thk)*(mask==3); shelf_msk=(mask==3); ocean_msk=(mask==4); land_msk=(mask<=3); grounded_ice_mask=((mask==2)); mask=mask;" \
            ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc \
            ${COUPLE_DIR}/latest_ice_geometry.nc
        echo "coming soon: change ocean= $CHANGE_OCEAN"
    else
        echo " *   WARNING: PISM output file not found, skipping ice-geometry extraction"
    fi
    couple_timer "pism2esm: pism2ocean"
    echo " *   calling pism2ocean"
    pism2ocean 2>> ${COUPLE_DIR}/cdo_stderr_pism2ocean

    couple_timer "pism2esm: DONE"

    echo " *** pism2esm done *** "
}
