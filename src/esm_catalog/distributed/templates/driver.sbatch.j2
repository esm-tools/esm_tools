#!/bin/bash
#SBATCH --job-name={{ job_prefix }}-driver
#SBATCH -N1 -n1 -c8
#SBATCH --mem-per-cpu=2G
#SBATCH --qos={{ qos | default('12h') }}
#SBATCH --time={{ walltime | default('04:00:00') }}
#SBATCH --partition={{ partition | default('smp') }}
#SBATCH -o {{ log_dir }}/driver.%j.log
set -euo pipefail
source /etc/profile.d/modules.sh
module load {{ container_module }}
export {{ cache_env_var }}={{ scratch_dir }}/container-cache
IMG=oras://ghcr.io/esm-tools/esm_tools:sif-{{ image_tag }}
EXP_ROOT={{ exp_root }}
CATALOG_DIR={{ catalog_dir }}
COORD_DIR={{ scratch_dir }}/coord
ADDR_FILE="$COORD_DIR/scheduler_address.txt"
mkdir -p "$CATALOG_DIR"

for i in $(seq 1 60); do
  [ -s "$ADDR_FILE" ] && break
  sleep 5
done
SCHED_ADDR=$(cat "$ADDR_FILE")

# not required for correctness -- dask dispatches to whoever is registered
# and workers can join mid-scan -- just avoids starting against a nearly
# empty cluster while the worker array is still trickling in
sleep 30

{{ container_bin }} exec --cleanenv --env PYTHONNOUSERSITE=1 {{ bind_flags }} "$IMG" esm-catalog scan \
  --exp-root "$EXP_ROOT" \
  --catalog-dir "$CATALOG_DIR" \
  --distributed --scheduler "$SCHED_ADDR" --verbose
{% if push_after_scan %}
# Scan succeeded (set -e would already have aborted otherwise) -- push the
# freshly-scanned catalog straight to the server as the last step of this
# job, same container, same bind mount.
{{ container_bin }} exec --cleanenv --env PYTHONNOUSERSITE=1 {{ bind_flags }} "$IMG" esm-catalog push "$CATALOG_DIR" --server {{ server_url | default('https://stac-dev.awi.de') }} -v
{% endif %}
