         Replaces the IFS default 'r' which uses FOEEWM mixed-phase QSAT (not CMIP-conformant). -->
    <field id="hur_cmip7" long_name="relative humidity (CMIP7 online)"        standard_name="relative_humidity"                         unit="1" />
