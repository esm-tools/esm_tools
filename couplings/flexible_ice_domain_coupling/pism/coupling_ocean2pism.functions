function iterative_coupling_ocean_pism_prepare_pico_ocean_forcing {
    _bfile=$1
    _ofile=$2

    for _file in $_ofile $_bfile ; do
        if [ ! -f $_file ] ; then
            echo " Missing file $_file"
            echo " S T O P  99"
            exit 99
        fi
    done

    # Guard against the basins file being the forcing file itself, which is
    # what happens when PISM_OCEAN_PICO_BASINS_FILE is unset: ncks would then
    # be asked to copy "basins" from a file that does not have it, and PISM
    # only fails much later with "Can't find 'basins' in the regridding file".
    if ! ncdump -h $_bfile | grep -qE "[[:space:]]basins[[:space:]]*\(" ; then
        echo ""
        echo " !!! No 'basins' variable in >>${_bfile}<<"
        echo " !!! PICO_OCEAN needs one. Set PICO_basins_only_file (or basin_file)"
        echo " !!! in the ice domain's runscript section to a file that has it."
        echo " S T O P  45"
        exit 45
    fi

    echo "Wrting basins from $_bfile to $_ofile"
    ncks -Av basins $_bfile $_ofile
    ncpdq -a time,x,y $_ofile tmp.pico.nc
    mv tmp.pico.nc $_ofile
    echo "      ...done."
}

function iterative_coupling_ocean_pism_fesom2pism_names {
    _file=$1

    _oce_temp3D_varn="theta_ocean"
    _oce_temp3D_unit="$(get_units4pism_version ${_oce_temp3D_varn} ${VERSION_pism})"
    _oce_salt3D_varn="salinity_ocean"
    _oce_salt3D_unit="$(get_units4pism_version ${_oce_salt3D_varn} ${VERSION_pism})"
    _oce_temp2D_varn="shelfbtemp"
    _oce_temp2D_unit="$(get_units4pism_version ${_oce_temp2D_varn} ${VERSION_pism})"
    _oce_salt2D_varn="Ssurf"
    _oce_salt2D_unit="g kg-1"
    _oce_massflux_varn="shelfbmassflux"
    _oce_massflux_unit="$(get_units4pism_version ${_oce_massflux_varn} ${VERSION_pism})"
    _oce_heatflux_varn="shelfbheatflux"
    _oce_heatflux_unit="W m-2 s-1"

    # Maximal salinity of 474 g/kg : "Don Juan Pond", Antarctica
cat > ${_file:-cdo_partable.txt} <<EOFcdo
&parameter
name = temp
out_name = ${_oce_temp3D_varn}
units = "${_oce_temp3D_unit}"
long_name = "potential ocean temperature"
standard_name = potential_ocean_temperature

valid_min = -273
valid_max = 373
/

&parameter
name = salt
out_name = ${_oce_salt3D_varn}
units = "${_oce_salt3D_unit}"
long_name = "ocean salinity"
standard_name = ocean_salinity
valid_min = 0
valid_max = 474
/

&parameter
name = Tsurf
out_name = ${_oce_temp2D_varn}
units = "${_oce_temp2D_unit}"
long_name = "ice_shelf basal temperature"
standard_name = shelf_basal_temperature
valid_min = -273
valid_max = 373
/

&parameter
name = Ssurf
out_name = ${_oce_salt2D_varn}
units = "${_oce_salt2D_unit}"
long_name = "ice_shelf basal salinity"
standard_name = shelf_basal_salinity
valid_min = 0
valid_max = 474
/

&parameter
name = fw
out_name = ${_oce_massflux_varn}
units = "${_oce_massflux_unit}"
long_name = "shelf basal mass flux"
standard_name = shelf_basal_mass_flux
/

&parameter
name = fh
out_name = ${_oce_heatflux_varn}
units = "${_oce_heatflux_unit}"
long_name = "shelf basal heat flux"
standard_name = shelf_basal_heat_flux
/

&parameter
name = fld
out_name = z_base
units = "meter"
long_name = "depth of basal ice shelf"
valid_min = -10000
valid_max = 10000
/

EOFcdo

   unset _file
   unset _oce_temp3D_unit _oce_salt3D_unit _oce_temp2D_unit _oce_salt2D_unit
   unset _oce_massflux_unit _oce_heatflux_unit
}

#
# Regrid: Interpolation and extrapolation
#
function iterative_coupling_ocean_pism_regrid_interpolate {
    echo " *   Interpolate GCM forcing..."

    ierr=10
    for file in $GRIDDES_ICE ${ICE_COUPLE_DIR}/$GRIDDES_OCE ${ICE_COUPLE_DIR}/ocean_file_for_ice.nc ; do
	ierr=$(( ierr + 1 ))
	test_file_or_exit $file $ierr
    done

    test_file_or_exit ocean_file_for_ice.pism_names.nc 5
    build_weights4remap \
	${ICE_COUPLE_DIR}/ocean_file_for_ice.nc \
	${GRIDDES_ICE:?Missing variable}   \
	${WEIGHTS_OCE2ICE:?Missing variable} \
	${INTERPOL_TYPE_OCE:?Missing variable} \
	couple
    test_file_or_exit $WEIGHTS_OCE2ICE 6

    echo "     => remap,$GRIDDES_ICE,$WEIGHTS_OCE2ICE"
    $cdo remap,$GRIDDES_ICE,$WEIGHTS_OCE2ICE \
	ocean_file_for_ice.pism_names.nc \
	ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc

    cleanup_list="${cleanup_list}" # $(pwd)/ocean_file_for_ice.nc $(pwd)/ocean_file_for_ice.pism_names.nc"
}

function iterative_coupling_ocean_pism_regrid_extrapolate {
    #
    # This has to be called after the interpolation, because after the
    # interpolation we have landpoints that does not exist in the
    # FESOM ocean grid
    regrid_ocean_pism_extrapolate_misstoc=${regrid_ocean_pism_extrapolate_misstoc:-0}
    iterative_coupling_ocean_pism_regrid_extra_type=${iterative_coupling_ocean_pism_regrid_extra_type:-fillmiss2}
    echo " *   Extrapolate GCM forcing with method >>${iterative_coupling_ocean_pism_regrid_extra_type}<< ..."

    _cdo_flag=$( return_allowed_cdo_miss_replace_flags ${iterative_coupling_ocean_pism_regrid_extra_type} ${regrid_ocean_pism_extrapolate_misstoc} )

    _tmp_file=ocean_file_at_ice.${INTERPOL_TYPE_OCE}_before_extrapolation.nc
    mv ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${_tmp_file}

    $cdo $_cdo_flag ${_tmp_file} \
	ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc

    echo " ... done"
    cleanup_list="${cleanup_list} $(pwd)/${_tmp_file}"
    unset _cdo_flag _tmp_file
}

#
# Compute actual boundary conditions for ice sheet/shelf if wanted
#
function iterative_coupling_ocean_pism_compute_ocean_direct_forcing {
    _file=$1
    _action_string=": rename file"
    echo " *   Building direct ocean forcing (${PISM_OCEAN_SWITCH:-Unknown}) $_action_string -> $_file ..."
    mv -f ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})
    echo "     ...done."
}

function iterative_coupling_ocean_pism_compute_ocean_mixed_forcing {
    _file=$1
    _action_string=": Rescale basal melt and temperature with temperature and salt to basal melt and temperature"
    echo " *   Building mixed ocean forcing (${PISM_OCEAN_SWITCH:-Unknown}) $_action_string -> $_file ..."

    echo -e "CCR: \033[41m NOT YET IMPLEMENTED (A) \033[0m"
    echo " S T O P "; exit 1999
    cp ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})


    echo "     ...done."
}


function iterative_coupling_ocean_pism_compute_ocean_temp_forcing {
    _file=$1
    _action_string=": rename file"
    echo " *   Building ocean temperature-based forcing (${PISM_OCEAN_SWITCH:-Unknown}) $_action_string -> $_file ..."
    mv -f ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})
    # Nothing to do, since ocean forcing is already in the right format
    echo "     ...done."
}


function iterative_coupling_ocean_pism_compute_ocean_tempsalt_forcing {
    _file=$1
    if [ "x${OCEAN_DEPTH_MEAN}" == "xlegacy" ] ; then
        # old behaviour: plain mean over FESOM levels 1-20 on the ice grid,
        # the zeros below the sea floor included
        echo " *   Building ocean temperature/salinity forcing (${PISM_OCEAN_SWITCH:-Unknown}): legacy vertical mean (index 1-20) -> $_file ..."
        $cdo -vertmean -sellevidx,1/20 ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})
        echo "       ^ Note: Warnings about missing levels are commonly OK"
        cleanup_list="${cleanup_list} $(pwd)/ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc"
    else
        # The depth mean was already taken before the regridding
        # (iterative_coupling_ocean_pism_depth_mean), so only rename the file.
        echo " *   Building ocean temperature/salinity forcing (${PISM_OCEAN_SWITCH:-Unknown}): rename file -> $_file ..."
        mv -f ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})
    fi
    echo "     ...done."
}


function iterative_coupling_ocean_pism_compute_ocean_temp2flux_forcing {
    _file=$1
    _action_string=": temperature to basal melt and temperature"
    echo " *   Building ocean temperature->flux forcing (${PISM_OCEAN_SWITCH:-Unknown}) $_action_string -> $_file ..."

    echo -e "CCR: \033[41m NOT YET IMPLEMENTED (B) \033[0m"
    echo -e "CCR: \033[41m YOU may switch to NOT YET IMPLEMENTED 'TEMPSALT2FLUX' \033[0m"
    echo " S T O P "; exit 2999

    cp ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc ${ICE_COUPLE_DIR}/$(basename ${_file})

    echo "     ...done."
}

function iterative_coupling_ocean_pism_compute_ocean_tempsalt2flux_forcing {
    _file=$1
    _action_string=": temperature+salt to basal melt and temperature ($(basename $OCEAN_3EQN_ICE_FORCE_PY_SCRIPT))"
    echo " *   Building ocean temperature+salt->flux forcing (${PISM_OCEAN_SWITCH:-Unknown}) $_action_string -> $_file ..."


    test_file_or_exit ${INPUT_FILE_pism} 14

    case ${VERSION_pism:--0.1} in
	"0.7")
	    _upper_ice_temperature_varname="ice_surface_temp"
	    ;;
	"1.0"|"1.1")
	    _upper_ice_temperature_varname="ice_surface_temp"
	    ;;
	*)
	    echo "NOT DEFINED PISM version >${VERSION_pism}<"
	    echo "Please adjust function >iterative_coupling_ocean_pism_compute_ocean_tempsalt2flux_forcing< in 'coupling_ocean2pism.functions'"
	    echo " S T O P  15"
	    exit 15
	    ;;
    esac

    echo " ---------- starting $OCEAN_3EQN_ICE_FORCE_PY_SCRIPT -------------"
    _out_fname=${ICE_COUPLE_DIR}/$(basename $_file )
    _py_logging_file="hydrography2ism_ocean_forcing.log"
    echo "==> python $OCEAN_3EQN_ICE_FORCE_PY_SCRIPT --OCEAN_INPUT_FILE ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc --ISM_INPUT_FILE ${INPUT_FILE_pism} --OCEAN_TEMP_VARIABLE $_oce_temp3D_varn --OCEAN_SALT_VARIABLE $_oce_salt3D_varn --ISM_ICE_TEMP_VARIABLE $_upper_ice_temperature_varname --ISM_GRID_HEIGHT 0 --ISM_GRID_LENGTH 0 --OUT_CALC_FRONTAL_MELT False --OUT_CALC_LESS_BASAL_LOW_CAVITY False --LOGGING_OUTPUT_FILE ${_py_logging_file} --OUTPUT_FILE ${_out_fname} --LOGGING_OUTPUT_LEVEL INFO"

    echo "Python version:"
    python --version

    python $OCEAN_3EQN_ICE_FORCE_PY_SCRIPT \
	--OCEAN_INPUT_FILE ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc \
	--ISM_INPUT_FILE ${INPUT_FILE_pism}  \
	--OCEAN_TEMP_VARIABLE $_oce_temp3D_varn \
	--OCEAN_SALT_VARIABLE $_oce_salt3D_varn \
	--ISM_ICE_TEMP_VARIABLE $_upper_ice_temperature_varname \
	--ISM_GRID_HEIGHT 0 \
	--ISM_GRID_LENGTH 0 \
	--OUT_CALC_FRONTAL_MELT False \
	--OUT_CALC_LESS_BASAL_LOW_CAVITY False \
	--LOGGING_OUTPUT_FILE ${_py_logging_file} \
	--OUTPUT_FILE ${_output_filename}
# Standard
#	--OUT_CALC_BASAL_MELT True \
#	--OUT_CALC_BASAL_TEMP True \
#	--OUT_CALC_FRONTAL_MELT False \
#	--OUT_CALC_LESS_BASAL_LOW_CAVITY False \
#
# Plus frontal melting
#	--OUT_CALC_FRONTAL_MELT True
#	--OUT_CALC_MERGE_BASAL_FRONTAL_MELT True \

    echo " ---------- returned from $OCEAN_3EQN_ICE_FORCE_PY_SCRIPT --------"
    for MessageTag in WARNING ERROR CRITICAL ; do
	_nummer=$(grep ${MessageTag} ${_py_logging_file} | wc -l)
	if [ ${_nummer} -gt 0 ] ; then
	    echo "** Found $_nummer ${MessageTag}(s)"
	    grep ${MessageTag} ${_py_logging_file}
	fi
    done

    test_file_or_exit ${_out_fname} 15

    unset _upper_ice_temperature_varname _file _py_logging_file _nummer _out_fname
    echo "     ...done."
}

#
# Auxillary functions
#
function iterative_coupling_ocean_pism_set_options {
    echo ""; echo " *   set PISM setting for ocean forcing"
    pism_conf_file_list="${ICE_COUPLE_DIR}/pism_coupler_${CHUNK_DATE_TAG_pism}.dat ${ICE_COUPLE_DIR}/pism_forcing_${CHUNK_DATE_TAG_pism}.dat ${ICE_COUPLE_DIR}/pism_config_value_${CHUNK_DATE_TAG_pism}.dat"
    for pism_conf_file in $pism_conf_file_list; do
	if [ ! -f $pism_conf_file ]; then
	    :> $pism_conf_file
	fi
    done

    echo "$(pism_coupler_to_esm_runsscripts_syntax ${PISM_OCEAN_SWITCH[@]})" \
	>> ${ICE_COUPLE_DIR}/pism_coupler_${CHUNK_DATE_TAG_pism}.dat
    echo "$(pism_forcing_to_esm_runsscripts_syntax ${PISM_OCEAN_FILE_SWITCH[@]})" \
	>> ${ICE_COUPLE_DIR}/pism_forcing_${CHUNK_DATE_TAG_pism}.dat
}

function iterative_coupling_ocean_pism_regrid_set_time_axis {
    _file_name_add_timeaxis=$1
    echo ""; echo " *   setting time axis >>${_file_name_add_timeaxis}<<"
    _script2build_time_axis=${FUNCTION_PATH}/../utils/CreateTimeAxisNC.bash

    test_file_or_exit ${_file_name_add_timeaxis} 8
    # Number of timesteps in file
    _nt=$( ${cdo} -s ntime ${_file_name_add_timeaxis} )

    if [ $_nt -lt 1 ]; then
	echo " -   No time step (continue without adjusting the time axis)"
    else
	__file_taxis=time_axis.steps$(printf '%05i' ${_nt}).nc

	test -f ${__file_taxis} && rm ${__file_taxis}
	if [ ! -f ${__file_taxis} ] ; then
	    if [ ! -f ${_script2build_time_axis} ] ; then
		echo "     - Missing ${_script2build_time_axis}"
		echo " S T O P   9  (coupling_ocean2pism.functions::iterative_coupling_ocean_pism_regrid_set_time_axis)"
		exit 9
	    else
		echo "     - Use $_script2build_time_axis to determine continious time axis"
		#${_script2build_time_axis} ${_nt} ${__file_taxis}
		#${_script2build_time_axis} ${_nt} ${__file_taxis} 0 classic 360 double
		${_script2build_time_axis} ${_nt} ${__file_taxis} 0 classic 365 float
	    fi
	else
	    echo "     - Reuse time axis file ${__file_taxis}"
	fi

        ncks -A ${__file_taxis} ${_file_name_add_timeaxis}
    fi

    unset _file_name_add_timeaxis __file_taxis
}

function iterative_coupling_ocean_pism_fesom2pism_collapse_time {
    # NOTE: Could be called at any time (also before regridding and
    # reshuffling data with pyfesom script), because the time axis is
    # well defined regardless of representation of ocean data as a
    # array or 3dim field.
    _file_time=$1
    echo ""; echo " *   collapse time axis/dimension of >>${_file_time}<<"


    test_file_or_exit ${_file_time:?Missing file name to collapse time dimension} 12

    if [ 1 -eq 1 ] ; then
	_tmp_file=${_file_time}_before_timmean.nc
	mv -f ${_file_time} ${_tmp_file}
	$cdo timmean        ${_tmp_file} ${_file_time}
    else
	# Does not work. Why? I do not know
	_tmp_file=${_file_time}_before_ncwa.nc
	mv -f ${_file_time} ${_tmp_file}
	ncwa -a time        ${_tmp_file} ${_file_time}
    fi

    cleanup_list="${cleanup_list} $(pwd)/${_tmp_file}"

    unset _file_time _tmp_file
}


## @fn iterative_coupling_ocean_pism_depth_mean_method()
## Sets OCEAN_DEPTH_MEAN (runscript key ocean_depth_mean) to "wet", "bottom"
## or "legacy", see iterative_coupling_ocean_pism_depth_mean. Unset: "legacy"
## when ocean anomaly forcing is on, because its BASE_STATE_OCEAN_FNAME was
## made with the old mean and only the same mean cancels its errors; else
## "wet". Anything else stops with exit 17.
function iterative_coupling_ocean_pism_depth_mean_method {
    if [ -z "${OCEAN_DEPTH_MEAN}" ] ; then
        if [ "x${ANOMALY_OCEAN_TEMPERATURE:-0}" == "x1" ] || [ "x${ANOMALY_OCEAN_SALINITY:-0}" == "x1" ] ; then
            OCEAN_DEPTH_MEAN=legacy
            echo " * ocean_depth_mean not set and ocean anomaly forcing is on -> legacy"
            echo "   (the base state has to be made with the same depth mean; set"
            echo "    ocean_depth_mean: wet once BASE_STATE_OCEAN_FNAME is made with it)"
        else
            OCEAN_DEPTH_MEAN=wet
        fi
    fi
    case ${OCEAN_DEPTH_MEAN} in
        wet)
            echo " * ocean_depth_mean = wet (${OCEAN_DEPTH_TOP:-0}-${OCEAN_DEPTH_BOTTOM:-410} m, thickness-weighted, sea floor left out)"
            ;;
        bottom)
            echo " * ocean_depth_mean = bottom (deepest wet level down to ${OCEAN_DEPTH_BOTTOM:-410} m)"
            ;;
        legacy)
            echo " * ocean_depth_mean = legacy (FESOM levels 1-20, zeros below the sea floor included)"
            if [ -n "${OCEAN_DEPTH_TOP}${OCEAN_DEPTH_BOTTOM}" ] ; then
                echo "   ! ocean_depth_top / ocean_depth_bottom are ignored with legacy"
            fi
            ;;
        *)
            echo " !!! ocean_depth_mean = >${OCEAN_DEPTH_MEAN}<: only wet, bottom or legacy"
            echo " S T O P  17"
            exit 17
            ;;
    esac
}

## @fn iterative_coupling_ocean_pism_depth_mean()
## Call: iterative_coupling_ocean_pism_depth_mean FILE
## Reduces the 3D ocean temperature and salinity in FILE (ocean grid, PISM
## names) to one layer, in place. FESOM writes T = S = 0 below the sea floor;
## these points are set to missing (wet = salinity > 0) and never used. Before,
## they were averaged in and pulled the shelf salinity far down
## (CHANGES-vs-REFERENCE.md); that mean is still available as
## ocean_depth_mean: legacy. Depths are metres below sea level; the levels
## have to run from the surface down, as in FESOM.
##
## OCEAN_DEPTH_MEAN (runscript key ocean_depth_mean):
##   wet     mean over the water from OCEAN_DEPTH_TOP to OCEAN_DEPTH_BOTTOM
##           (both ends included; defaults 0 and 410 m = FESOM levels 1-20),
##           each level weighted by the thickness of water it stands for:
##           the layer between the midpoints to its neighbours, cut to the
##           range. (Equal weights gave the levels at 0, 5 and 10 m as much
##           say as those 70 m apart further down.) Where the sea floor is
##           shallower than OCEAN_DEPTH_TOP, so that no level of the range is
##           wet, the deepest wet level is used.
##   bottom  the deepest wet level not deeper than OCEAN_DEPTH_BOTTOM: the
##           water at the sea floor on the shelf, the water at
##           OCEAN_DEPTH_BOTTOM in deeper ocean. PICO is calibrated with
##           bottom water on the continental shelf. OCEAN_DEPTH_TOP is not
##           used.
##
## Stops (exit 16) if no level lies in the depth range.
function iterative_coupling_ocean_pism_depth_mean {
    typeset _file=$1
    typeset _mode=${OCEAN_DEPTH_MEAN:-wet}
    typeset _top=${OCEAN_DEPTH_TOP:-0} _bot=${OCEAN_DEPTH_BOTTOM:-410}
    typeset _levels _weights _in_range _above _upto _iw _i _w _var
    if [ "x${_mode}" == "xbottom" ] ; then
        echo ""; echo " *   bottom water (deepest wet level down to ${_bot} m) of temperature and salinity >>${_file}<<"
    else
        echo ""; echo " *   thickness-weighted mean ${_top}-${_bot} m of temperature and salinity >>${_file}<<"
    fi
    test_file_or_exit ${_file} 13

    # Level numbers (1 = first level). Level values are negative in some
    # files and positive in others, so compare |depth|.
    #   _weights  "i:w" for the levels in the range, w = metres of water
    #   _above    levels shallower than the range (wet fallback)
    #   _upto     levels down to the bottom of the range (bottom mode)
    _levels=$($cdo -s showlevel -selvar,salinity_ocean ${_file})
    _weights=$(echo ${_levels} | awk -v top=${_top} -v bot=${_bot} '{
        n = NF
        for (i = 1; i <= n; i++) d[i] = ($i < 0) ? -$i : $i
        for (i = 1; i <= n; i++) {
            if (d[i] < top || d[i] > bot) continue
            ub = (i == 1) ? d[1] : (d[i-1] + d[i]) / 2
            lb = (i == n) ? d[n] : (d[i] + d[i+1]) / 2
            if (ub < top) ub = top
            if (lb > bot) lb = bot
            w = lb - ub
            if (w <= 0) w = 1e-3      # a range that is a single level
            s = s " " i ":" w
        }
        print s }')
    _in_range=$(echo ${_weights} | tr ' ' '\n' | cut -d: -f1 | paste -sd, -)
    _above=$(echo ${_levels} | awk -v top=${_top} '{
        for (i = 1; i <= NF; i++) { d = ($i < 0) ? -$i : $i
            if (d < top) s = s " " i }
        print s }')
    _upto=$(echo ${_levels} | awk -v bot=${_bot} '{
        for (i = 1; i <= NF; i++) { d = ($i < 0) ? -$i : $i
            if (d <= bot) s = s " " i }
        print s }')
    if [ -z "${_in_range}" ] ; then
        echo " !!! no ocean level between ${_top} and ${_bot} m; levels: ${_levels}"
        echo " S T O P  16"
        exit 16
    fi

    # wet mask: 1 in the water, missing below the sea floor
    $cdo -s -O setctomiss,0 -gtc,0 -selvar,salinity_ocean ${_file} ocean_wet.nc

    if [ "x${_mode}" != "xbottom" ] ; then
        echo "     - levels:weights (m) in the range:${_weights}"
        # 1 where at least one level of the range is wet, 0 where the sea floor is above it
        $cdo -s -O setmisstoc,0 -vertmax -sellevidx,${_in_range} ocean_wet.nc ocean_wet_in_range.nc
        # metres of water in the range (denominator of the mean)
        _iw=0
        for _w in ${_weights} ; do
            _i=${_w%%:*}; _w=${_w#*:}
            $cdo -s -O mulc,${_w} -setmisstoc,0 -setlevel,0 -sellevidx,${_i} ocean_wet.nc ocean_wet_w.nc
            if [ ${_iw} -eq 0 ] ; then mv -f ocean_wet_w.nc ocean_wet_sum.nc
            else $cdo -s -O add ocean_wet_sum.nc ocean_wet_w.nc ocean_wet_tmp.nc; mv -f ocean_wet_tmp.nc ocean_wet_sum.nc
            fi
            _iw=$((_iw + 1))
        done
    fi

    for _var in theta_ocean salinity_ocean ; do
        $cdo -s -O ifthen ocean_wet.nc -selvar,${_var} ${_file} ${_var}_wet.nc

        if [ "x${_mode}" == "xbottom" ] ; then
            # start at the top level, walk down to the bottom of the range and
            # keep each wet value, so the deepest wet one is left
            $cdo -s -O setlevel,0 -sellevidx,1 ${_var}_wet.nc ${_var}_layer.nc
            for _i in ${_upto} ; do
                $cdo -s -O ifthenelse -setmisstoc,0 -setlevel,0 -sellevidx,${_i} ocean_wet.nc \
                    -setlevel,0 -sellevidx,${_i} ${_var}_wet.nc ${_var}_layer.nc ${_var}_tmp.nc
                mv -f ${_var}_tmp.nc ${_var}_layer.nc
            done
            continue
        fi

        # thickness-weighted mean over the wet levels of the range
        _iw=0
        for _w in ${_weights} ; do
            _i=${_w%%:*}; _w=${_w#*:}
            $cdo -s -O mulc,${_w} -setmisstoc,0 -setlevel,0 -sellevidx,${_i} ${_var}_wet.nc ${_var}_w.nc
            if [ ${_iw} -eq 0 ] ; then mv -f ${_var}_w.nc ${_var}_sum.nc
            else $cdo -s -O add ${_var}_sum.nc ${_var}_w.nc ${_var}_tmp.nc; mv -f ${_var}_tmp.nc ${_var}_sum.nc
            fi
            _iw=$((_iw + 1))
        done
        # dividing by 0 m of water (sea floor above the range) gives missing
        $cdo -s -O setname,${_var} -div ${_var}_sum.nc ocean_wet_sum.nc ${_var}_layer.nc

        # sea floor above the range: start at the top level, walk down the
        # levels above the range and keep each wet value, so the deepest wet
        # one is left; use it where the range is dry
        if [ -n "${_above}" ] ; then
            $cdo -s -O setlevel,0 -sellevidx,1 ${_var}_wet.nc ${_var}_bottom.nc
            for _i in ${_above} ; do
                $cdo -s -O ifthenelse -setmisstoc,0 -setlevel,0 -sellevidx,${_i} ocean_wet.nc \
                    -setlevel,0 -sellevidx,${_i} ${_var}_wet.nc ${_var}_bottom.nc ${_var}_tmp.nc
                mv -f ${_var}_tmp.nc ${_var}_bottom.nc
            done
            $cdo -s -O ifthenelse ocean_wet_in_range.nc ${_var}_layer.nc ${_var}_bottom.nc ${_var}_tmp.nc
            mv -f ${_var}_tmp.nc ${_var}_layer.nc
        fi
    done

    $cdo -s -O merge theta_ocean_layer.nc salinity_ocean_layer.nc ${_file}
    for _var in theta_ocean salinity_ocean ; do
        cleanup_list="${cleanup_list} $(pwd)/${_var}_wet.nc $(pwd)/${_var}_layer.nc $(pwd)/${_var}_bottom.nc"
        cleanup_list="${cleanup_list} $(pwd)/${_var}_sum.nc $(pwd)/${_var}_w.nc"
    done
    cleanup_list="${cleanup_list} $(pwd)/ocean_wet.nc $(pwd)/ocean_wet_in_range.nc"
    cleanup_list="${cleanup_list} $(pwd)/ocean_wet_sum.nc $(pwd)/ocean_wet_w.nc"
}

## @fn ic_oce2pism_anomaly()
## Call: ic_oce2pism_anomaly VAR [MIN]
## Ocean anomaly forcing (ported from coupling_dual-hemisphere) on this
## domain's ${PISM_OCEAN_FORCING_FILE}:
##
##     VAR = reference + (forcing - base state)      [clipped at MIN if given]
##
## i.e. the change of the ocean model since its base state, added to a
## reference ocean. REFERENCE_OCEAN_FNAME and BASE_STATE_OCEAN_FNAME are set
## in the ice domain's runscript section; both use the PISM names
## (theta_ocean [degC], salinity_ocean [g/kg]) on this domain's grid.
## Temperature is not clipped, salinity at 0. Stops (exit 2) if a file is
## missing or the result could not be written.
ic_oce2pism_anomaly() {
    typeset _var=$1 _min=$2 _f
    typeset _raw=${PISM_OCEAN_FORCING_FILE}.no_anomaly.nc
    echo ""; echo -e "\t\t*   ocean anomaly forcing for ${_var}"
    for _f in "${REFERENCE_OCEAN_FNAME}" "${BASE_STATE_OCEAN_FNAME}" "${PISM_OCEAN_FORCING_FILE}" ; do
        if [ -z "${_f}" ] || [ ! -f "${_f}" ] ; then
            echo " !!! ocean anomaly forcing: missing file >${_f}<"
            echo " !!! (REFERENCE_OCEAN_FNAME and BASE_STATE_OCEAN_FNAME have to be set"
            echo " !!!  in the ice domain's runscript section)"
            echo " S T O P  2"
            exit 2
        fi
    done

    mv ${PISM_OCEAN_FORCING_FILE} ${_raw}
    cdo -s -O -setvar,${_var} ${_min:+-maxc,${_min}} \
        -add -selvar,${_var} ${REFERENCE_OCEAN_FNAME} \
        -sub -selvar,${_var} ${_raw} \
             -selvar,${_var} ${BASE_STATE_OCEAN_FNAME} \
        ${PISM_OCEAN_FORCING_FILE}
    # every other variable of the forcing file unchanged
    ncks -A -x -v ${_var} ${_raw} ${PISM_OCEAN_FORCING_FILE}
    if [ ! -s ${PISM_OCEAN_FORCING_FILE} ] ; then
        echo " !!! ocean anomaly forcing for ${_var} failed: no ${PISM_OCEAN_FORCING_FILE}"
        echo " S T O P  2"
        exit 2
    fi
    rm -f ${_raw}
}

# -- last line
