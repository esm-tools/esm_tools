  <field_group id="3D_pv" grid_ref="reduced_pv" freq_op="{{ oifs.output_step_freq }}ts" >
    <field id="pt_pv"     long_name="potential temperature" standard_name="air_potential_temperature"                                     unit="K" />
    <!-- WARNING: FullPos doesn't process 'mont', don't use it -->
    <field id="mont_pv"   long_name="Montgomery geopotential"                                                                             unit="m2 s-2" />
    <field id="pres_pv"   long_name="pressure"                                  standard_name="air_pressure"                              unit="Pa" />
    <field id="crwc_pv"   long_name="precipitation rain water specific content" standard_name="precipitation_rain_water_specific_content" unit="kg*kg-1" />
    <field id="cswc_pv"   long_name="precipitation snow water specific content" standard_name="precipitation_snow_water_specific_content" unit="kg*kg-1" />
    <field id="etadot_pv" long_name="eta-coordinate vertical velocity"                                                                    unit="s-1" />
    <field id="z_pv"      long_name="geopotential"                              standard_name="geopotential"                              unit="m2 s-2" />
    <field id="t_pv"      long_name="temperature"                               standard_name="air_temperature"                           unit="K" />
    <field id="u_pv"      long_name="u-component of wind"                       standard_name="eastward_wind"                             unit="m s-1" />
    <field id="v_pv"      long_name="v-component of wind"                       standard_name="northward_wind"                            unit="m s-1" />
    <field id="q_pv"      long_name="specific humidity"                         standard_name="specific_humidity"                         unit="kg*kg-1" />
    <field id="w_pv"      long_name="vertical velocity"                         standard_name="tendency_of_air_pressure"                  unit="m s-1" />
    <field id="vo_pv"     long_name="relative vorticity"                        standard_name="atmosphere_relative_vorticity"             unit="s-1" />
