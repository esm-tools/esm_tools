! namelist.io.recom_all: namelist.io.recom_mon with every REcoM output stream of fesom-2.8 (monthly).
! namelist.io.recom: namelist.io with the REcoM output streams added. Used instead of namelist.io
! when the ocean carbon cycle is coupled (awiesm3: general.with_co2_oce_coupling). Keep the two
! files identical apart from the REcoM block in io_list, so that a carbon-cycle run writes
! everything the physics-only run writes.
! ============================================================================
! ============ Namelist file for FESOM2 output configuration =================
! ============================================================================
! This file contains configuration for model output and diagnostics:
! - Diagnostic flags for optional output fields
! - General output settings (compression, rotation)
! - Output variable list with frequency and precision
! - Complete catalog of all available output fields
!
! See the output catalog at the end of this file for all possible variables.
! Some outputs require specific flags in &diag_list or other namelists.
! ============================================================================

! ============================================================================
! DIAGNOSTIC FLAGS
! ============================================================================
! Enable/disable optional diagnostic computations and outputs.
! Setting these to .true. enables additional output fields (see catalog below).
! ============================================================================
&diag_list
ldiag_solver      = .false.  ! enables solver diagnostics (convergence, iterations)
lcurt_stress_surf = .false.  ! enables 'curl_surf' output (vorticity of surface stress)
ldiag_curl_vel3   = .false.  ! enables 'curl_u' output (relative vorticity from 3D velocity)
ldiag_Ri          = .false.  ! enables Richardson number diagnostics ('shear', 'Ri')
ldiag_turbflux    = .false.  ! enables turbulent flux diagnostics ('KvdTdz', 'KvdSdz')
ldiag_salt3D      = .false.  ! enables 3D salinity diagnostics
ldiag_dMOC        = .true.  ! enables 'dMOC' output (density MOC diagnostics)
dmoc_call_freq      = 1     ! call dMOC diagnostic every N units (default 1)
dmoc_call_freq_unit = 's'   ! unit: 's'=steps, 'h'=hours, 'd'=days, 'm'=months
ldiag_DVD         = .false.  ! enables 'DVD' output (Discrete Variance Decay diagnostics)
ldiag_forc        = .false.  ! enables 'FORC' output (comprehensive forcing diagnostics)
ldiag_extflds     = .false.  ! enables extended field diagnostics
ldiag_destine     = .false.  ! enables heat content computation ('hc300m', 'hc700m', 'hc')
ldiag_trflx       = .true.   ! enables tracer flux diagnostics ('utemp', 'vtemp', 'usalt', 'vsalt')
ldiag_uvw_sqr     = .false.  ! enables 'UVW_SQR' output (squared velocities: u2, v2, w2)
ldiag_trgrd_xyz   = .false.  ! enables 'TRGRD_XYZ' output (horizontal & vertical tracer gradients)
ldiag_cmor        = .true.  ! enables CMOR diagnostics for CMIP6/CMIP7 ('tos', 'sos', 'pbo', 'volo', etc.)
/

! ============================================================================
! GENERAL OUTPUT SETTINGS
! ============================================================================
&nml_general
io_listsize       = 200      ! 150      ! total number of streams to allocate. Shall be larger or equal to the number of streams in &nml_list (max. 150)
vec_autorotate    = .true.   ! unrotate vector fields (velocities, winds) before writing to output files
compression_level = 1        ! compression level for netCDF output (1=fastest, 9=smallest)
/

! ============================================================================
! OUTPUT VARIABLE LIST
! ============================================================================
! Format: 'variable_id', frequency, unit, precision
!   frequency  = output frequency (integer)
!   unit       = 'y' (yearly), 'm' (monthly), 'd' (daily), 'h' (hourly), 's' (steps)
!   precision  = 4 (single precision) or 8 (double precision)
! ============================================================================
&nml_list
! --- Daily output (variables needed at daily AND monthly frequency) ---
! Monthly pycmor rules will use timeavg to downsample from daily data.
! FESOM2 can only output one frequency per variable.
io_list =  'sst       ',1, 'm', 4,
           'sss       ',1, 'm', 4,
           'ssh       ',1, 'm', 4,
           'uice      ',1, 'm', 4,
           'vice      ',1, 'm', 4,
           'a_ice     ',1, 'm', 4,
           'm_snow    ',1, 'm', 4,
           'ist       ',1, 'm', 4,
           'MLD3      ',1, 'm', 4,
           'unod      ',1, 'm', 4,
           'vnod      ',1, 'm', 4,
           'm_ice     ',1, 'm', 4,
           'h_ice     ',1, 'm', 4,
           'h_snow    ',1, 'm', 4,
           'MLD1      ',1, 'm', 4,
           'MLD2      ',1, 'm', 4,
           'tx_sur    ',1, 'm', 4,
           'ty_sur    ',1, 'm', 4,
           'temp      ',1, 'm', 4,
           'salt      ',1, 'm', 8,
           'N2        ',1, 'm', 4,
           'Kv        ',1, 'm', 4,
           'u         ',1, 'm', 4,
           'v         ',1, 'm', 4,
           'w         ',1, 'm', 4,
           'hnode     ',1, 'm', 4,
           'Av        ',1, 'm', 4,
           'bolus_u   ',1, 'm', 4,
           'bolus_v   ',1, 'm', 4,
           'bolus_w   ',1, 'm', 4,
           'fw        ',1, 'm', 4,
           'fh        ',1, 'm', 4,
           'otracers  ',1, 'm', 4,  ! tracers after T and S
                                    ! -> without REcoM and with use_transit=.true. -> transit tracers sf6, cfc11, cfc12, r14c, r39ar
                                    ! -> with REcoM: BGC tracers DIN ... Zoo3C -> see REcoM block below
                                    ! -> any other passive tracer of namelist.tra as tra_<ID>
           'thdgrarea ',1, 'm', 4,
           'dyngrarea ',1, 'm', 4,
           'thdgrice  ',1, 'm', 4,
           'dyngrice  ',1, 'm', 4,
           'thdgrsnw  ',1, 'm', 4,
!          'strength_ice',1, 'm', 4,  ! disabled: dead under which_ale='linfs' (ice_EVP.F90 ice_strength block is gated off); re-enable for non-linfs runs
           'atmice_x  ',1, 'm', 4,
           'atmice_y  ',1, 'm', 4,
           'iceoce_x  ',1, 'm', 4,
           'iceoce_y  ',1, 'm', 4,
           'fw_ice    ',1, 'm', 4,
           'fw_snw    ',1, 'm', 4,
           'virtsalt  ',1, 'm', 4,
!          'realsalt  ',1, 'm', 4,  ! disabled: dead under which_ale='linfs' (use_virt_salt=.true., real-salt branch in ice_thermo_cpl.F90 unreachable); re-enable for non-linfs runs
           'qcon      ',1, 'm', 4,
           'alb       ',1, 'm', 4,
           'apnd      ',1, 'm', 4,
           'hpnd      ',1, 'm', 4,
           'ipnd      ',1, 'm', 4,
           'evap      ',1, 'm', 4,
           'prec      ',1, 'm', 4,
           'snow      ',1, 'm', 4,
           'runoff    ',1, 'm', 4,
!          'relaxsalt ',1, 'm', 4,  ! disabled: legitimately ~0 in coupled runs (no SSS restoring); re-enable for stand-alone runs
           'sgm11     ',1, 'm', 4,
           'sgm12     ',1, 'm', 4,
           'sgm22     ',1, 'm', 4,
           'osalttend ',1, 'm', 8,
           'opottemprmadvect',1, 'm', 8,
           'opottempdiff',1, 'm', 8,
           'osaltrmadvect',1, 'm', 8,
           'osaltdiff ',1, 'm', 8,
           'rsdoabsorb',1, 'm', 4,
           'utemp     ',1, 'm', 4,
           'vtemp     ',1, 'm', 4,
           'icb       ',1, 'm', 4,
! --- REcoM: Need use_REcoM, __recom and diags=.true. (namelist.recom). 
! BGC tracers DIN ... Zoo3C are written through 'otracers'
! - 2D surface and fluxes
           'xCO2atm   ',1, 'm', 4,  ! [2D] atmospheric CO2 [ppm]
           'dpCO2s    ',1, 'm', 4,  ! [2D] ocean minus atmosphere pCO2 [uatm]
           'pCO2s     ',1, 'm', 4,  ! [2D] surface ocean pCO2 [uatm]
           'CO2f      ',1, 'm', 4,  ! [2D] air-to-sea CO2 flux [mmolC/m2/d]
           'O2f       ',1, 'm', 4,  ! [2D] air-to-sea O2 flux [mmolO/m2/d]
           'Hp        ',1, 'm', 4,  ! [2D] surface H+ [mol/kg]
           'aFe       ',1, 'm', 4,  ! [2D] atmospheric Fe input [umolFe/m2/s]
           'aN        ',1, 'm', 4,  ! [2D] atmospheric DIN input [mmolN/m2/s]
           'benN      ',1, 'm', 8,  ! [2D] benthic N [mmol/m2]
           'benC      ',1, 'm', 8,  ! [2D] benthic C [mmol/m2]
           'benSi     ',1, 'm', 8,  ! [2D] benthic Si [mmol/m2]
           'benCalc   ',1, 'm', 8,  ! [2D] benthic calcite [mmol/m2]
! - 2D depth-integrated production (diatoms d, small phytoplankton n)
           'NPPn      ',1, 'm', 4,  ! [2D] NPP small phytoplankton [mmolC/m2/d]
           'NPPd      ',1, 'm', 4,  ! [2D] NPP diatoms [mmolC/m2/d]
           'GPPn      ',1, 'm', 4,  ! [2D] GPP small phytoplankton [mmolC/m2/d]
           'GPPd      ',1, 'm', 4,  ! [2D] GPP diatoms [mmolC/m2/d]
           'NNAn      ',1, 'm', 4,  ! [2D] net N assimilation small phytoplankton [mmolN/m2/d]
           'NNAd      ',1, 'm', 4,  ! [2D] net N assimilation diatoms [mmolN/m2/d]
           'Chldegn   ',1, 'm', 4,  ! [2D] Chl degradation small phytoplankton [1/d]
           'Chldegd   ',1, 'm', 4,  ! [2D] Chl degradation diatoms [1/d]
! - 3D rates
           'PAR       ',1, 'm', 4,  ! [3D] PAR [W/m2]
           'respmeso  ',1, 'm', 4,  ! [3D] mesozooplankton respiration
           'respmacro ',1, 'm', 4,  ! [3D] macrozooplankton respiration
           'respmicro ',1, 'm', 4,  ! [3D] microzooplankton respiration
           'calcdiss  ',1, 'm', 4,  ! [3D] calcite dissolution
           'calcif    ',1, 'm', 4,  ! [3D] calcification
           'aggn      ',1, 'm', 4,  ! [3D] aggregation small phytoplankton
           'aggd      ',1, 'm', 4,  ! [3D] aggregation diatoms
           'docexn    ',1, 'm', 4,  ! [3D] DOC excretion small phytoplankton
           'docexd    ',1, 'm', 4,  ! [3D] DOC excretion diatoms
           'respn     ',1, 'm', 4,  ! [3D] respiration small phytoplankton
           'respd     ',1, 'm', 4,  ! [3D] respiration diatoms
           'NPPn3D    ',1, 'm', 4,  ! [3D] NPP small phytoplankton [mmolC/m3/d]
           'NPPd3D    ',1, 'm', 4,  ! [3D] NPP diatoms [mmolC/m3/d]
! - 3D carbonate system (mocsy)
           'CO2_aq    ',1, 'm', 4,  ! [3D] aqueous CO2 [mol/m3]
           'pH        ',1, 'm', 4,  ! [3D] pH total scale
           'pCO2      ',1, 'm', 4,  ! [3D] pCO2 [uatm]
           'HCO3      ',1, 'm', 4,  ! [3D] bicarbonate [mol/m3]
           'CO3       ',1, 'm', 4,  ! [3D] carbonate [mol/m3]
           'OmegaC    ',1, 'm', 4,  ! [3D] calcite saturation state
! - 3D photosynthesis limitation terms [1/d]
           'TPhyCO2   ',1, 'm', 4,  ! [3D]
           'TDiaCO2   ',1, 'm', 4,  ! [3D]
           'TCphotLL_phyto',1, 'm', 4,  ! [3D]
           'TCphotLL_dia',1, 'm', 4,  ! [3D]
           'TCphot_phyto',1, 'm', 4,  ! [3D]
           'TCphot_diatoms',1, 'm', 4,  ! [3D]
!   flux into the benthos (froc, fric, exp*ob, frn)
           'bflxN     ',1, 'm', 4,  ! [2D] particulate organic N into the benthos [mmolN/m2/s]
           'bflxC     ',1, 'm', 4,  ! [2D] particulate organic C into the benthos [mmolC/m2/s]
           'bflxSi    ',1, 'm', 4,  ! [2D] biogenic silica into the benthos [mmolSi/m2/s]
           'bflxCalc  ',1, 'm', 4,  ! [2D] calcite into the benthos [mmolC/m2/s]
!   sinking fluxes at the layer interfaces, positive down (expc, expcalc, epn, epsi)
           'expN      ',1, 'm', 4,  ! [3D, layer interfaces] particulate organic N [mmolN/m2/s]
           'expC      ',1, 'm', 4,  ! [3D, layer interfaces] particulate organic C [mmolC/m2/s]
           'expSi     ',1, 'm', 4,  ! [3D, layer interfaces] biogenic silica [mmolSi/m2/s]
           'expCalc   ',1, 'm', 4,  ! [3D, layer interfaces] calcite [mmolC/m2/s]
!   rates (graz, intpbsi, frfe)
           'graz      ',1, 'm', 4,  ! [3D] grazing on phytoplankton by all zooplankton [mmolC/m3/d] (needs grazing_detritus)
           'intpbsi   ',1, 'm', 4,  ! [2D] depth-integrated Si uptake by diatoms [mmolSi/m2/d]
           'scavFe    ',1, 'm', 4,  ! [2D] depth-integrated Fe scavenging [umolFe/m2/d]
!   limitation of photosynthesis (limn*, limfe*; light: TCphotLL_* above)
           'limNn     ',1, 'm', 4,  ! [3D] N limitation small phytoplankton [1]
           'limFen    ',1, 'm', 4,  ! [3D] Fe limitation small phytoplankton [1]
           'limNd     ',1, 'm', 4,  ! [3D] N limitation diatoms [1]
           'limFed    ',1, 'm', 4,  ! [3D] Fe limitation diatoms [1]
!   oxygen and carbonate system (o2sat, dpo2, o2min, co3satarag)
           'O2sat     ',1, 'm', 4,  ! [3D] O2 at saturation, 1 atm moist air [mmolO/m3]
           'dpO2s     ',1, 'm', 4,  ! [2D] surface pO2 ocean minus atmosphere [Pa]
           'O2min     ',1, 'm', 4,  ! [2D] O2 at the shallowest local minimum [mmolO/m3]
           'OmegaA    ',1, 'm', 4,  ! [3D] aragonite saturation state
           'CO3satA   ',1, 'm', 4,  ! [3D] carbonate ion at aragonite saturation [mol/m3]
!   column inventories (intdic, intdoc, intpoc)
           'intDIC    ',1, 'm', 4,  ! [2D] DIC [mmolC/m2]
           'intDOC    ',1, 'm', 4,  ! [2D] DOC [mmolC/m2]
           'intPOC    ',1, 'm', 4,  ! [2D] phytoplankton + zooplankton + detritus C [mmolC/m2]
! - only filled with enable_coccos=.true. (coccolithophores c, phaeocystis p); zeros otherwise
!          'NPPc      ',1, 'm', 4,  ! [2D] NPP coccolithophores [mmolC/m2/d]
!          'GPPc      ',1, 'm', 4,  ! [2D] GPP coccolithophores [mmolC/m2/d]
!          'NNAc      ',1, 'm', 4,  ! [2D] net N assimilation coccolithophores [mmolN/m2/d]
!          'Chldegc   ',1, 'm', 4,  ! [2D] Chl degradation coccolithophores [1/d]
!          'NPPp      ',1, 'm', 4,  ! [2D] NPP phaeocystis [mmolC/m2/d]
!          'GPPp      ',1, 'm', 4,  ! [2D] GPP phaeocystis [mmolC/m2/d]
!          'NNAp      ',1, 'm', 4,  ! [2D] net N assimilation phaeocystis [mmolN/m2/d]
!          'Chldegp   ',1, 'm', 4,  ! [2D] Chl degradation phaeocystis [1/d]
!          'aggc      ',1, 'm', 4,  ! [3D] aggregation coccolithophores
!          'aggp      ',1, 'm', 4,  ! [3D] aggregation phaeocystis
!          'docexc    ',1, 'm', 4,  ! [3D] DOC excretion coccolithophores
!          'docexp    ',1, 'm', 4,  ! [3D] DOC excretion phaeocystis
!          'respc     ',1, 'm', 4,  ! [3D] respiration coccolithophores
!          'respp     ',1, 'm', 4,  ! [3D] respiration phaeocystis
!          'NPPc3D    ',1, 'm', 4,  ! [3D] NPP coccolithophores [mmolC/m3/d]
!          'NPPp3D    ',1, 'm', 4,  ! [3D] NPP phaeocystis [mmolC/m3/d]
!          'TTemp_cocco',1, 'm', 4,  ! [3D] temperature dependence coccolithophores
!          'TTemp_phaeo',1, 'm', 4,  ! [3D] temperature dependence phaeocystis
!          'TCoccoCO2 ',1, 'm', 4,  ! [3D] CO2 effect coccolithophores
!          'TPhaeoCO2 ',1, 'm', 4,  ! [3D] CO2 effect phaeocystis
!          'TqLF_cocco',1, 'm', 4,  ! [3D] nutrient limitation coccolithophores
!          'TqLF_phaeo',1, 'm', 4,  ! [3D] nutrient limitation phaeocystis
!          'TCphotLL_cocco',1, 'm', 4,  ! [3D] light limitation coccolithophores
!          'TCphotLL_phaeo',1, 'm', 4,  ! [3D] light limitation phaeocystis
!          'TCphot_cocco',1, 'm', 4,  ! [3D] photosynthesis rate coccolithophores
!          'TCphot_phaeo',1, 'm', 4,  ! [3D] photosynthesis rate phaeocystis
!          'TTemp_phyto',1, 'm', 4,  ! [3D] temperature dependence small phytoplankton
!          'TTemp_diatoms',1, 'm', 4,  ! [3D] temperature dependence diatoms
!          'TqLF_phyto',1, 'm', 4,  ! [3D] nutrient limitation small phytoplankton
!          'TqLF_diatoms',1, 'm', 4,  ! [3D] nutrient limitation diatoms
!          'TSi_assimDia',1, 'm', 4,  ! [3D] Si assimilation diatoms
! - only with ciso=.true.
!          'benC_13   ',1, 'm', 8,  ! [2D] benthic C-13 [mmol/m2]
!          'benC_14   ',1, 'm', 8,  ! [2D] benthic C-14 [mmol/m2]
!          'benCalc_13',1, 'm', 8,  ! [2D] benthic calcite C-13 [mmol/m2]
!          'benCalc_14',1, 'm', 8,  ! [2D] benthic calcite C-14 [mmol/m2]
! - never filled (Sinkingvel1/2: the sum in oce_ale_tracer.F90 is commented out), zeros
!          'wsink_det1',1, 'm', 4,  ! [3D, layer interfaces] sinking speed detritus class 1 [m/s]
!          'wsink_det2',1, 'm', 4,  ! [3D, layer interfaces] sinking speed detritus class 2 [m/s]
/

! ============================================================================
! COMPLETE CATALOG OF ALL POSSIBLE OUTPUT FIELDS
! ============================================================================
! Below is a comprehensive list of all valid io_list IDs available in FESOM2.
! To enable any field, copy the line to the &nml_list section above.
! NOTE: Some fields require specific flags to be enabled (see comments).
! ============================================================================

! --- 2D OCEAN SURFACE FIELDS ---
! 'sst       ',1, 'm', 4,  ! sea surface temperature [C]
! 'sss       ',1, 'm', 4,  ! sea surface salinity [psu]
! 'ssh       ',1, 'm', 4,  ! sea surface elevation [m]
! 'vve_5     ',1, 'm', 4,  ! vertical velocity at 5th level [m/s]
! 't_star    ',1, 'm', 4,  ! air temperature [C]
! 'qsr       ',1, 'm', 4,  ! solar radiation [W/s^2]

! --- 3D OCEAN FIELDS ---
! 'temp      ',1, 'm', 4,  ! temperature [C]
! 'salt      ',1, 'm', 8,  ! salinity [psu]
! 'sigma0    ',1, 'm', 4,  ! potential density [kg/m3]
! 'u         ',1, 'm', 4,  ! zonal velocity [m/s]
! 'v         ',1, 'm', 4,  ! meridional velocity [m/s]
! 'unod      ',1, 'm', 4,  ! zonal velocity at nodes [m/s]
! 'vnod      ',1, 'm', 4,  ! meridional velocity at nodes [m/s]
! 'w         ',1, 'm', 4,  ! vertical velocity [m/s]
! 'otracers  ',1, 'm', 4,  ! all other tracers if applicable
! 'age       ',1, 'm', 4,  ! water age tracer [year] (require use_age_tracer=.true.)

! --- 2D SSH DIAGNOSTIC VARIABLES ---
! 'ssh_rhs   ',1, 'm', 4,  ! ssh rhs [m/s]
! 'ssh_rhs_old',1, 'm', 4, ! ssh rhs old [m/s]
! 'd_eta     ',1, 'm', 4,  ! dssh from solver [m]
! 'hbar      ',1, 'm', 4,  ! ssh n+0.5 tstep [m]
! 'hbar_old  ',1, 'm', 4,  ! ssh n-0.5 tstep [m]
! 'dhe       ',1, 'm', 4,  ! dhbar @ elem [m]

! --- SEA ICE FIELDS (require use_ice=.true.) ---
! 'uice      ',1, 'm', 4,  ! ice velocity x [m/s]
! 'vice      ',1, 'm', 4,  ! ice velocity y [m/s]
! 'a_ice     ',1, 'm', 4,  ! ice concentration [%]
! 'm_ice     ',1, 'm', 4,  ! ice height per unit area [m]
! 'thdgrice  ',1, 'm', 4,  ! thermodynamic growth rate ice [m/s]
! 'thdgrarea ',1, 'm', 4,  ! thermodynamic growth rate ice concentration [frac/s]
! 'dyngrarea' ,1, 'm', 4,  ! dynamic growth rate ice concentration [frac/s]
! 'dyngrice  ',1, 'm', 4,  ! dynamic growth rate ice [m/s]
! 'thdgrsnw  ',1, 'm', 4,  ! thermodynamic growth rate snow [m/s]
! 'dyngrsnw  ',1, 'm', 4,  ! dynamic growth rate snow [m/s] 
! 'flice     ',1, 'm', 4,  ! flooding growth rate ice [m/s]
! 'm_snow    ',1, 'm', 4,  ! snow height per unit area [m]
! 'h_ice     ',1, 'm', 4,  ! ice thickness over ice-covered fraction [m]
! 'h_snow    ',1, 'm', 4,  ! snow thickness over ice-covered fraction [m]
! 'fw_ice    ',1, 'm', 4,  ! fresh water flux from ice ['m/s']
! 'fw_snw    ',1, 'm', 4,  ! fresh water flux from snow ['m/s']

! --- SEA ICE DEBUG VARIABLES (require use_ice=.true.) ---
! 'strength_ice',1, 'm', 4,  ! ice strength [?]
! 'inv_areamass',1, 'm', 4,  ! inv_areamass [?]
! 'rhs_a     ',1, 'm', 4,  ! rhs_a [?]
! 'rhs_m     ',1, 'm', 4,  ! rhs_m [?]
! 'sgm11     ',1, 'm', 4,  ! sgm11 [?]
! 'sgm12     ',1, 'm', 4,  ! sgm12 [?]
! 'sgm22     ',1, 'm', 4,  ! sgm22 [?]
! 'eps11     ',1, 'm', 4,  ! eps11 [?]
! 'eps12     ',1, 'm', 4,  ! eps12 [?]
! 'eps22     ',1, 'm', 4,  ! eps22 [?]
! 'u_rhs_ice ',1, 'm', 4,  ! u_rhs_ice [?]
! 'v_rhs_ice ',1, 'm', 4,  ! v_rhs_ice [?]
! 'metric_fac',1, 'm', 4,  ! metric_fac [?]
! 'elevat_ice',1, 'm', 4,  ! elevat_ice [?]
! 'uwice     ',1, 'm', 4,  ! uwice [?]
! 'vwice     ',1, 'm', 4,  ! vwice [?]
! 'twice     ',1, 'm', 4,  ! twice [?]
! 'swice     ',1, 'm', 4,  ! swice [?]

! --- MIXED LAYER DEPTH ---
! 'MLD1      ',1, 'm', 4,  ! Mixed Layer Depth [m] Large et al. 1997, bvfreq(nz, node) > db_max
! 'MLD2      ',1, 'm', 4,  ! Mixed Layer Depth [m] Levitus treshold, rhopot(nz)-rhopot(1) > 0.125_WP kg/m
! 'MLD3      ',1, 'm', 4,  ! Mixed Layer Depth [m] Griffies 2016 , rhopot(nz)-rhopot(1) > 0.03_WP kg/m

! --- HEAT CONTENT (require ldiag_destine=.true.) ---
! 'hc300m    ',1, 'm', 4,  ! Vertically integrated heat content upper 300m [J m**-2]
! 'hc700m    ',1, 'm', 4,  ! Vertically integrated heat content upper 700m [J m**-2]
! 'hc        ',1, 'm', 4,  ! Vertically integrated heat content total column [J m**-2]

