#!/bin/ksh
#
# awiesm2pism -- couple_in of one ice sheet domain.
#
# This is the entry point that esm-runscripts calls for the couple_in subjob of
# an ice sheet component. It works on exactly one ice domain: the domain the
# component belongs to, which env_ice.py exports as ICE_DOMAIN.
#
awiesm2pism() {
    . ${FUNCTION_PATH}/../general/ice_domains.functions
    . ${FUNCTION_PATH}/coupling_atmosphere2pism.functions
    . ${FUNCTION_PATH}/coupling_ocean2pism.functions
    . ${FUNCTION_PATH}/../general/pism_helpers.functions
    . ${FUNCTION_PATH}/../general/general_lists.functions

    # One component, one domain. ICE_DOMAIN comes from env_ice.py; fall back to
    # the flat layout so that a legacy single domain setup keeps working.
    ice_domain_select "${ICE_DOMAIN:-.}"
    echo " *** couple_in for ice domain '${ICE_DOMAIN}' -> ${ICE_COUPLE_DIR}"

    # Stage the *global* exchange files produced by the atmosphere and the
    # ocean into this domain's directory. Every domain then works on its own
    # copy, which is what makes an arbitrary number of domains safe: the
    # per-domain processing (missing value clean up, regridding, renaming)
    # used to modify the shared file in place.
    ice_domain_stage_in ${COUPLE_DIR}/atmosphere_file_for_ice.nc
    ice_domain_stage_in ${COUPLE_DIR}/ocean_file_for_ice.nc
    ice_domain_stage_in ${COUPLE_DIR}/${GRIDDES_OCE:-ocean.griddes}

    if [ -f ${ICE_COUPLE_DIR}/latest_atmo_forcing_file.nc ]; then
        rm ${ICE_COUPLE_DIR}/latest_atmo_forcing_file.nc
    fi

    if [ -f ${ICE_COUPLE_DIR}/latest_ocean_forcing_file.nc ]; then
        rm ${ICE_COUPLE_DIR}/latest_ocean_forcing_file.nc
    fi
    atmosphere2pism
    ocean2pism
}
