#!/usr/bin/ksh

function pism2atmosphere {
        echo "                =================================================================="
        echo "                 *** S T A R T I N G    pism2atmosphere *** "; echo

        :> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
    
        . ${FUNCTION_PATH}/../general/general_lists.functions
        . ${FUNCTION_PATH}/../general/coupling_general.functions


        echo "PISM_TO_ATMOSPHERE=${PISM_TO_ATMOSPHERE}"

        echo " * first_year_in_chunk_input = ${first_year_in_chunk_input}"
        echo " * last_year_in_chunk_restart = ${last_year_in_chunk_restart}"

        # Reference the orography anomaly is taken against. Only two modes
        # exist; anything else used to fall through to the legacy behaviour
        # silently, which hid typos in the runscript.
        #   0  legacy: anomaly against this chunk's PISM input file
        #   1  reference: the absolute ice sheet surface at the first coupling
        #      of each ice domain, the change over the chunk afterwards
        #      (see pism_orography_decide_absolute)
        orog_reference_pism=${orog_reference_pism:-1}
        case "x${orog_reference_pism}" in
            "x0"|"x1") ;;
            *)
                echo ""
                echo " You have to choose either 0 (legacy) or 1 for orog_reference_pism,"
                echo " but it is >>${orog_reference_pism}<<. Exit with error! "
                echo " S T O P  43"
                exit 43
                ;;
        esac
        echo " * orog_reference_pism = ${orog_reference_pism}"

        # Which surface height is handed to the atmosphere (see
        # pism_surface_elevation_expr). Checked here, before anything is
        # written, so that a typo stops the run instead of changing it.
        orog_surface_definition=${orog_surface_definition:-physical}
        case "x${orog_surface_definition}" in
            "xphysical"|"xthk_plus_topg") ;;
            *)
                echo ""
                echo " orog_surface_definition must be 'physical' or 'thk_plus_topg',"
                echo " but it is >>${orog_surface_definition}<<. Exit with error! "
                echo " S T O P  49"
                exit 49
                ;;
        esac
        echo " * orog_surface_definition = ${orog_surface_definition}"

        # Calving goes to the FESOM iceberg model when this domain's runscript
        # has iceberg_coupling; it is then taken out of the mass loss that
        # goes to the rivers and the hosing (generate_mass_loss_flux),
        # so that it reaches the ocean once. ice2fesom checks that FESOM
        # agrees (distribute_total_discharge_over_ocean).
        FESOM_USE_ICEBERGS=${fesom_use_iceberg:-0}
        echo " * iceberg_coupling = ${FESOM_USE_ICEBERGS}"
        # iceberg_discharge.nc is only rewritten with iceberg coupling, but
        # pism2ocean takes it whenever it exists. Without iceberg coupling
        # (e.g. switched off at a restart) an old file must not stay behind
        # to be seeded as icebergs again (cf. latest_discharge.nc in pism2ocean).
        if [[ "x${FESOM_USE_ICEBERGS}" != "x1" && -f ${ICE_COUPLE_DIR}/iceberg_discharge.nc ]]; then
                echo " * removing stale ${ICE_COUPLE_DIR}/iceberg_discharge.nc (no iceberg coupling)"
                rm -f ${ICE_COUPLE_DIR}/iceberg_discharge.nc
        fi

        # Melt under the ice shelves goes to the ocean through FESOM's
        # cavities when this domain's runscript has cavity_coupling; PISM's
        # own sub-shelf melt is then taken out of the mass loss as well
        # (generate_mass_loss_flux), so that it does not reach the ocean twice.
        FESOM_USE_CAVITY=${FESOM_USE_CAVITY:-0}
        echo " * cavity_coupling = ${FESOM_USE_CAVITY}"

        if [[ $PISM_TO_ATMOSPHERE -eq 1 ]]; then
                iterative_coupling_pism_atmosphere_write_grid
                iterative_coupling_pism_atmosphere_write_names
                iterative_coupling_pism_atmosphere_make_forcing
        else
                echo " NOT generating ice forcing for atmosphere"
        fi
        echo
        echo "                 *** F I N I S H E D    pism2atmosphere *** "
        echo "                =================================================================="
}
function iterative_coupling_pism_atmosphere_make_forcing {
        pism_atmosphere_get_newest_output
        pism_atmosphere_update_domain_mask
        pism_atmosphere_generate_orography_anomaly
        pism_atmosphere_generate_ice_thickness_anomaly
        pism_atmosphere_generate_runoff
        pism_atmosphere_assemble_final_file
}

function iterative_coupling_pism_atmosphere_write_names {
        : > ${ICE_COUPLE_DIR}/ice_names_for_atmosphere.dat
        GLACIAL_MASK_VARNAME_pism=mask
        OROG_VARNAME_pism=usurf
        OROG_ANOM_VARNAME_pism=delta_usurf
        TOTAL_MASS_LOSS_VARNAME_pism=total_ice_mass_loss_flux
        echo "ice_glacial_mask_name=$GLACIAL_MASK_VARNAME_pism" >> ${ICE_COUPLE_DIR}/ice_names_for_atmosphere.dat
        echo "ice_orography_name=${OROG_VARNAME_pism}" >> ${ICE_COUPLE_DIR}/ice_names_for_atmosphere.dat
        echo "ice_orography_difference_name=${OROG_ANOM_VARNAME_pism}" >> ${ICE_COUPLE_DIR}/ice_names_for_atmosphere.dat
        echo "ice_mass_loss_varname=${TOTAL_MASS_LOSS_VARNAME_pism}" >> ${ICE_COUPLE_DIR}/ice_names_for_atmosphere.dat
}

function iterative_coupling_pism_atmosphere_write_grid {
        if [ ! -f ${ICE_COUPLE_DIR}/ice.griddes ]; then
                #add_to ${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes \
                #        ice.griddes couple
                cp ${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes \
                        ${ICE_COUPLE_DIR}/ice.griddes
        fi
}

function pism_atmosphere_get_newest_output { 
        echo; echo "                 *   defining the newest PISM file "
        # PG: Modification to ensure that we only use SUMMER values (July for Northern Hemisphere):
        # LA: Not sure why. Now taking yearly mean.
        # LA: Summer value for mask only. Now: Summer value for mask, yearmean for runoff

        # Define list of variables selected from PISM output depending on whether icebergs are used or not
        CDO_SELECT_VAR_LIST="thk,climatic_mass_balance,topg,${OROG_VARNAME_pism},${GLACIAL_MASK_VARNAME_pism},tendency_of_ice_amount,tendency_of_ice_amount_due_to_discharge"
        # sub-shelf melt, subtracted in generate_mass_loss_flux with cavity_coupling
        if [[ "x${FESOM_USE_CAVITY:-0}" == "x1" ]]; then
            CDO_SELECT_VAR_LIST="${CDO_SELECT_VAR_LIST},basal_mass_flux_floating"
        fi
        
        LATEST_PISM_FILE_SINGLE=${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_extra_${YR0_pism}${M0_pism}${D0_pism}-${END_YEAR_pism}${END_MONTH_pism}${END_DAY_pism}.nc
        echo; echo "                 *   OUTPUT_DIR_pism = ${OUTPUT_DIR_pism} "
        if [ -f ${LATEST_PISM_FILE_SINGLE} ]; then
            echo; echo "                 *   file1 = ${LATEST_PISM_FILE_SINGLE} found ***"

            # Remove old files
            if [ -f ${OUTPUT_DIR_pism}/tmp.nc ];                        then rm ${OUTPUT_DIR_pism}/tmp.nc; fi
            if [ -f ${OUTPUT_DIR_pism}/latest_ex_file_pism.nc ];        then rm ${OUTPUT_DIR_pism}/latest_ex_file_pism.nc; fi
            if [ -f ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc ];  then rm ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc; fi
            unset PISM_OFILE_LIST
            unset PISM_cleanup_list

            # Aggregate PISM output to multi-year monthly mean
            echo " *** These fields are selected ${CDO_SELECT_VAR_LIST} *** "
            for i in $(seq ${CHUNK_START_YEAR_pism} ${NYEAR} ${CHUNK_END_YEAR_pism}); do
                j=$(( $i + ${NYEAR} -1 ))
                if [ ${i} -lt 10 ]; then i=0${i}; fi
                IFILE="${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_extra_${i}0101-${j}1231.nc"
                if [[ "x${USE_YMONMEAN}" == "x1" ]]; then 
                    OFILE="${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_extra_${i}0101-${j}1231.tendency.timmean.nc"
                    #PISM_cleanup_list="${PISM_cleanup_list} ${IFILE}"
                    
                    if [[ ! -f "${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_extra_${i}0101-${j}1231.tendency.timmean.nc" ]]; then 
                            OFILE="${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_extra_${i}0101-${j}1231.tendency.timmean.nc"
                            cdo -ymonmean \
                                -select,name="${CDO_SELECT_VAR_LIST}" \
                                ${IFILE} \
                                ${OFILE} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm
                    fi
                    echo; echo " * i = ${i} "; PISM_OFILE_LIST="${PISM_OFILE_LIST} ${OFILE}"; 
                else
                    if [[ -f ${IFILE} ]]; then 
                        PISM_OFILE_LIST="${PISM_OFILE_LIST} ${IFILE}"
                    fi
                fi
            done

            echo; echo "                *   Concatenating these files: ${PISM_OFILE_LIST} "
            cdo cat ${PISM_OFILE_LIST} ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm
            cdo timmean ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc ${OUTPUT_DIR_pism}/latest_ex_file_pism.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm

            #rm ${PISM_OFILE_LIST} ${PISM_cleanup_list}
        else
            echo "*** ${LATEST_PISM_FILE_SINGLE} not found ***"
            exit 42
        fi

        newest_pism_file=${OUTPUT_DIR_pism}/latest_ex_file_pism.nc
        newest_pism_filename=$(basename $newest_pism_file)
        newest_pism_file_chunk=${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc
        
        if [[ ${EX_INT} == "monthly" ]]; then
            case $DOMAIN_pism in
                    "nhem" | "laurentide" | "greenland" | "gris_nhem")
                            month_to_select=6
                            ;;
                    "shem" | "antarctica" | "Antarctica" | "antarct_cr")
                            month_to_select=12
                            ;;
                    *)
                            echo "UNKNOWN PISM domain"
                            exit 42
            esac
            echo "                 -   selecting summer values only! Month=$month_to_select "
            echo "                 -   ifile = ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc; ofile = ${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_summer_${YR0_pism}-${END_YEAR_pism}.nc "
            
       
            if [[ "x${SEA_LEVEL_FORCING}" != "x0" ]]; then
                cdo -s -chname,sea_level_rise_potential,delta_SL -mulc,-1 -subc,${SEA_LEVEL_FORCING} -timmean -selname,sea_level_rise_potential ${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_ts_${YR0_pism}${M0_pism}${D0_pism}-${END_YEAR_pism}${END_MONTH_pism}${END_DAY_pism}.nc ${ICE_COUPLE_DIR}/latest_global_mean_sea_level_forcing.nc
            fi

            # Select mask either by minimum ice thickness over year (MIN_MON_SELECT==1) or by summer value (Jun for NH, Dec for SH)
            if [[ "x${MIN_MON_SELECT}" == "x1" ]]; then
                cdo -s \
                        -timmin \
                        -selname,thk \
                        ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc \
                        ${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_summer_${YR0_pism}-${END_YEAR_pism}.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm 
            else
                cdo -s \
                        -selmon,${month_to_select} \
                        -ymonmean \
                        ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc \
                        ${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_summer_${YR0_pism}-${END_YEAR_pism}.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm 
            fi
            # LA: get SMB as another criterion for glacial mask; glacial cell if positive SMB
            cdo -s \
                    -timmean \
                    -selname,climatic_mass_balance \
                    ${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc \
                    ${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_smb_${YR0_pism}-${END_YEAR_pism}.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2awiesm
            newest_pism_mask_file=${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_summer_${YR0_pism}-${END_YEAR_pism}.nc
        else
            newest_pism_mask_file=${newest_pism_file}
        fi    
        newest_pism_mask_filename=$(basename $newest_pism_mask_file)

}

function pism_atmosphere_update_domain_mask {
        echo; echo "                 Updating script-coupler domain mask..."
              echo "                 (This is the area where changes to ECHAM6 files are allowed to be made)"

        update_domain_mask_select_mask
        if [[ "x${MIN_MON_SELECT}" != "x1" ]]; then
            update_domain_mask_constrain_minimum_ice_thickness
        fi
        update_domain_mask_merge_masks
        update_domain_mask_set_mask_values_to_binary
        echo; echo "                  ...done."
}

## @fn pism_orography_decide_absolute()
## Sets ORO_ABSOLUTE=1 if this coupling hands the atmosphere the absolute ice
## sheet surface (ice_orog.nc) rather than the change over the chunk: with
## orog_reference_pism=1, at the first coupling of this ice domain. ECHAM's
## orography is then set to the ice sheet model's once, and only changes are
## added afterwards.
##
## "First coupling" = no ice_file_for_atmosphere.nc from an earlier coupling in
## ${ICE_COUPLE_DIR}, or a repeat of the coupling that delivered the absolute
## surface (recorded in ice_orog_absolute.chunk). This used to be
## "CHUNK_NUMBER_pism == 2", which is the first coupling only for the first ice
## model: in a dual run pism_sh couples first in chunk 3 and so never handed
## over its absolute surface.
pism_orography_decide_absolute() {
        typeset _pa_mark=${ICE_COUPLE_DIR}/ice_orog_absolute.chunk
        ORO_ABSOLUTE=0
        if [ "x${orog_reference_pism}" == "x1" ]; then
                if [[ -f ${_pa_mark} ]]; then
                        [[ "$(cat ${_pa_mark})" == "${CHUNK_START_DATE_pism}" ]] && ORO_ABSOLUTE=1
                elif [[ ! -f ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc ]]; then
                        ORO_ABSOLUTE=1
                fi
        fi
        if [ "x${ORO_ABSOLUTE}" == "x1" ]; then
                echo "                 -   first coupling of this ice domain: handing over the absolute surface"
        else
                echo "                 -   handing over the surface change over this chunk"
        fi
}

function pism_atmosphere_generate_orography_anomaly {
        echo; echo "                 Generating orography anomaly..."
        pism_orography_decide_absolute
        generate_orography_anomaly_over_pism_run
        # Correct the lon/lat order whenever an anomaly file was actually
        # written. That is every case except the first coupling with
        # orog_reference_pism=1, which writes the absolute ice_orog.nc
        # instead -- the same condition pism_atmosphere_assemble_final_file
        # uses to pick its input files.
        if [ "x${ORO_ABSOLUTE}" != "x1" ]; then
            correct_lonlat_order ${ICE_COUPLE_DIR}/ice_orog_difference.nc
        fi
        echo; echo "                  ...done."
}

function pism_atmosphere_generate_ice_thickness_anomaly {
        echo; echo "                 Generating ice_thickness anomaly..."
        generate_ice_thickness_anomaly_over_pism_run
        correct_lonlat_order ${ICE_COUPLE_DIR}/ice_thk_difference.nc
        echo; echo "                  ...done."
}

function pism_atmosphere_generate_runoff {
        echo; echo "                 Generating the ice mass loss flux..."
        generate_mass_loss_flux
        echo; echo "                  ...done."
}

function pism_atmosphere_assemble_final_file {
        echo; echo "                  Assembling final ice_file_for_atmosphere.nc and cleaning up..."
        # the orography goes as ice_orog.nc instead at an absolute coupling
        files_needed="${ICE_COUPLE_DIR}/ice_mask_current.nc ${ICE_COUPLE_DIR}/ice_runoff_flux_total.nc"
        if [ "x${ORO_ABSOLUTE}" != "x1" ]; then
            files_needed="${files_needed} ${ICE_COUPLE_DIR}/ice_orog_difference.nc"
        fi
        cdo -s -O merge $files_needed ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc
	    ncwa -a time ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc tmp; mv tmp ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc
        # which run wrote it: ice_domain_check_fresh refuses to use it twice
        ncatted -O -h -a coupling_chunk_number,global,o,l,${CHUNK_NUMBER_pism} \
                -a coupling_chunk,global,o,c,"${CHUNK_START_DATE_pism} - ${CHUNK_END_DATE_pism}" \
                ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc

        # The absolute surface at the end of the chunk, with the same
        # definition as the orography change, and the ice thickness. Only for
        # the check of ECHAM's orography against the ice sheet
        # (update_orography_check_against_ice); ECHAM itself gets the change.
        pism_atmosphere_write_surface

        # Where this domain may hold ice: its footprint for ECHAM's glaciers,
        # sub-grid orography and albedo (set_glacial_mask_to_echam_grid). Cells
        # the prescribed front retreat keeps ice-free stay outside, so their
        # prescribed glaciers survive.
        echo "                  -   active area of the domain -> ice_domain_active.nc"
        if ! ( module load python3 >/dev/null 2>&1
               python3 ${FUNCTION_PATH}/../utils/ice_active_area.py \
                       ${ICE_COUPLE_DIR}/ice_file_for_atmosphere.nc ${ICE_COUPLE_DIR}/ice_domain_active.nc \
                       ${PISM_FRONT_RETREAT_FILE:+--front-retreat ${PISM_FRONT_RETREAT_FILE}} ); then
                echo " !!! could not write ${ICE_COUPLE_DIR}/ice_domain_active.nc"
                echo " S T O P  42"
                exit 42
        fi

        # Where this domain has floating ice at the end of the chunk, for the
        # check against FESOM's cavities (ice2fesom_check_cavity_geometry).
        # PISM's own mask (3 = floating) of the chunk's last output step, so
        # that PISM's sea level (forcing) is respected. Without it: thicker
        # than 1 m and afloat at sea level 0,
        # topg + thk * rho_ice / rho_sea_water < 0, with a note.
        typeset _fl_ri _fl_rw _fl_chunk _fl_n
        _fl_chunk=${OUTPUT_DIR_pism}/latest_ex_file_pism.CHUNK.nc
        echo "                  -   floating ice of the domain -> ice_floating.nc"
        if [ -f ${_fl_chunk} ] && ncdump -h ${_fl_chunk} 2>/dev/null | grep -q "[[:space:]]mask("; then
                _fl_n=$(cdo -s ntime ${_fl_chunk} 2>/dev/null)
                cdo -s -O -setname,floating -mul -gtc,2.5 -selname,mask -seltimestep,${_fl_n:-1} ${_fl_chunk} \
                        -ltc,3.5 -selname,mask -seltimestep,${_fl_n:-1} ${_fl_chunk} \
                        ${ICE_COUPLE_DIR}/ice_floating.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        else
                _fl_ri=$(ncdump -h ${last_year_in_chunk_restart} 2>/dev/null \
                        | sed -n 's/^[[:space:]]*pism_config:\(constants\.ice\.density\|ice_density\) = \([0-9.eE+-]*\).*/\2/p' | head -1)
                _fl_rw=$(ncdump -h ${last_year_in_chunk_restart} 2>/dev/null \
                        | sed -n 's/^[[:space:]]*pism_config:\(constants\.sea_water\.density\|sea_water_density\) = \([0-9.eE+-]*\).*/\2/p' | head -1)
                echo "                  !   no PISM mask in ${_fl_chunk}: floating ice from thk/topg at sea level 0"
                cdo -s -O -expr,"floating=(thk>1)*((topg+thk*${_fl_ri:-910}/${_fl_rw:-1028})<0)" \
                        -selname,thk,topg ${last_year_in_chunk_restart} ${ICE_COUPLE_DIR}/ice_floating.nc \
                        2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        fi
        if [ ! -s ${ICE_COUPLE_DIR}/ice_floating.nc ]; then
                echo "                  !   could not write ice_floating.nc; FESOM's cavity check will skip this domain"
        fi
        #rm $files_needed $rmlist
        echo; echo "                  ...done"
        unset files_needed
}
               
function update_domain_mask_select_mask { 
        echo ""; echo "                 *   selecting the mask variable"
        ifile1=${newest_pism_mask_file}
        ifile2=${ICE_COUPLE_DIR}/${EXP_ID}_pism_extra_smb_${YR0_pism}-${END_YEAR_pism}.nc
        if [[ "x${MIN_MON_SELECT}" == "x1" ]]; then
            CRITICAL_THK_FOR_MASK_pism=${CRITICAL_THK_FOR_MASK_pism:-5}
            echo ""; echo "                 *   constraining the mask to have at least ${CRITICAL_THK_FOR_MASK_pism} (meters)"
            ofile1=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_min_thk.nc
            ofile2=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_pos_smb.nc
            cdo -s chname,thk,${GLACIAL_MASK_VARNAME_pism} -setmisstoc,0 -ifthenc,1 -gec,${CRITICAL_THK_FOR_MASK_pism} $ifile1 $ofile1 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
            cdo -s chname,climatic_mass_balance,${GLACIAL_MASK_VARNAME_pism} -setmisstoc,0 -ifthenc,1 -gtc,0 $ifile2 $ofile2 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        else
            ofile1=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}.nc 
            ofile2=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_pos_smb.nc
            cdo -s -selvar,${GLACIAL_MASK_VARNAME_pism} $ifile1 $ofile1 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
            cdo -s chname,climatic_mass_balance,${GLACIAL_MASK_VARNAME_pism} -setmisstoc,0 -ifthenc,1 -gtc,0 $ifile2 $ofile2 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        fi
        unset ifile1 ifile2 ofile1 ofile2
}

function update_domain_mask_constrain_minimum_ice_thickness {
        CRITICAL_THK_FOR_MASK_pism=${CRITICAL_THK_FOR_MASK_pism:-5}
        echo ""; echo "                 *   constraining the mask to have at least ${CRITICAL_THK_FOR_MASK_pism} (meters)"
        ifile=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}.nc
        ofile=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_min_thk.nc
        cdo -s -setmisstoc,0 \
                -ifthen \
                -gec,${CRITICAL_THK_FOR_MASK_pism} \
                -selvar,thk \
                ${newest_pism_mask_file} \
                ${ifile} \
                ${ofile} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm 
        rm $ifile
        unset ifile ofile
} 

function update_domain_mask_merge_masks {
        echo ""; echo "                 *   merging masks from thicknes and surface mass balance criterions"
        ifile1=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_min_thk.nc
        ifile2=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_pos_smb.nc
        ofile=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_merged_mask.nc
        #LA: merge both masks: glacial cell if thickness above threshold OR surface mass balance > 0
        # GLACIAL_MASK_POS_SMB=1 (default, old behaviour): thk-mask OR SMB>0
        # GLACIAL_MASK_POS_SMB=0: thk-mask only (ice-free land with SMB>0 is NOT made glacier in ECHAM)
        if [[ "x${GLACIAL_MASK_POS_SMB:-1}" == "x0" ]]; then
            echo "                 -   GLACIAL_MASK_POS_SMB=0: using ice-thickness mask only"
            cp $ifile1 $ofile
        else
            cdo -s max $ifile1 $ifile2 $ofile 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        fi
        #rm $ifile1 $ifile2
        unset ifile1 ifile2 ofile
}

function update_domain_mask_set_mask_values_to_binary { 
        echo ""; echo "                 *   setting binary values for mask: 1=ice, 0=non-ice"
        ifile=${ICE_COUPLE_DIR}/${newest_pism_filename%.*}_${GLACIAL_MASK_VARNAME_pism}_merged_mask.nc
        ofile=${ICE_COUPLE_DIR}/ice_mask_min_thk_binary.nc
        cdo -s \
               -setvals,2,1 \
               -setvals,3,1 \
               -setvals,4,0 \
        $ifile $ofile 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        mv $ofile ${ICE_COUPLE_DIR}/ice_mask_current.nc
        #rm $ifile
        unset ifile ofile
}

function generate_ice_thickness_anomaly_over_pism_run { 
        echo ""; echo "                 *   calculating ice thickness change over the last pism chunk"
        cdo -s -chname,thk,thk_diff \
                -sub -selvar,thk ${last_year_in_chunk_restart} \
                     -selvar,thk ${first_year_in_chunk_input} \
                ${ICE_COUPLE_DIR}/ice_thk_difference.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
}

## @fn pism_atmosphere_write_surface()
## Writes ${ICE_COUPLE_DIR}/ice_surface.nc: surface (m, pism_surface_elevation_expr)
## and thk (m) of the chunk's last restart, without time. Stamped with the
## chunk like ice_file_for_atmosphere.nc, so that ice2echam does not check
## against an old file. A failure only costs the check, not the run.
pism_atmosphere_write_surface() {
        typeset _ws_expr _ws_f=${ICE_COUPLE_DIR}/ice_surface.nc
        echo "                  -   ice sheet surface and thickness -> ice_surface.nc"
        rm -f ${_ws_f}
        _ws_expr=$(pism_surface_elevation_expr)
        _ws_expr="surface=${_ws_expr#*=};thk=thk;"
        if cdo -s -O -expr,"${_ws_expr}" -selname,thk,topg ${last_year_in_chunk_restart} \
                        ${_ws_f}.tmp 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm \
           && ncwa -O -a time ${_ws_f}.tmp ${_ws_f} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm; then
                ncatted -O -h -a units,surface,o,c,"m" -a units,thk,o,c,"m" \
                        -a surface_definition,surface,o,c,"${orog_surface_definition:-physical}" \
                        -a coupling_chunk_number,global,o,l,${CHUNK_NUMBER_pism} \
                        ${_ws_f}
        else
                echo "                  !   could not write ice_surface.nc; ECHAM's orography check will skip this domain"
                rm -f ${_ws_f}
        fi
        rm -f ${_ws_f}.tmp
}

## @fn pism_surface_elevation_expr()
## Prints the cdo -expr that turns a PISM file (thk, topg) into the surface
## height the atmosphere sees, named ${OROG_VARNAME_pism}.
##
##   physical (default) -- height of the actual surface above sea level:
##       grounded ice and bare land:  topg + thk
##       floating ice:                freeboard  thk * (1 - rho_ice/rho_seawater)
##       open ocean:                  0
##     which is max(topg + thk, freeboard) for sea level 0 (PISM's default).
##   thk_plus_topg (legacy) -- topg + thk everywhere. Over open ocean that is
##     the bed depth (down to several km below sea level) and over floating ice
##     it is far too low, so every retreat onto a marine bed pushed ECHAM's
##     orography below sea level.
##
## Both files of an anomaly are evaluated with the same definition, so
## switching between two chunks does not create a jump in the anomaly.
## Densities: PISM defaults, overridable through RHO_ICE_pism/RHO_SEAWATER_pism.
pism_surface_elevation_expr() {
        if [ "x${orog_surface_definition:-physical}" == "xthk_plus_topg" ]; then
                echo "${OROG_VARNAME_pism}=thk+topg"
        else
                typeset _fb
                _fb=$(awk -v ri=${RHO_ICE_pism:-910} -v rw=${RHO_SEAWATER_pism:-1028} \
                        'BEGIN { printf "%.8f", 1 - ri/rw }')
                echo "${OROG_VARNAME_pism}=((topg+thk) > (thk*${_fb})) ? (topg+thk) : (thk*${_fb})"
        fi
}

function generate_orography_anomaly_over_pism_run {
        echo ""; echo "                 *   calculating surface height change over the last pism chunk"
        ifile1=${last_year_in_chunk_restart}
        _orog_expr=$(pism_surface_elevation_expr)
        echo "                 -   surface height (${orog_surface_definition:-physical}): ${_orog_expr}"

        # LA: as before use difference between PISM input and PISM restart for orography change 
        if [[ "x${orog_reference_pism}" == "x0" ]]; then 
            ifile2=${first_year_in_chunk_input}
            ofile=${ICE_COUPLE_DIR}/ice_orog_difference.nc
            cdo -s -sub \
                    -chname,${OROG_VARNAME_pism},${OROG_ANOM_VARNAME_pism} \
                    -expr,"${_orog_expr}" \
                    $ifile1 \
                    -expr,"${_orog_expr}" \
                    $ifile2 \
                    $ofile 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        elif [ "x${ORO_ABSOLUTE}" == "x1" ]; then
            # orog_reference_pism=1, first coupling of this domain: hand over
            # the absolute surface once instead of an anomaly.
            #ifile2="${ICE_COUPLE_DIR}/elev_lo.nc"
            ofile=${ICE_COUPLE_DIR}/ice_orog.nc
            cdo -s  \
                    -expr,"${_orog_expr}" \
                    $ifile1 \
                    $ofile 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
            ncwa -a time $ofile tmp
            mv tmp $ofile
            echo "${CHUNK_START_DATE_pism}" > ${ICE_COUPLE_DIR}/ice_orog_absolute.chunk
        else
            # orog_reference_pism=1, any later coupling: the absolute surface
            # was handed over once, so keep it out of the way and deliver the
            # anomaly.
            if [ -f ${ICE_COUPLE_DIR}/ice_orog.nc ]
            then
                mv ${ICE_COUPLE_DIR}/ice_orog.nc ${ICE_COUPLE_DIR}/ice_orog.nc_BAK
            fi
            
            ifile2=${first_year_in_chunk_input}
            ofile=${ICE_COUPLE_DIR}/ice_orog_difference.nc
            cdo -s -sub \
                    -chname,${OROG_VARNAME_pism},${OROG_ANOM_VARNAME_pism} \
                    -expr,"${_orog_expr}" \
                    $ifile1 \
                    -expr,"${_orog_expr}" \
                    $ifile2 \
                    $ofile 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
           echo " * continue with only ice thk diff approach"
           #echo " * EXIT "
           #exit 42 
        fi

        ncks -O -x -v GEOSP $ofile tmp.nc 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        mv tmp.nc $ofile
        unset _orog_expr
}

## @fn generate_iceberg_discharge()
## Writes ${ICE_COUPLE_DIR}/iceberg_discharge.nc: PISM's
## tendency_of_ice_amount_due_to_discharge [kg m-2 yr-1], mean over the chunk
## (latest_ex_file_pism.nc). This is the calving that FESOM gets as icebergs
## (pism2ocean, ice2fesom) and that generate_mass_loss_flux subtracts.
## With a prescribed front retreat (PISM_FRONT_RETREAT_FILE) it is 0 wherever
## that file allows no ice: PISM books the ice it removes there as
## discharge, which over land (e.g. Tibet) is cleared snow, not calving.
function generate_iceberg_discharge {
        typeset _src=${OUTPUT_DIR_pism}/latest_ex_file_pism.nc
        typeset _out=${ICE_COUPLE_DIR}/iceberg_discharge.nc
        if ! ncdump -h ${_src} 2>/dev/null | grep -q "tendency_of_ice_amount_due_to_discharge("; then
                echo " !!! no tendency_of_ice_amount_due_to_discharge in ${_src};"
                echo " !!! calving would reach the ocean twice. Add it to PISM's extra output."
                echo " S T O P  42"
                exit 42
        fi
        rm -f ${_out}  # a failed cdo below must not leave last year's file in place
        if ! cdo -s -O -timmean -selname,tendency_of_ice_amount_due_to_discharge ${_src} ${_out} \
                2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm; then
                echo " !!! cdo failed to write ${_out}"
                echo " S T O P  42"
                exit 42
        fi
        if [ -n "${PISM_FRONT_RETREAT_FILE}" ]; then
                echo "                 -   no discharge where ${PISM_FRONT_RETREAT_FILE} allows no ice"
                if ! ( module load python3 >/dev/null 2>&1
                       python3 ${FUNCTION_PATH}/../utils/mask_discharge_front_retreat.py \
                               ${_out} ${PISM_FRONT_RETREAT_FILE} ); then
                        echo " !!! could not apply the front-retreat mask to ${_out}"
                        echo " S T O P  42"
                        exit 42
                fi
        fi
}

## @fn generate_mass_loss_flux()
## Writes ${ICE_COUPLE_DIR}/ice_runoff_flux_total.nc with
## total_ice_mass_loss_flux [kg m-2 s-1]: the ice mass change over this chunk
## as a flux (mass gain positive; ice2echam flips the sign for the ocean),
##
##     910 kg m-3 * (thk at the end - thk at the start) / chunk length,
##
## which goes to the rivers (gfw_atmo) and to the FESOM hosing. With iceberg
## coupling the calving (iceberg_discharge.nc, see generate_iceberg_discharge;
## the same field the iceberg model is seeded with) goes to FESOM as icebergs
## and is subtracted here,
## so that it reaches the ocean once. The standard_name then says
## "excluding_calving", which ice2fesom checks against FESOM's setting.
## With cavity_coupling (FESOM_USE_CAVITY=1) FESOM melts the ice shelves in
## its cavities, so PISM's sub-shelf melt (basal_mass_flux_floating, chunk
## mean, negative for melt) is subtracted as well: the flux then contains
## surface mass balance and grounded basal melt only.
## PISM 1.x only.
function generate_mass_loss_flux {
        typeset _out=${ICE_COUPLE_DIR}/ice_runoff_flux_total.nc
        typeset _sec_per_year=3.15569e+07
        case ${VERSION_pism:-} in
            1.0|1.1|1.2) ;;
            *)
                echo " !!! generate_mass_loss_flux: PISM version >${VERSION_pism}< is not supported (1.0, 1.1, 1.2)"
                echo " S T O P  42"
                exit 42
                ;;
        esac

        # ice density PISM ran with (PISM 1.x: constants.ice.density)
        typeset _rho
        _rho=$(ncdump -h ${last_year_in_chunk_restart} 2>/dev/null \
                | sed -n 's/^[[:space:]]*pism_config:\(constants\.ice\.density\|ice_density\) = \([0-9.eE+-]*\).*/\2/p' | head -1)
        _rho=${_rho:-910.}

        echo ""; echo "                 *   ice mass change of this chunk as a flux (ice density ${_rho} kg m-3)"
        cdo -s -setattribute,total_ice_mass_loss_flux@units="kg m-2 s-1" \
                -chname,thk_diff,total_ice_mass_loss_flux \
                -divc,${_sec_per_year} -divc,${CHUNK_SIZE_pism_standalone} -mulc,${_rho} \
                -setmisstoc,0 ${ICE_COUPLE_DIR}/ice_thk_difference.nc \
                ${_out} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
        # not a thickness any more (the standard_name came along from thk)
        ncatted -O -h -a standard_name,total_ice_mass_loss_flux,d,, \
                -a long_name,total_ice_mass_loss_flux,o,c,"ice mass change as a flux (mass gain positive)" \
                ${_out}
        mass_loss_correct_to_pism_budget ${_out} ${_sec_per_year}

        if [[ "x${FESOM_USE_ICEBERGS}" == "x1" ]]; then
                echo "                 -   minus the calving, which goes to the FESOM iceberg model"
                generate_iceberg_discharge
                cdo -s -sub ${_out} \
                        -divc,${_sec_per_year} -setmisstoc,0 \
                        ${ICE_COUPLE_DIR}/iceberg_discharge.nc \
                        ${_out}.tmp 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
                mv ${_out}.tmp ${_out}
                ncatted -O -h \
                        -a standard_name,total_ice_mass_loss_flux,o,c,"land_ice_specific_mass_flux_excluding_calving_and_ice_front_melting" \
                        -a long_name,total_ice_mass_loss_flux,o,c,"ice mass change except the calving, which FESOM gets as icebergs" \
                        ${_out}
        fi

        if [[ "x${FESOM_USE_CAVITY:-0}" == "x1" ]]; then
                typeset _src=${OUTPUT_DIR_pism}/latest_ex_file_pism.nc
                echo "                 -   minus the sub-shelf melt, which FESOM computes in its cavities"
                if ! ncdump -h ${_src} 2>/dev/null | grep -q "basal_mass_flux_floating("; then
                        echo " !!! no basal_mass_flux_floating in ${_src};"
                        echo " !!! sub-shelf melt would reach the ocean twice. Add it to PISM's extra output."
                        echo " S T O P  42"
                        exit 42
                fi
                # mass gain positive, so subtracting the (negative) melt removes it
                cdo -s -sub ${_out} \
                        -divc,${_sec_per_year} -setmisstoc,0 \
                        -timmean -selname,basal_mass_flux_floating ${_src} \
                        ${_out}.tmp 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm
                mv ${_out}.tmp ${_out}
                if [[ "x${FESOM_USE_ICEBERGS}" == "x1" ]]; then
                        ncatted -O -h -a long_name,total_ice_mass_loss_flux,o,c,"ice mass change except the calving (FESOM icebergs) and the sub-shelf melt (FESOM cavities)" ${_out}
                else
                        ncatted -O -h -a long_name,total_ice_mass_loss_flux,o,c,"ice mass change except the sub-shelf melt, which FESOM computes in its cavities" ${_out}
                fi
        fi
        # read by ice2fesom (distribute_total_discharge_over_ocean), which
        # checks it against FESOM's use_cavity
        ncatted -O -h -a excludes_sub_shelf_melt,total_ice_mass_loss_flux,o,s,${FESOM_USE_CAVITY:-0} ${_out}
}

## @fn mass_loss_correct_to_pism_budget()
## Call: mass_loss_correct_to_pism_budget FILE SEC_PER_YEAR
## The thickness difference over the chunk (restart at the end minus the
## chunk's input file) also holds whatever happens to the input when PISM
## starts from it (regridding, bootstrapping, a restart from another file): in
## dual_hemisphere_t02 the Antarctic one was -518 Gt/yr against -662 Gt/yr in
## PISM's own budget. So the total of FILE is set to PISM's budget for the
## chunk, the mean over the scalar time series (${EXP_ID}_${EXE_pism}_ts_*.nc)
## of
##     tendency_of_ice_mass_due_to_surface_mass_flux
##   + tendency_of_ice_mass_due_to_basal_mass_flux
##   + tendency_of_ice_mass_due_to_discharge
##   (+ tendency_of_ice_mass_due_to_conservation_error, if written),
## which for the NH domain there matched the change of ice_mass (+250 vs
## +251 Gt/yr). The pattern stays that of the thickness difference; the
## difference is spread in proportion to |F| (conserve_remapped_flux.py).
## The log shows both totals every chunk. A correction of more than
## MASS_LOSS_BUDGET_WARN_PERCENT (default 3) % of the gross flux sum(|F| A)
## is warned about (flextest_20261123: 5 % after a fresh start, 1-2 % later).
##
## MASS_LOSS_TOTAL (ice domain key mass_loss_total):
##   pism_budget (default)  as above; without the ts file or its variables a
##                          warning, and the thickness difference is kept
##   thk_difference         keep the total of the thickness difference (legacy)
function mass_loss_correct_to_pism_budget {
        typeset _f=$1 _spy=$2 _ts _terms="" _v _budget _kgs
        case ${MASS_LOSS_TOTAL:-pism_budget} in
                thk_difference)
                        echo "                 -   mass_loss_total=thk_difference: total of the thickness difference kept"
                        return 0 ;;
                pism_budget) ;;
                *)
                        echo " !!! mass_loss_total = >${MASS_LOSS_TOTAL}<: only pism_budget or thk_difference"
                        echo " S T O P  42"
                        exit 42 ;;
        esac
        # one ts file per PISM run; a chunk may consist of several runs (the
        # same loop as pism_atmosphere_get_newest_output for the extra files)
        typeset _i _j _tsf _tslist="" _tsmiss=""
        for _i in $(seq ${CHUNK_START_YEAR_pism} ${NYEAR} ${CHUNK_END_YEAR_pism}); do
                _j=$(( _i + NYEAR - 1 ))
                [ ${_i} -lt 10 ] && _i=0${_i}
                _tsf=${OUTPUT_DIR_pism}/${EXP_ID}_${EXE_pism}_ts_${_i}0101-${_j}1231.nc
                if [ -f ${_tsf} ]; then _tslist="${_tslist} ${_tsf}"; else _tsmiss="${_tsmiss} ${_tsf}"; fi
        done
        if [ -z "${_tslist}" ] || [ -n "${_tsmiss}" ]; then
                echo "                 !   PISM time series missing for this chunk:${_tsmiss:- (none found)}"
                echo "                 !   total of the thickness difference kept (may hold a start-of-chunk jump)"
                return 0
        fi
        _ts=${ICE_COUPLE_DIR}/pism_ts_chunk.nc
        if ! cdo -s -O cat ${_tslist} ${_ts} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm; then
                echo "                 !   could not join the PISM time series of this chunk; total of the thickness difference kept"
                return 0
        fi
        for _v in surface_mass_flux basal_mass_flux discharge conservation_error; do
                if ncdump -h ${_ts} | grep -q "tendency_of_ice_mass_due_to_${_v}("; then
                        _terms="${_terms}${_terms:++}tendency_of_ice_mass_due_to_${_v}"
                elif [ ${_v} != conservation_error ]; then
                        echo "                 !   tendency_of_ice_mass_due_to_${_v} not in ${_ts}:"
                        echo "                 !   total of the thickness difference kept"
                        return 0
                fi
        done
        if ! ncdump -h ${_ts} | grep -q 'tendency_of_ice_mass_due_to_discharge:units = "Gt year-1"'; then
                echo "                 !   ${_ts}: budget not in Gt year-1; total of the thickness difference kept"
                return 0
        fi
        _budget=$(cdo -s outputf,%.10e -timmean -expr,"budget=${_terms}" ${_ts} 2>> ${ICE_COUPLE_DIR}/cdo_stderr_pism2atm | tr -d ' ')
        if [ -z "${_budget}" ]; then
                echo "                 !   could not read PISM's budget from ${_ts}; total of the thickness difference kept"
                return 0
        fi
        _kgs=$(awk -v b=${_budget} -v s=${_spy} 'BEGIN{printf "%.10e", b * 1e12 / s}')
        echo "                 -   total set to PISM's budget for the chunk: ${_budget} Gt/yr (${_terms}; $(echo ${_tslist} | wc -w) run(s))"
        if ! ( module load python3 >/dev/null 2>&1
               python3 ${FUNCTION_PATH}/../utils/ice_cell_area.py ${_f} ${_f%.nc}.cell_area.nc \
               && python3 ${FUNCTION_PATH}/../utils/conserve_remapped_flux.py - - \
                       ${_f} ${_f%.nc}.cell_area.nc --target-integral=${_kgs} \
                       --warn-percent=${MASS_LOSS_BUDGET_WARN_PERCENT:-3} ); then
                echo " !!! could not set the total of ${_f} to PISM's budget"
                echo " S T O P  42"
                exit 42
        fi
        rm -f ${_f%.nc}.cell_area.nc
}

function correct_lonlat_order { 
        FILENAME=$1
        echo ""; echo "                 *   correcting $FILENAME lonlat order"
        ncpdq -a lat,lon $FILENAME tmp; mv tmp $FILENAME
}
