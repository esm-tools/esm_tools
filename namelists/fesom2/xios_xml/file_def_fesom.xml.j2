    <file id="f_OmegaC"      name="OmegaC.fesom"   ><field field_ref="OmegaC" freq_op="1mo"/></file>

    {% if fesom.recom_enable_3zoo2det %}
    <file id="f_respmacro"   name="respmacro.fesom"><field field_ref="respmacro" freq_op="1mo"/></file>
    <file id="f_respmicro"   name="respmicro.fesom"><field field_ref="respmicro" freq_op="1mo"/></file>
    <file id="f_Zoo2N"       name="Zoo2N.fesom"    ><field field_ref="Zoo2N" freq_op="1mo"/></file>
    <file id="f_Zoo2C"       name="Zoo2C.fesom"    ><field field_ref="Zoo2C" freq_op="1mo"/></file>
    <file id="f_idetz2n"     name="idetz2n.fesom"  ><field field_ref="idetz2n" freq_op="1mo"/></file>
    <file id="f_idetz2c"     name="idetz2c.fesom"  ><field field_ref="idetz2c" freq_op="1mo"/></file>
    <file id="f_idetz2si"    name="idetz2si.fesom" ><field field_ref="idetz2si" freq_op="1mo"/></file>
    <file id="f_idetz2calc"  name="idetz2calc.fesom"><field field_ref="idetz2calc" freq_op="1mo"/></file>
    <file id="f_Zoo3N"       name="Zoo3N.fesom"    ><field field_ref="Zoo3N" freq_op="1mo"/></file>
    <file id="f_Zoo3C"       name="Zoo3C.fesom"    ><field field_ref="Zoo3C" freq_op="1mo"/></file>
