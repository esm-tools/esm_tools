#!/usr/bin/ksh

# --- couple_timer: per-step profiling timer (see coupling_fesom2ice.functions) ---
if ! command -v couple_timer >/dev/null 2>&1 ; then
    couple_timer() {
        _ct_now=$(date +%s.%N 2>/dev/null) || _ct_now=$(date +%s)
        _ct_stamp=$(date +'%Y-%m-%dT%H:%M:%S' 2>/dev/null)
        if [ -n "${COUPLE_TIMER_LAST:-}" ] ; then
            awk -v a="${COUPLE_TIMER_LAST}" -v b="${_ct_now}" -v l="${COUPLE_TIMER_LABEL:-start}" \
                -v t="${_ct_stamp}" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9.2f s\n", t, l, (b-a) }'
        else
            # First mark: there is no previous section to time, but stamp it anyway.
            # Without this, any time spent BEFORE instrumentation starts (esm_tools
            # internals, file staging) is invisible -- the absolute stamps let you
            # line the [TIMER] lines up against the job's own start/end.
            awk -v t="${_ct_stamp}" -v l="$1" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9s\n", t, "(instrumentation starts: " l ")", "--" }'
        fi
        COUPLE_TIMER_LAST="${_ct_now}"
        COUPLE_TIMER_LABEL="$1"
    }
    # couple_timer_end: stamp the LAST section, which otherwise never prints (its
    # duration is only emitted by the *next* mark, and at the end of a function
    # there isn't one). Call it right before a coupling function returns.
    couple_timer_end() {
        if [ -n "${COUPLE_TIMER_LAST:-}" ] ; then
            _ct_now=$(date +%s.%N 2>/dev/null) || _ct_now=$(date +%s)
            awk -v a="${COUPLE_TIMER_LAST}" -v b="${_ct_now}" -v l="${COUPLE_TIMER_LABEL:-start}" \
                -v t="$(date +'%Y-%m-%dT%H:%M:%S' 2>/dev/null)" \
                'BEGIN{ printf "     [TIMER] %s %-50s %9.2f s\n", t, l, (b-a) }'
            unset COUPLE_TIMER_LAST COUPLE_TIMER_LABEL
        fi
    }
fi

function ocean2pism {
    couple_timer "ocean2pism: setup+names+prepare-forcing"
    echo " *** S T A R T I N G    ocean2pism *** (PISM version ${VERSION_pism})"

    echo $(module list)
    . ${FUNCTION_PATH}/../general/coupling_general.functions
    . ${FUNCTION_PATH}/../general/general_lists.functions

    #CHUNK_DATE_TAG_pism="${CHUNK_START_DATE_pism}-${CHUNK_END_DATE_pism}"
    CHUNK_DATE_TAG_pism="${CURRENT_YEAR_pism}-${END_YEAR_pism}"

    INTERPOL_TYPE_OCE=${INTERPOL_TYPE_OCE:-"dis"} #Standard=dis : "bil" "con" "dis" "nn", "bil" doesn't work for FESOM
    WEIGHTS_OCE2ICE=${WEIGHTS_OCE2ICE:-weights_oce2ice.${INTERPOL_TYPE_OCE}.nc}
    if [[ -f ${COUPLE_DIR}/ice.griddes ]]
    then
        GRIDDES_ICE=${COUPLE_DIR}/ice.griddes
    else
        GRIDDES_ICE=${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes
    fi
    GRIDDES_OCE=${GRIDDES_OCE:-ocean.griddes}
    PISM_OCEAN_FORCING_FILE=${COUPLE_DIR}/"ocean_forcing4pism_ver${VERSION_pism}.${INTERPOL_TYPE_OCE}.${CHUNK_DATE_TAG_pism}.nc"

    OCEAN_3EQN_ICE_FORCE_PY_SCRIPT=${FUNCTION_PATH:-${FPATH}}/ocean_3eqn_ismforce.py

    PISM_OCEAN_SWITCH=""
    PISM_OCEAN_FILE_SWITCH=""

    iter_coup_regrid_method_oce2ice=${iter_coup_regrid_method_oce2ice:-EXTRAPOLATE}
    iter_coup_interact_method_oce2ice=${iter_coup_interact_method_oce2ice:-OCEANTEMPSALT}

    read_names ocean ice
    save_griddes ice

    NOCOLOR='\033[0m'
    GREEN='\033[32m'

    echo "Interaction (ocean) : ${iter_coup_interact_method_oce2ice} (1/2)"
    echo -e "   --> Interaction >>> ${GREEN}${iter_coup_interact_method_oce2ice}${NOCOLOR} <<< ocean (Step 1/2: names)"
    case $iter_coup_interact_method_oce2ice in
        "DIRECT")
	    #
	    # Take DIRECTly the forcing coming from the ocean model
	    #
	    PISM_OCEAN_SWITCH="-ocean given"
	    PISM_OCEAN_FILE_SWITCH="-ocean_given_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_direct_forcing
            ;;
        "MIXED"|"TS_RESCALED2FLUX")
	    #
	    #  Take directly the forcing coming from the ocean model
	    #  and rescale it with `ocean_3eqn_iceforce.py` computed
	    #  fluxes -- NOT YET IMPLEMENTED
	    #
	    PISM_OCEAN_SWITCH="-ocean given"
	    PISM_OCEAN_FILE_SWITCH="-ocean_given_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_mixed_forcing
            ;;
	"OCEANTEMP")
	    #
	    # Provide the ice sheet model (here PISM) the temperature
	    # 3dim field (constant in time) and the PISM computes the
	    # basal ice shelf conditions
	    #
	    PISM_OCEAN_SWITCH="-ocean o3d"
	    PISM_OCEAN_FILE_SWITCH="-ocean_o3d_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_temp_forcing
	    ;;
	"OCEANTEMPSALT")
	    #
	    # Provide the ice sheet model (here PISM) the temperature
	    # and salinity 3dim fields (constant in time) and the PISM
	    # computes the basal ice shelf conditions
	    #
	    PISM_OCEAN_SWITCH="-ocean th"
	    PISM_OCEAN_FILE_SWITCH="-ocean_th_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_tempsalt_forcing
	    ;;
	"PICO_OCEAN")
	    #
	    # Provide the ice sheet model temperature and salinity
	    # fields and PISM computes via the "PICO" submodel the
	    # ice shelf conditions
	    #
	    #PISM_OCEAN_SWITCH="-ocean pico -ocean.pico.continental_shelf_depth 700"
            
            PISM_OCEAN_SWITCH="-ocean pico"
	    PISM_OCEAN_FILE_SWITCH="-ocean_pico_file ${PISM_OCEAN_FORCING_FILE}"
            PISM_OCEAN_PICO_BASINS_FILE=${PISM_OCEAN_PICO_BASINS_FILE:-${PISM_OCEAN_FORCING_FILE}}
            echo " * Doing iterative_coupling_ocean_pism_prepare_ocean_tempsalt_forcing ..."
            iterative_coupling_ocean_pism_prepare_ocean_tempsalt_forcing 	
            echo "      ...done."
            
            #echo " * Doing iterative_coupling_ocean_pism_prepare_pico_ocean_forcing ..."
            #iterative_coupling_ocean_pism_prepare_pico_ocean_forcing ${PISM_OCEAN_PICO_BASINS_FILE} ${PISM_OCEAN_FORCING_FILE}
            #echo "      ...done."
            ;;
	"TEMP2FLUX")
	    #
	    # Use the python script `ocean_3eqn_iceforce.py` and
	    # compute the basal temporal evolving conditions based
	    # only on the 3dim oceanic temperature distribution
	    #
	    PISM_OCEAN_SWITCH="-ocean given"
	    PISM_OCEAN_FILE_SWITCH="-ocean_given_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_temp2flux_forcing
	    ;;
	"TEMPSALT2FLUX")
	    #
	    # Use the python script `ocean_3eqn_iceforce.py` and
	    # compute the basal temporal evolving conditions based on
	    # 3dim oceanic temperature and salinity distributions
	    #
	    PISM_OCEAN_SWITCH="-ocean given"
	    PISM_OCEAN_FILE_SWITCH="-ocean_given_file ${PISM_OCEAN_FORCING_FILE}"
            iterative_coupling_ocean_pism_prepare_ocean_tempsalt2flux_forcing
	    ;;
        *)
            echo " UNKNOWN mass balance selected!"
	    echo "   Known: DIRECT, MIXED, OCEANTEMP, PICO_OCEAN, TEMP2FLUX, TEMPSALT2FLUX"
	    echo " S T O P   1"
            exit 1
    esac

    echo "Grid method (ocean) : ${iter_coup_regrid_method_oce2ice}"
    echo -e "   --> Grid method >>> ${GREEN}${iter_coup_regrid_method_oce2ice}${NOCOLOR} <<< ocean"
    case $iter_coup_regrid_method_oce2ice in
        "INTERPOLATE"|"REMAP")
            iterative_coupling_ocean_pism_regrid_interpolate
            ;;
        "EXTRAPOLATE")
            iterative_coupling_ocean_pism_regrid_interpolate
            iterative_coupling_ocean_pism_regrid_extrapolate
            ;;
        "NONE")
	    # Ocean and ice sheet grid are identical !!
	    INTERPOL_TYPE_OCE=none
    SM_OCEAN_FORCING_FILE3        iterative_coupling_ocean_pism_regrid_none
            ;;
        *)
            echo " UNKNOWN regrid method selected!"
	    echo "   Known: INTERPOLATE = REMAP, EXTRAPOLATE, NONE"
	    echo " S T O P   2"
            exit 2
    esac

    echo "Interaction (ocean) : ${iter_coup_interact_method_oce2ice} (2/2)"
    echo -e "   --> Interaction >>> ${GREEN}${iter_coup_interact_method_oce2ice}${NOCOLOR} <<< ocean (Step 2/2: final file)"
    case $iter_coup_interact_method_oce2ice in
        "DIRECT")
            iterative_coupling_ocean_pism_compute_ocean_direct_forcing ${PISM_OCEAN_FORCING_FILE}
            ;;
        "MIXED"|"TS_RESCALED2FLUX")
            iterative_coupling_ocean_pism_compute_ocean_mixed_forcing ${PISM_OCEAN_FORCING_FILE}
            ;;
	"OCEANTEMP")
            iterative_coupling_ocean_pism_compute_ocean_temp_forcing ${PISM_OCEAN_FORCING_FILE}
	    ;;
	"OCEANTEMPSALT")
            iterative_coupling_ocean_pism_compute_ocean_tempsalt_forcing ${PISM_OCEAN_FORCING_FILE}
            ;; 
        "PICO_OCEAN")
            iterative_coupling_ocean_pism_compute_ocean_tempsalt_forcing ${PISM_OCEAN_FORCING_FILE}
            PISM_OCEAN_PICO_BASINS_FILE=${PISM_OCEAN_PICO_BASINS_FILE:-${PISM_OCEAN_FORCING_FILE}}
            echo " * Doing iterative_coupling_ocean_pism_prepare_pico_ocean_forcing ..."
            iterative_coupling_ocean_pism_prepare_pico_ocean_forcing ${PISM_OCEAN_PICO_BASINS_FILE} ${PISM_OCEAN_FORCING_FILE}
            echo "      ...done."
	    ;;
	"TEMP2FLUX")
            iterative_coupling_ocean_pism_compute_ocean_temp2flux_forcing ${PISM_OCEAN_FORCING_FILE}
	    ;;
	"TEMPSALT2FLUX")
            iterative_coupling_ocean_pism_compute_ocean_tempsalt2flux_forcing ${PISM_OCEAN_FORCING_FILE}
	    ;;
        *)
            echo " UNKNOWN mass balance selected!"
	    echo "   Known: DIRECT, MIXED, OCEANTEMP, TEMP2FLUX, TEMPSALT2FLUX"
	    echo " S T O P   3"
            exit 3
    esac

    couple_timer "ocean2pism: compute-forcing+time-axis+xy"
    #iterative_coupling_ocean_pism_set_options
    iterative_coupling_ocean_pism_regrid_set_time_axis ${PISM_OCEAN_FORCING_FILE}
    iterative_coupling_pism_regrid_add_xy_array ${PISM_OCEAN_FORCING_FILE} "ocean"
    couple_timer "ocean2pism: DONE (before sleep 10)"

    ln -sf "${COUPLE_DIR}/ocean_forcing4pism_ver${VERSION_pism}.${INTERPOL_TYPE_OCE}.${CHUNK_DATE_TAG_pism}.nc" "${COUPLE_DIR}/latest_ocean_forcing_file.nc"
    
    for file in ${cleanup_list} ; do test -f $file && rm $file ; done
    
    unset cleanup_list file

    unset NOCOLOR GREEN
    unset PISM_OCEAN_SWITCH PISM_OCEAN_FILE_SWITCH PISM_OCEAN_FORCING_FILE

    max_retry=12
    retry=0
    sleep 10 # Minimum time for st_new.sh to finish
        
    while [ ${retry} -lt ${max_retry} ]; do
        if [ -f ${COUPLE_DIR}/latest_ocean_forcing_file.nc ]; then
            break # call results.sh outside loop
        else
            (( retry = retry + 1 ))
            sleep 1
        fi
    done
    if [ ! -f ${COUPLE_DIR}/latest_ocean_forcing_file.nc ]; then
        echo "Something wrong after waiting for 120 seconds!"
    fi
    echo "     ...done."

    # stamp the final section (its duration is otherwise never emitted:
    # only the NEXT mark prints it, and there isn't one at the end)
    couple_timer_end
}

function save_griddes {
    model_type=$1
    if [ ! -f ${COUPLE_DIR}/${model_type}.griddes ]; then
        echo "Saving ${model_type}.griddes"
	if [ -f ${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes ]; then
            cp ${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes \
                ${COUPLE_DIR}/${model_type}.griddes
        else
            echo " Was Looking for: ${POOL_DIR_pism}/grids/${DOMAIN_pism}/${EXE_pism}_${DOMAIN_pism}_${RES_pism}.griddes"
            echo "Could not find griddes file, exiting..."
	    echo " S T O P  4  (coupling_ocean2pism.functions::save_griddes)"
	    exit 4
        fi
    else
	echo "${model_type}.griddes is in place"
    fi
}


#
# Compute actual forcing files : Convert variable names to pism names
#
function iterative_coupling_ocean_pism_prepare_ocean_direct_forcing {
    echo "Preparing direct ocean forcing (${PISM_OCEAN_SWITCH:-Unknown}) file with sensible units..."
    # PISM0.7 : shelfbtemp [degC], shelfbmassflux [kg m-2 s-1] 
##    $cdo -select,name=wnet,Tsurf

    # Rename all input variables
    cdo_table_file=cdo_partable.txt
    iterative_coupling_ocean_pism_fesom2pism_names $cdo_table_file

    # Extend the list: Delete not needed one
    cat >> $cdo_table_file <<EOF
&parameter
name = theta_ocean
delete = 1
/
&parameter
name = shelfbheatflux
delete = 1
/
&parameter
name = shelfbsalt
delete = 1
/
&parameter
name = salinity_ocean
delete = 1
/
&parameter
name = z_base
delete = 1
/
EOF

#
#    $cdo setpartabn,${cdo_table_file},convert \
#	ocean_file_at_ice.${INTERPOL_TYPE_OCE}.nc \
#	${PISM_OCEAN_FORCING_FILE}

    $cdo setpartabn,${cdo_table_file},convert \
	${COUPLE_DIR}/ocean_file_for_ice.nc \
	ocean_file_for_ice.pism_names.nc

    iterative_coupling_ocean_pism_cavity_mask ocean_file_for_ice.pism_names.nc

    echo "     ...done."
}

#
# Restrict the melt flux to the cavity that FESOM actually resolves.
#
# fw, which becomes shelfbmassflux, is the freshwater flux at EVERY ocean node:
# basal melt under a shelf, precipitation minus evaporation in the open ocean,
# and along the coast mostly sea-ice formation, which removes freshwater from
# the surface and so carries the opposite sign.  Remapped whole, that coastal
# ring lands on the shelf cells beside the calving front and cancels part of the
# melt.  Measured on one chunk of ism41_v5g over mask 3 -- the only cells PISM
# applies the flux to -- FESOM melts the cavity at 774 Gt/yr, 673 of that
# arrives, open-ocean nodes take 95 back out, and PISM is left with 577.
#
# The nodes are set to MISSING, not to zero.  Zeroed nodes still take part in
# the distance-weighted average and merely dilute the melt: on the same chunk
# zeroing gives 673 Gt/yr where marking them missing gives 741, because cdo then
# drops them and renormalises the weights over the cavity nodes alone.
#
# coupling_fesom2ice.functions already extracts cavity_flag_extended and carries
# a branch meant to do exactly this, but its test reads x[q,w]net while the loop
# variables are Tsurf Ssurf fh fw, and the masked file it writes is never passed
# to the extraction script, which reads the raw FESOM directory by variable and
# year.  The same intent is applied here, where the submesh is at hand.
#
# Set iterative_coupling_ocean_pism_cavity_mask=0 to get the previous behaviour.
#
function iterative_coupling_ocean_pism_cavity_mask {
    _file=$1
    _do_mask=${iterative_coupling_ocean_pism_cavity_mask:-1}
    CAVITY_TOTAL_FILE=${CAVITY_TOTAL_FILE:-$(pwd)/cavity_melt_total.txt}
    rm -f ${CAVITY_TOTAL_FILE}

    if [ ${_do_mask} -eq 0 ] ; then
	echo " *   Cavity mask DISABLED : shelfbmassflux keeps the open-ocean flux"
	unset _do_mask
	return 0
    fi

    # FAILING HERE IS FATAL, deliberately.  The mask changes the melt PISM is
    # given, so a run configured with it on must not quietly proceed with it off:
    # that produces a forcing file indistinguishable afterwards from the
    # unpatched one, and the whole experiment silently tests something else.
    #
    # This is not hypothetical.  The first version of this function warned and
    # carried on, and under the coupling's own module environment -- module purge
    # plus cdo, nco, netcdf -- `python` is not on PATH at all ("command not
    # found"), so it would have warned and carried on for every chunk of every
    # run.  Hence both the explicit interpreter check and the exit.
    #
    # PYTHON_BINARY should name an interpreter that can import numpy and netCDF4.
    # esm_runscripts itself runs under one (its shebang names it), so that is the
    # natural value to set in the runscript.
    _py=${PYTHON_BINARY:-$(command -v python3 2>/dev/null || command -v python 2>/dev/null)}
    if [ -z "${_py}" ] || ! ${_py} -c "import numpy, netCDF4" >/dev/null 2>&1 ; then
	echo " *   ERROR: the cavity mask is enabled but there is no usable python."
	echo "            tried >>${_py:-none found on PATH}<<"
	echo "            it must be able to: import numpy, netCDF4"
	echo "            set PYTHON_BINARY in the runscript, or set"
	echo "            iterative_coupling_ocean_pism_cavity_mask=0 to disable the"
	echo "            mask on purpose."
	exit 42
    fi

    # The cavity is recarved every chunk and the node count moves with it, so
    # the submesh is chosen by MATCHING that count against the field being
    # masked, not by name: latest_submesh is the mesh carved for the next leg
    # and previous_submesh the one before it, so neither is reliably the mesh
    # this field was written on.  A field with no matching submesh stops the
    # helper rather than being masked with the wrong nodes.
    if ! ls -d ${COUPLE_DIR}/submesh_* >/dev/null 2>&1 ; then
	echo " *   ERROR: the cavity mask is enabled but no submesh_* exists under"
	echo "            ${COUPLE_DIR}"
	if [ "${CHUNK_NUMBER:-1}" -le 1 ] && [ -n "${PISM_BOOTSTRAP_DIR}" ] ; then
	    echo "            This is chunk 1, whose forcing comes from the harvest"
	    echo "            ${PISM_BOOTSTRAP_DIR}"
	    echo "            and that harvest carries no submesh_* of its own, so there"
	    echo "            is no mesh to mask against: the fesom chain has not carved"
	    echo "            one yet.  Point pism.bootstrap_forcing_dir at a harvest that"
	    echo "            includes the submesh the forcing was written on."
	fi
	exit 43
    fi

    echo " *   Masking shelfbmassflux to the cavity ..."
    ${_py} ${FUNCTION_PATH:-${FPATH}}/../utils/cavity_consistency.py \
	mask \
	--node-file    ${_file} \
	--submesh-root ${COUPLE_DIR} \
	--total-file   ${CAVITY_TOTAL_FILE} \
	|| { echo " *   ERROR: the cavity mask failed" ; \
	     rm -f ${CAVITY_TOTAL_FILE} ; exit 44 ; }

    unset _do_mask _py
}

function iterative_coupling_ocean_pism_prepare_ocean_mixed_forcing {
    echo " *   Preparing mixed ocean forcing (${PISM_OCEAN_SWITCH:-Unknown}) file with sensible units..."
    # PISM0.7 : shelfbtemp [degC], shelfbmassflux [kg m-2 s-1]

    # Rename all input variables
    cdo_table_file=cdo_partable.txt
    iterative_coupling_ocean_pism_fesom2pism_names $cdo_table_file

#    # Extend the list: Delete not needed one
#    cat >> $cdo_table_file <<EOF
#&parameter
#name = theta_ocean
#delete = 1
#/
#
#&parameter
#name = shelfbheatflux
#delete = 1
#/
#
#&parameter
#name = shelfbsalt
#delete = 1
#/
#
#&parameter
#name = salinity_ocean
#delete = 1
#/
#
