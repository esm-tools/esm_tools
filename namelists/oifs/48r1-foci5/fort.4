! See discussion: https://git.smhi.se/ec-earth/ecearth4/-/issues/112
! ============================================================================
&NAMECECFG
! ----------------------------------------------------------------------------
! * EC-Earth configuration
! ----------------------------------------------------------------------------
    ECE_CPL_NEMO_LIM = .true.,    ! Run coupled to NEMO (true) or not (false)
    ECE_CPL_NEMO_PISCES = .false., ! Run coupled to NEMO-PISCES (true) or not (false)
    ECE_CPL_NEMO_WEIGHTED_ICE = .true., ! Set true if NEMO sends temperature and
                                      ! albedo that are weighted by the ice
                                      ! fraction (check settings in namsbc_cpl
                                      ! in nemo-oce namelist)
    ECE_CPL_NEMO_CONSERVATIVE_HEATFLUX = .false., ! Set "false"(default) to couple
                                      ! heat fluxes separately over ocean and
                                      ! sea ice. Set "true" to use conservative
                                      ! coupling (=sum of ocean and sea ice
                                      ! fluxes). NOTE: setting "true" requires
                                      ! additional changes in namcouple and
                                      ! the nemo namelist.
! LPJG coupling
    ECE_CPL_LPJG = .false.,
    ECE_CPL_LPJG_CO2 = .false.,
! Ice sheet coupling. ECE_CPL_ISMM keys on ismm presence;
! ECE_LANDICE keys on oifs.landice; NISMRGNS/ISMRGNPFX are
! emitted whenever either is active. Activation matrix in
! running docs section 'Land ice and ice-sheet coupling'.
    ECE_CPL_ISMM = false,
    NISMRGNS = 1,
    ISMRGNPFX = 'grtes',
    ECE_LANDICE = false,         ! Enable land-ice surface physics (standalone or coupled)
    ECE_LANDICE_THRESH = 0.5,  ! Ice sheet mask threshold [0-1]; cells above treated as glacier (default 0.5)
! ============================================================================
/

! ============================================================================
&NAMMCC
! ----------------------------------------------------------------------------
! * Module YOMMCC: Keys for IFS "climate version"
! ----------------------------------------------------------------------------

    LMCCEC = true,               ! LMCCEC = .T.   ===> Boundary conditions updated by ECMWF routines
                                 !        = .F.   ===> they are not updated
    NFRCPL = 0,                  ! NFRCPL         ===> Coupling frequency
    LMCCDYNSEAICE = true,        ! Use of dynamic sea-ice model
    LMCC_COMPO = false,
!   LNEMOCOUP                    ! LNEMOCOUP = .T. ===> SINGLE EXECUTABLE COUPLING TO NEMO
!                                !           = .F. ===> NO SINGLE EXECUTABLE COUPLING TO NEMO
!   LNEMOSSTFREEZ                ! LNEMOSSTFREEZ = .T. ===> SET SST TO FREEZING IF CI<=RCIMIN
!                                !               = .F. ===> KEEP NEMO SST IF CI<=RCIMIN
!   LNEMOFLUXNC                  ! LNEMOFLUXNC = .T. ===> OUTPUT FLUXES FOR NEMO COUPLING IN NETCDF
!                                !             = .F. ===> DO NOT OUTPUT FLUXES FOR NEMO COUPLING IN NETCDF
!   LNEMO1WAY                    ! LNEMO1WAY = .T. ===> 1WAY (IFS TO NEMO) COUPLING
!                                !           = .F. ===> 2WAY IFS TO NEMO AND NEMO TO IFS COUPLING
!   LNEMOIFSLOG                  ! LNEMOIFSLOG = .T. ===> NEMO LOG OUTPUT IN IFS NODE.???_?? FILES
!                                !             = .F. ===> NORMAL NEMO LOG OUTPUT
!   LNEMOLIMGET                  ! LNEMOLIMGET  = .T. ! Get new fields LIM
!   LNEMOLIMPUT                  ! LNEMOLIMPUT  = .T. ! Put new fields LIM
!   LNEMOLIMALB                  ! LNEMOLIMALB  = .T. ! Use albedo from LIM
!   LNEMOLIMTEMP                 ! LNEMOLIMTEMP = .F. ! Use ice temp from LIM
!   LNEMOLIMTLVL                 ! LNEMOLIMTLVL = .F. ! Receive temp levels from LIM
!   LNEMOLIMTHK                  ! LNEMOLIMTHK  = .T. ! Use ice and snow thickness
! ============================================================================
/

&NAMORB
! ----------------------------------------------------------------------------
! * Module YOMORB: Time-varying orbital forcing
! ----------------------------------------------------------------------------
! Feature ported from ECE3.
! Original documentation:
! https://dev.ec-earth.org/projects/ecearth3/wiki/Orbital_forcing_in_EC-Earth_3
! Porting: https://dev.ec-earth.org/issues/1130
!
! Namelist settings
!   LCORBMD:  apply orbital calculations (default: false)
!   ORBMODE:
!     fixed_year: calculate the orbital parameters at year ORBIY
!     variable_year: calculate orbital parameters annually start from year ORBIY
!     fixed_parameters: prescribe orbital parameters for given year
!     (default: "fixed_year")
!   ORBIY:    set year for fixed or variable year settings (default: 1850)
! ----------------------------------------------------------------------------
    LCORBMD = true,
    ORBMODE = "variable_year",
    ORBIY = 1950,
! ============================================================================
/

